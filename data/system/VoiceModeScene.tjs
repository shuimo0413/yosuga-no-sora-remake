// HD voice appreciation / favorite-voice gallery.
// Content layout: schematic.png ; bottom nav shared via AppreciationBottomNav.

class VoiceModeScene extends Sprite, SelectItemNotifyBase, SceneBase, ChainItemBase
{
	var _base;
	var _cover;
	var _previewFrame;
	var _previewImage;
	var _previewBorder;
	var _dateLayer;
	var _textLayer;
	var _nav;

	var _btnSlot = [];
	var _slotFace = [];
	var _slotText = [];
	var _btnJump;
	var _barTrack;
	var _barThumb;

	var _list = [];
	var _selIndex = -1;
	var _hoverIndex = -1;
	var _page = 0;
	var _boxSrc;
	var _draggingScroll = false;
	var _scrollDragOffsetY = 0;
	var _tempMuteVoice;
	var _tempMuteMaster;
	var _voiceOwned;
	var _tempVoiceVol;

	var UI_ROOT = APPRECIATION_UI_ROOT;

	// box.png = 801x157, 3 states side-by-side
	var CELL_W = 267;
	var CELL_H = 157;
	var GAP_X = 30;
	var GAP_Y = 20;
	var COLS = 4;
	var ROWS = 3;
	var MAX_SLOT = 12;
	var FACE_SLOT_W = 200;
	var FACE_SLOT_H = 150;
	var FACE_SLOT_OPACITY = 160;

	var GRID_ORIGIN_X = 690;
	var GRID_ORIGIN_Y = 383;

	var PREVIEW_X = 40;
	var PREVIEW_Y = 385;
	var PREVIEW_W = 534;
	var PREVIEW_H = 303;
	var PREVIEW_IMAGE_INSET_X = 5;
	var PREVIEW_IMAGE_INSET_Y = 5;
	var PREVIEW_IMAGE_W = 519;
	var PREVIEW_IMAGE_H = 286;
	var PREVIEW_IMAGE_RADIUS = 18;
	var PREVIEW_BORDER_X = 2;
	var PREVIEW_BORDER_Y = 2;
	var PREVIEW_BORDER_W = 525;
	var PREVIEW_BORDER_H = 292;
	var PREVIEW_BORDER_RADIUS = 21;
	var PREVIEW_BORDER_THICKNESS = 3;

	var BAR_TRACK_W = 16;
	var BAR_THUMB_W = 30;
	var BAR_THUMB_H = 29;
	var BAR_GAP = 14;

	var BOX_IDLE = 0;
	var BOX_HOVER = 1;
	var BOX_SELECTED = 2;

	function clipPreviewCorners(dst)
	{
		for(var row = 0; row < PREVIEW_IMAGE_RADIUS; row++)
		{
			var dy = PREVIEW_IMAGE_RADIUS - row - 0.5;
			var inset = int(
				PREVIEW_IMAGE_RADIUS -
				Math.sqrt(PREVIEW_IMAGE_RADIUS * PREVIEW_IMAGE_RADIUS - dy * dy) +
				0.999
			);
			if(inset <= 0) continue;

			var bottom = PREVIEW_IMAGE_H - 1 - row;
			var right = PREVIEW_IMAGE_W - inset;
			dst.fillRect(0, row, inset, 1, 0x00000000);
			dst.fillRect(right, row, inset, 1, 0x00000000);
			dst.fillRect(0, bottom, inset, 1, 0x00000000);
			dst.fillRect(right, bottom, inset, 1, 0x00000000);
		}
	}

	function roundedRowInset(row, height, radius)
	{
		var edgeRow = row;
		if(row >= height - radius) edgeRow = height - 1 - row;
		if(edgeRow >= radius) return 0;
		var dy = radius - edgeRow - 0.5;
		return int(radius - Math.sqrt(radius * radius - dy * dy) + 0.999);
	}

	function drawPreviewBorder(dst)
	{
		dst.fillRect(0, 0, PREVIEW_W, PREVIEW_H, 0x00000000);

		for(var row = 0; row < PREVIEW_BORDER_H; row++)
		{
			var inset = roundedRowInset(
				row, PREVIEW_BORDER_H, PREVIEW_BORDER_RADIUS
			);
			dst.fillRect(
				PREVIEW_BORDER_X + inset,
				PREVIEW_BORDER_Y + row,
				PREVIEW_BORDER_W - inset * 2,
				1,
				0xFFFFFFFF
			);
		}

		var innerW = PREVIEW_BORDER_W - PREVIEW_BORDER_THICKNESS * 2;
		var innerH = PREVIEW_BORDER_H - PREVIEW_BORDER_THICKNESS * 2;
		var innerRadius = PREVIEW_BORDER_RADIUS - PREVIEW_BORDER_THICKNESS;
		for(var innerRow = 0; innerRow < innerH; innerRow++)
		{
			var innerInset = roundedRowInset(innerRow, innerH, innerRadius);
			dst.fillRect(
				PREVIEW_BORDER_X + PREVIEW_BORDER_THICKNESS + innerInset,
				PREVIEW_BORDER_Y + PREVIEW_BORDER_THICKNESS + innerRow,
				innerW - innerInset * 2,
				1,
				0x00000000
			);
		}
	}

	function VoiceModeScene(win, par)
	{
		Sprite(...);
		hasImage = false;
		setSize(WINDOW_WIDTH, WINDOW_HEIGHT);
		setPos(0, 0);
		hitThreshold = 0;
		absolute = LAYER_APPRECIATION;
		opacity = 255;
		visible = true;

		_base = new global.SelectItemGroupSprite(win, this);
		with(_base)
		{
			.hasImage = true;
			.setImageSize(WINDOW_WIDTH, WINDOW_HEIGHT);
			.setSize(WINDOW_WIDTH, WINDOW_HEIGHT);
			.fillRect(0, 0, WINDOW_WIDTH, WINDOW_HEIGHT, 0xFF6080A0);
			.setPos(0, 0);
			.visible = true;
			.opacity = 255;
		}

		if(Storages.isExistentStorage(UI_ROOT + "bg.png"))
		{
			_base.loadImages(UI_ROOT + "bg.png");
			_base.setSizeToImageSize();
			_base.setPos(0, 0);
		}

		_cover = new global.Layer(win, _base);
		with(_cover)
		{
			if(Storages.isExistentStorage(UI_ROOT + "cover.png"))
			{
				.loadImages(UI_ROOT + "cover.png");
				.setSizeToImageSize();
			}
			.setPos(0, 0);
			.hitThreshold = 256;
			.visible = true;
		}

		_previewFrame = new global.Layer(win, _base);
		with(_previewFrame)
		{
			if(Storages.isExistentStorage(UI_ROOT + "preview.png"))
			{
				.loadImages(UI_ROOT + "preview.png");
				.setSizeToImageSize();
			}
			else
			{
				.setImageSize(PREVIEW_W, PREVIEW_H);
				.setSize(PREVIEW_W, PREVIEW_H);
				.fillRect(0, 0, PREVIEW_W, PREVIEW_H, 0xAA7090B0);
			}
			.setPos(PREVIEW_X, PREVIEW_Y);
			.hitThreshold = 256;
			.visible = true;
		}

		_previewImage = new global.Layer(win, _base);
		with(_previewImage)
		{
			.setImageSize(PREVIEW_W, PREVIEW_H);
			.setSize(PREVIEW_W, PREVIEW_H);
			.fillRect(0, 0, PREVIEW_W, PREVIEW_H, 0x00000000);
			.setPos(PREVIEW_X, PREVIEW_Y);
			.hitThreshold = 256;
			.visible = false;
		}

		_previewBorder = new global.Layer(win, _base);
		with(_previewBorder)
		{
			.setImageSize(PREVIEW_W, PREVIEW_H);
			.setSize(PREVIEW_W, PREVIEW_H);
			.setPos(PREVIEW_X, PREVIEW_Y);
			.hitThreshold = 256;
			.visible = true;
		}
		drawPreviewBorder(_previewBorder);

		_dateLayer = new global.Layer(win, _base);
		with(_dateLayer)
		{
			.setSize(360, 36);
			.setPos(40, 706);
			.font.height = 22;
			.hitThreshold = 256;
			.visible = true;
		}

		_textLayer = new global.Layer(win, _base);
		with(_textLayer)
		{
			.setSize(520, 120);
			.setPos(40, 760);
			.font.height = 24;
			.hitThreshold = 256;
			.visible = true;
		}

		_boxSrc = new global.Layer(win, _base);
		with(_boxSrc)
		{
			if(Storages.isExistentStorage(UI_ROOT + "box.png"))
			{
				.loadImages(UI_ROOT + "box.png");
				.setSizeToImageSize();
			}
			.visible = false;
			.hitThreshold = 256;
		}

		var i;
		for(i = 0; i < MAX_SLOT; i++)
		{
			var col = i % COLS;
			var row = i \ COLS;
			var x = GRID_ORIGIN_X + col * (CELL_W + GAP_X);
			var y = GRID_ORIGIN_Y + row * (CELL_H + GAP_Y);

			_btnSlot[i] = new Button(win, _base);
			with(_btnSlot[i])
			{
				.setImageSize(CELL_W, CELL_H);
				.setSize(CELL_W, CELL_H);
				.fillRect(0, 0, CELL_W, CELL_H, 0x00000000);
				.setPos(x, y);
				.hitThreshold = 0;
				.visible = true;
			}
			blitBox(_btnSlot[i], BOX_IDLE);
			addChainItem(_btnSlot[i]);

			_slotFace[i] = new global.Layer(win, _base);
			with(_slotFace[i])
			{
				.setImageSize(FACE_SLOT_W, FACE_SLOT_H);
				.setSize(FACE_SLOT_W, FACE_SLOT_H);
				.fillRect(0, 0, FACE_SLOT_W, FACE_SLOT_H, 0x00000000);
				.setPos(x - 8, y + CELL_H - FACE_SLOT_H);
				.opacity = FACE_SLOT_OPACITY;
				.hitThreshold = 256;
				.visible = false;
			}

			_slotText[i] = new global.Layer(win, _base);
			with(_slotText[i])
			{
				.setSize(CELL_W - 24, CELL_H - 20);
				.setPos(x + 16, y + 10);
				.font.height = 20;
				.hitThreshold = 256;
				.visible = false;
			}
		}

		_btnJump = new Button(win, _base);
		if(Storages.isExistentStorage(UI_ROOT + "jumpto.png"))
			_btnJump.create(UI_ROOT + "jumpto.png", 2);
		else
		{
			_btnJump.setImageSize(120, 40);
			_btnJump.setSize(120, 40);
			_btnJump.fillRect(0, 0, 120, 40, 0xAA406080);
			_btnJump.visible = true;
		}
		_btnJump.hitThreshold = 0;
		_btnJump.setPos(470, 695);
		addChainItem(_btnJump);

		createScrollbar(win);

		_nav = new AppreciationBottomNav(win, _base, this, SCENE_VOICE);
		_nav.addToChain(this);

		_tempMuteMaster = CONFIG.muteMaster;
		_tempMuteVoice = CONFIG.muteVoice;
		CONFIG.muteMaster = 0;
		CONFIG.muteVoice = 0;

		_voiceOwned = false;
		_tempVoiceVol = 0;
		if(VOICE === null)
		{
			VOICE = new SoundLayer(win);
			_voiceOwned = true;
		}
		else
			_tempVoiceVol = VOICE.volume;
		VOICE.volume = CONFIG.volVoice;

		_page = 0;
		_selIndex = -1;
		loadList();
		refreshSlots();
		selectSlot(-1);
		updateScrollbar();

		StopBgm();

		mouseTrackingMode = global.ChainItemBase.MOUSETRACKINGMODE_FREE;
		window.addInputNotify(this);
	}

	function gridWidth()
	{
		return COLS * CELL_W + (COLS - 1) * GAP_X;
	}

	function gridHeight()
	{
		return ROWS * CELL_H + (ROWS - 1) * GAP_Y;
	}

	function createScrollbar(win)
	{
		var barX = GRID_ORIGIN_X + gridWidth() + BAR_GAP;
		var barY = GRID_ORIGIN_Y;
		var barH = gridHeight();

		_barTrack = new global.Layer(win, _base);
		with(_barTrack)
		{
			.setImageSize(BAR_TRACK_W, barH);
			.setSize(BAR_TRACK_W, barH);
			.fillRect(0, 0, BAR_TRACK_W, barH, 0xFF555555);
			.hitThreshold = 256;
			.visible = true;
		}
		if(Storages.isExistentStorage(UI_ROOT + "bar_.png"))
		{
			var trackSrc = new global.Layer(win, _base);
			trackSrc.loadImages(UI_ROOT + "bar_.png");
			trackSrc.setSizeToImageSize();
			_barTrack.stretchCopy(0, 0, BAR_TRACK_W, barH, trackSrc, 0, 0, trackSrc.width, trackSrc.height, stFastLinear);
			invalidate trackSrc;
		}
		_barTrack.setPos(barX + (BAR_THUMB_W - BAR_TRACK_W) \ 2, barY);

		_barThumb = new global.Layer(win, _base);
		with(_barThumb)
		{
			if(Storages.isExistentStorage(UI_ROOT + "bar_button.png"))
			{
				.loadImages(UI_ROOT + "bar_button.png");
				.setSizeToImageSize();
			}
			else
			{
				.setImageSize(BAR_THUMB_W, BAR_THUMB_H);
				.setSize(BAR_THUMB_W, BAR_THUMB_H);
				.fillRect(0, 0, BAR_THUMB_W, BAR_THUMB_H, 0xFFFFFFFF);
			}
			.setPos(barX, barY);
			.hitThreshold = 256;
			.visible = true;
		}
	}

	function scrollThumbTravel()
	{
		var travel = gridHeight() - BAR_THUMB_H;
		if(travel < 1) travel = 1;
		return travel;
	}

	function canScroll()
	{
		return pageCount() > 1;
	}

	function updateScrollbar()
	{
		if(_barTrack === void || _barThumb === void) return;

		var barX = GRID_ORIGIN_X + gridWidth() + BAR_GAP;
		var barY = GRID_ORIGIN_Y;
		_barTrack.setPos(barX + (BAR_THUMB_W - BAR_TRACK_W) \ 2, barY);
		_barTrack.visible = true;

		var pages = pageCount();
		var y = barY;
		if(pages > 1)
			y = barY + (_page * scrollThumbTravel()) \ (pages - 1);
		_barThumb.setPos(barX, y);
		_barThumb.opacity = canScroll() ? 255 : 120;
		_barThumb.visible = true;
	}

	function pageFromThumbY(y)
	{
		var pages = pageCount();
		if(pages <= 1) return 0;
		var barY = GRID_ORIGIN_Y;
		var rel = int(y) - barY - _scrollDragOffsetY;
		if(rel < 0) rel = 0;
		var travel = scrollThumbTravel();
		if(rel > travel) rel = travel;
		return (rel * (pages - 1) + (travel \ 2)) \ travel;
	}

	function hitScrollbar(x, y)
	{
		var barX = GRID_ORIGIN_X + gridWidth() + BAR_GAP;
		var barY = GRID_ORIGIN_Y;
		var barH = gridHeight();
		if(x < barX - 4) return false;
		if(x > barX + BAR_THUMB_W + 4) return false;
		if(y < barY - 4) return false;
		if(y > barY + barH + 4) return false;
		return true;
	}

	function blitBox(dst, state)
	{
		if(dst === void) return;
		dst.fillRect(0, 0, CELL_W, CELL_H, 0x00000000);
		if(_boxSrc !== void && _boxSrc.width > 0)
		{
			var srcX = state * CELL_W;
			if(srcX + CELL_W > _boxSrc.width) srcX = 0;
			dst.copyRect(0, 0, _boxSrc, srcX, 0, CELL_W, CELL_H);
		}
		else
		{
			dst.fillRect(0, 0, CELL_W, CELL_H, 0xAA7090B0);
		}
		dst.visible = true;
	}

	function pageCount()
	{
		if(_list.count <= 0) return 1;
		return ((_list.count + MAX_SLOT - 1) \ MAX_SLOT);
	}

	function clampPage()
	{
		var pages = pageCount();
		if(_page < 0) _page = 0;
		if(_page >= pages) _page = pages - 1;
	}

	function listIndexOfSlot(slot)
	{
		return _page * MAX_SLOT + slot;
	}

	function loadList()
	{
		_list = LoadFavoriteVoices();
		if(_list === void || _list === null) _list = [];
		clampPage();
	}

	function setPage(page)
	{
		_page = page;
		clampPage();
		_hoverIndex = -1;
		refreshSlots();
		updateScrollbar();
	}

	function playFavoriteAt(listIndex)
	{
		if(listIndex < 0 || listIndex >= _list.count) return;
		var item = _list[listIndex];
		var voice = GetElm(item.voiceFile, "");
		if(voice == "") return;
		if(VOICE === null) return;
		try { StopVoice(); } catch(e) {}
		try
		{
			VOICE.volume = CONFIG.volVoice;
			PlayVoice(voice, 1.0, 1.0, 0, false);
		}
		catch(e) {}
	}

	function refreshSlots()
	{
		var i;
		for(i = 0; i < MAX_SLOT; i++)
		{
			var listIndex = listIndexOfSlot(i);
			var has = (listIndex < _list.count);
			_btnSlot[i].valid = has;
			if(!has)
			{
				blitBox(_btnSlot[i], BOX_IDLE);
				_slotFace[i].visible = false;
				_slotText[i].visible = false;
				continue;
			}

			var item = _list[listIndex];
			blitBox(_btnSlot[i], (listIndex == _selIndex) ? BOX_SELECTED : BOX_IDLE);

			_slotFace[i].visible = false;
			var faceId = GetElm(item.face, "");
			if(faceId != "" && ApplyFavoriteVoiceFaceToLayer(_slotFace[i], faceId, FACE_SLOT_W, FACE_SLOT_H))
			{
				var bx = _btnSlot[i].left;
				var by = _btnSlot[i].top;
				var fx = bx;
				var fy = by + CELL_H - _slotFace[i].height;
				_slotFace[i].setPos(fx, fy);
				_slotFace[i].opacity = FACE_SLOT_OPACITY;
				_slotFace[i].visible = true;
			}

			_slotText[i].fillRect(0, 0, _slotText[i].width, _slotText[i].height, 0x00000000);
			var summaryText = GetElm(item.text, "");
			if(summaryText == "") summaryText = GetElm(item.voiceFile, "");
			var summary = "「" + summaryText + "」";
			if(summary.length > 16) summary = summary.substr(0, 15) + "…」";
			_slotText[i].setPos(_btnSlot[i].left + 16, _btnSlot[i].top + 10);
			_slotText[i].drawText(0, 8, summary, 0xffffff, 255, true);
			_slotText[i].visible = true;
		}
	}

	function clearDetail()
	{
		_previewImage.visible = false;
		_dateLayer.fillRect(0, 0, _dateLayer.width, _dateLayer.height, 0x00000000);
		_textLayer.fillRect(0, 0, _textLayer.width, _textLayer.height, 0x00000000);
		_dateLayer.drawText(0, 4, "--/--/---- --:--", 0xffffff, 255, true);
		_textLayer.drawText(0, 8, "NO DATA", 0xffffff, 255, true);
	}

	function selectSlot(listIndex)
	{
		_selIndex = listIndex;
		refreshSlots();

		if(listIndex < 0 || listIndex >= _list.count)
		{
			clearDetail();
			return;
		}

		var item = _list[listIndex];

		_dateLayer.fillRect(0, 0, _dateLayer.width, _dateLayer.height, 0x00000000);
		_dateLayer.drawText(0, 4, GetElm(item.date, "--/--/---- --:--"), 0xffffff, 255, true);

		_textLayer.fillRect(0, 0, _textLayer.width, _textLayer.height, 0x00000000);
		var name = GetElm(item.name, "");
		var text = GetElm(item.text, "");
		var line;
		if(text != "")
			line = name + "：「" + text + "」";
		else if(name != "")
			line = name + "：「" + GetElm(item.voiceFile, "") + "」";
		else
			line = GetElm(item.voiceFile, "NO DATA");
		_textLayer.drawText(0, 8, line, 0xffffff, 255, true);

		_previewImage.visible = false;
		var thumb = GetElm(item.thumb, "");
		if(thumb == "" || !Storages.isExistentStorage(thumb))
			thumb = ResolveFavoriteVoiceThumbPath(GetElm(item.saveFile, ""));
		if(thumb != "" && Storages.isExistentStorage(thumb))
		{
			_previewImage.loadImages(thumb);
			_previewImage.setSizeToImageSize();
			var pw = _previewImage.width;
			var ph = _previewImage.height;
			if(pw > 0 && ph > 0)
			{
				var src = new global.Layer(window, _base);
				src.assignImages(_previewImage);

				// Fill one fixed 16:9-ish window for every saved thumbnail.
				// Old saves are only 301x171, so they must be enlarged as well.
				var cropX = 0;
				var cropY = 0;
				var cropW = pw;
				var cropH = ph;
				if(pw * PREVIEW_IMAGE_H > ph * PREVIEW_IMAGE_W)
				{
					cropW = (ph * PREVIEW_IMAGE_W) \ PREVIEW_IMAGE_H;
					cropX = (pw - cropW) \ 2;
				}
				else
				{
					cropH = (pw * PREVIEW_IMAGE_H) \ PREVIEW_IMAGE_W;
					cropY = (ph - cropH) \ 2;
				}

				_previewImage.setImageSize(PREVIEW_IMAGE_W, PREVIEW_IMAGE_H);
				_previewImage.setSize(PREVIEW_IMAGE_W, PREVIEW_IMAGE_H);
				_previewImage.stretchCopy(
					0, 0, PREVIEW_IMAGE_W, PREVIEW_IMAGE_H,
					src, cropX, cropY, cropW, cropH, stFastLinear
				);
				clipPreviewCorners(_previewImage);
				invalidate src;
			}
			_previewImage.setPos(
				PREVIEW_X + PREVIEW_IMAGE_INSET_X,
				PREVIEW_Y + PREVIEW_IMAGE_INSET_Y
			);
			_previewImage.visible = true;
		}

		playFavoriteAt(listIndex);
	}

	function findSlotIndex(target)
	{
		var i;
		for(i = 0; i < MAX_SLOT; i++)
			if(target == _btnSlot[i]) return i;
		return -1;
	}

	function confirmJumpSelected()
	{
		if(_selIndex < 0 || _selIndex >= _list.count) return;
		var item = _list[_selIndex];
		var saveFile = GetElm(item.saveFile, "");
		if(saveFile == "" || !FavoriteVoiceSaveExists(saveFile))
		{
			try { Information("该语音没有可跳转进度（请重新收藏）", 1500); } catch(e) {}
			return;
		}
		CallConfirm(
			"$c:aquamarine,midnightblue;跳转到该语音进度$c;确认",
			SystemRegister.CONFIRM_LOAD,
			jumpFavoriteDecide incontextof this,
			null
		);
	}

	function jumpFavoriteDecide()
	{
		if(_selIndex < 0 || _selIndex >= _list.count) return;
		try { StopVoice(); } catch(e) {}
		var item = _list[_selIndex];
		HitThresholdSelectItems(_btnSlot, 256);
		if(_btnJump !== void) _btnJump.hitThreshold = 256;
		if(_nav !== void) _nav.disableHits();
		if(!JumpFavoriteVoice(item))
		{
			HitThresholdSelectItems(_btnSlot, 0);
			if(_btnJump !== void) _btnJump.hitThreshold = 0;
			try { Information("跳转失败：存档无效", 1500); } catch(e) {}
			return;
		}
	}

	function confirmDeleteSelected()
	{
		if(_selIndex < 0 || _selIndex >= _list.count) return;
		CallConfirm(
			"要删除这条语音收藏吗？",
			SystemRegister.CONFIRM_DELETE,
			deleteFavoriteDecide incontextof this,
			null
		);
	}

	function deleteFavoriteDecide()
	{
		if(_selIndex < 0 || _selIndex >= _list.count) return;

		var path = GetElm(_list[_selIndex].voiceFile, "");
		if(path == "") return;

		try { StopVoice(); } catch(e) {}
		RemoveFavoriteVoice(path);

		loadList();
		if(_selIndex >= _list.count) _selIndex = _list.count - 1;
		refreshSlots();
		updateScrollbar();
		selectSlot(_selIndex);
	}

	function finalize()
	{
		window.removeInputNotify(this);
		try { StopVoice(); } catch(e) {}

		CONFIG.muteMaster = _tempMuteMaster;
		CONFIG.muteVoice = _tempMuteVoice;

		try { StopVoice(); } catch(e) {}
		if(_voiceOwned)
		{
			invalidate VOICE;
			VOICE = null;
			_voiceOwned = false;
		}
		else if(VOICE !== null && isvalid VOICE)
			VOICE.volume = _tempVoiceVol;

		InvalidateArray(_btnSlot);
		InvalidateArray(_slotFace);
		InvalidateArray(_slotText);
		invalidate _btnJump;
		invalidate _barThumb;
		invalidate _barTrack;
		if(_nav !== void) _nav.finalize();
		invalidate _nav;
		invalidate _previewBorder;
		invalidate _previewImage;
		invalidate _previewFrame;
		invalidate _dateLayer;
		invalidate _textLayer;
		invalidate _boxSrc;
		invalidate _cover;
		invalidate _base;
		invalidate _list;

		global.Sprite.finalize();
		global.ChainItemBase.finalize();
	}

	function who(){ return "VoiceModeScene"; }

	function onButtonEnter(target)
	{
		var slot = findSlotIndex(target);
		if(slot < 0) return;
		var listIndex = listIndexOfSlot(slot);
		if(listIndex >= _list.count) return;
		_hoverIndex = listIndex;
		if(listIndex != _selIndex) blitBox(_btnSlot[slot], BOX_HOVER);
	}

	function onButtonLeave(target)
	{
		var slot = findSlotIndex(target);
		if(slot < 0) return;
		var listIndex = listIndexOfSlot(slot);
		if(_hoverIndex == listIndex) _hoverIndex = -1;
		if(listIndex != _selIndex) blitBox(_btnSlot[slot], BOX_IDLE);
		else blitBox(_btnSlot[slot], BOX_SELECTED);
	}

	function onButtonDownL(target)
	{
		if(_nav !== void && _nav.onButtonDownL(target)) return;

		if(target == _btnJump)
		{
			confirmJumpSelected();
			return;
		}

		var slot = findSlotIndex(target);
		if(slot < 0) return;
		var listIndex = listIndexOfSlot(slot);
		if(listIndex < 0 || listIndex >= _list.count) return;
		if(listIndex == _selIndex)
		{
			refreshSlots();
			playFavoriteAt(listIndex);
		}
		else
			selectSlot(listIndex);
	}

	function onButtonDownR(target)
	{
		var slot = findSlotIndex(target);
		if(slot >= 0)
		{
			var listIndex = listIndexOfSlot(slot);
			if(listIndex == _selIndex && listIndex >= 0 && listIndex < _list.count)
			{
				confirmDeleteSelected();
				return;
			}
		}
		changeScene(SCENE_TITLE);
	}

	function onMouseDown(x, y, button, shift)
	{
		if(button == mbRight)
		{
			changeScene(SCENE_TITLE);
			return;
		}
		if(button != mbLeft) return;
		if(!canScroll()) return;

		var cx = window.primaryLayer.cursorX;
		var cy = window.primaryLayer.cursorY;
		if(!hitScrollbar(cx, cy)) return;

		_draggingScroll = true;
		var thumbTop = (_barThumb !== void) ? _barThumb.top : GRID_ORIGIN_Y;
		if(cy >= thumbTop && cy <= thumbTop + BAR_THUMB_H)
			_scrollDragOffsetY = cy - thumbTop;
		else
		{
			_scrollDragOffsetY = BAR_THUMB_H \ 2;
			setPage(pageFromThumbY(cy));
		}
	}

	function onMouseMove(x, y, shift)
	{
		if(!_draggingScroll) return;
		setPage(pageFromThumbY(window.primaryLayer.cursorY));
	}

	function onMouseUp(x, y, button, shift)
	{
		if(button == mbLeft)
		{
			_draggingScroll = false;
			_scrollDragOffsetY = 0;
		}
	}

	function onMouseWheel(shift, delta, x, y)
	{
		if(!canScroll()) return;
		if(delta < 0)
		{
			if(_page < pageCount() - 1) setPage(_page + 1);
		}
		else if(delta > 0)
		{
			if(_page > 0) setPage(_page - 1);
		}
	}

	function onKeyDown(key, shift)
	{
		if(key == VK_ESCAPE)
			changeScene(SCENE_TITLE);
		else if(key == VK_DELETE || key == VK_BACK)
			confirmDeleteSelected();
		else if(key == VK_LEFT || key == VK_PRIOR || key == VK_UP)
		{
			if(_page > 0) setPage(_page - 1);
		}
		else if(key == VK_RIGHT || key == VK_NEXT || key == VK_DOWN)
		{
			if(_page < pageCount() - 1) setPage(_page + 1);
		}
		global.ChainItemBase.onKeyDown(...);
	}

	function close()
	{
		valid = false;
	}

	function changeScene(scene)
	{
		HitThresholdSelectItems(_btnSlot, 256);
		if(_btnJump !== void) _btnJump.hitThreshold = 256;
		if(_nav !== void) _nav.disableHits();

		var param = %[];
		if(scene == SCENE_TITLE) param = %[submenu:1];
		game.changeScene(scene, true, param);
		close();
	}
}
