/*
	ロゴ・タイトル
*/

// SDL_GetPlatform() returns the literal "iOS" on iPhone and iPad.
function IsIOSPlatform(){
	return System.platformName == "iOS";
}

class Logo extends Sprite, SelectItemNotifyBase, SceneBase{
	var _state = 0;
	var _fCancel = false;
	var _fGoTitle = false;
	var _spr = %[];

	var _movie;
	var _movieWaitCount = 0;
	var _movieTimer;
	var _logoWindow;

	var _te;
	var _finalizeDone = false;
	var _fStep02 = false;
	var _inputGuardStartedAt = 0;

	var SPR_LIST = [
		%[id:"ATTENTION_MARK", file:"ui_1920/FRM_0502.png", center:[179,  34], pos:[960, 235]], 
		%[id:"ATTENTION"     , file:"ui_1920/FRM_0503.png", center:[580, 270], pos:[960, 595]]
	];

	var stLogo = 1;
	var stAttentionPlay = 2;
	var stAttentionEnd = 3;

	function Logo(win, par){
		Sprite(...);
		hasImage = false;
		hitType = htMask;
		hitThreshold = 0;
		setSize(WINDOW_WIDTH, WINDOW_HEIGHT);
		fillRect(0, 0, width, height, 0x0);
		absolute = LAYER_LOGO;

		_spr["BASE"] = new global.Sprite(win, this);
		with(_spr.BASE){
			.loadImages("ui_1920/FRM_0501.png");
			.setSizeToImageSize();
			.setPos(WINDOW_CENTER_X-.width\2, WINDOW_CENTER_Y-.height\2);
			.hitThreshold = 256;
		}

		for(var i=0;i<SPR_LIST.count;i++){
			_spr[SPR_LIST[i].id] = new global.Sprite(window, _spr.BASE);
			with(_spr[SPR_LIST[i].id]){
				.loadImages(SPR_LIST[i].file);
				.setSizeToImageSize();
				.setAffineOffset(SPR_LIST[i].center[0], SPR_LIST[i].center[1]);
				.setCenter(SPR_LIST[i].center[0], SPR_LIST[i].center[1]);
				.setPos(SPR_LIST[i].pos[0], SPR_LIST[i].pos[1]);
				.hitThreshold = 256;
				.visible = true;
			}
		}

		CreateSprCover();
		with(SPR_COVER){
			.fillRect(0, 0, SPR_COVER.width, SPR_COVER.height, 0xffffffff);
		}

		visible = true;

		_logoWindow = win;
		_movie = new MovieLayer(win, this, true);
		_movie.hitThreshold = 256;
		_state = stLogo;
		_inputGuardStartedAt = System.getTickCount();
		// [BUGFIX: Kirikiroid2 1.3.9]
		// 起動直後はウィンドウがまだ全画面化されていないことがあるため、
		// 全画面化の完了を待ってからムービーを開く(最大 20×100ms 待機)。
		// ムービーを先に開くとネイティブ動画オーバーレイの表示領域が
		// 小さなまま固定され、画面全体に広がらない。
		_movieWaitCount = 0;
		_movieTimer = new Timer(movieStartCallback, "");
		_movieTimer.interval = 100;
		_movieTimer.enabled = true;

		_te = new TimerEvent();

		OnceCall(step01, 1500);

		// ムービー停止通知やトランジション完了通知が届かない場合の
		// セーフティネット(正常時は何もしない)。
		OnceCall(flowWatchdog1, 9000, "logo-watchdog1");

		window.addInputNotify(this);
	}
	function finalize(){
		if(_finalizeDone) return;
		_finalizeDone = true;

		try{ window.removeInputNotify(this); }catch(eInput){}

		try{ cancel(); }catch(eCancel){ Debug.message("Logo cancel failed: " + eCancel); }
		try{ close(); }catch(eClose){ Debug.message("Logo close failed: " + eClose); }

		for(var i=0;i<SPR_LIST.count;i++){
			var id = SPR_LIST[i].id;
			var sprite = _spr[id];
			if(sprite !== void && sprite !== null && isvalid sprite){
				try{ invalidate sprite; }catch(eSprite){}
			}
			_spr[id] = null;
		}
		var base = _spr["BASE"];
		if(base !== void && base !== null && isvalid base){
			try{ invalidate base; }catch(eBase){}
		}
		_spr["BASE"] = null;

		var movie = _movie;
		_movie = null;
		if(movie !== void && movie !== null && isvalid movie){
			try{ invalidate movie; }catch(eMovie){}
		}

		var timer = _te;
		_te = null;
		if(timer !== void && timer !== null && isvalid timer){
			try{ timer.stop(); }catch(eTimerStop){}
			try{ invalidate timer; }catch(eTimer){}
		}

		var mTimer = _movieTimer;
		_movieTimer = void;
		if(mTimer !== void && mTimer !== null && isvalid mTimer){
			try{ invalidate mTimer; }catch(eMTimer){}
		}

		try{ global.Sprite.finalize(); }
		catch(eFinalize){ Debug.message("Logo finalize failed: " + eFinalize); }
	}

	//ロゴ：時間待ち
	function step01(){
		PlaySystemVoice("ブランドコール");
	}
	//ロゴ→警告文フェード
	function step02(){
		if(_fStep02) return;
		_fStep02 = true;
		_state = stAttentionPlay;
		if(CONFIG.muteSystem || CONFIG.muteMaster)
			keyframe(stAttentionEnd);

		// ムービー再生中、背面を隠していた白幕をフェードアウトさせる。
		// ここでフェードアウトしないとムービー終了後に白画面のままになる。
		with(SPR_COVER){
			.setBlendingEnvelope(0);
			.beginActivation(500);
		}

		with(_spr.BASE){
			.setTransitionCompleteCall(step03);
			.opacity = 0;
			.setBlendingEnvelope(255);
			.beginActivation(1000);
			.visible = true;
		}
	}
	//警告文：時間待ち
	function step03(){
		_spr.BASE.setTransitionCompleteCall();
		OnceCall(step04, 8000);
	}
	//警告文：フェードアウト
	function step04(){
		with(SPR_COVER){
			.setTransitionCompleteCall(step05);
			.opacity = 0;
			.setBlendingEnvelope(255);
			.beginActivation(1000);
			.visible = true;
		}
	}
	//次のシーンに移動する
	function step05(){
		gotoTitle();
	}

	function gotoTitle(){
		if(_fGoTitle) return;
		_fGoTitle = true;

		with(SPR_COVER){
			.setTransitionCompleteCall();
		}
		game.changeScene(SCENE_TITLE);
		close();
	}

	function cancel(){
		OnceCallCancel(step01);
		OnceCallCancel(step03);
		OnceCallCancel(step04);
		OnceCallCancel(step05);
		OnceCallCancel("logo-watchdog1");
		OnceCallCancel("logo-watchdog2");
		with(_spr.BASE){
			.setTransitionCompleteCall();
			.flushActivation();
		}
		with(SPR_COVER){
			.setTransitionCompleteCall();
			.flushActivation();
		}
	}

	function close(){
		cancel();

		visible = false;
		valid = false;
	}

	function onKeyDown(key, shift){
		onAnyInput();
	}
	function onMouseDown(x, y, button, shift){
		onAnyInput();
	}

	function keyframe(state){
		switch(state){
		case stAttentionEnd : 
			for(var i=0;i<SPR_LIST.count;i++){
				with(_spr[SPR_LIST[i].id]){
					.stopActivation();
					.setPos(SPR_LIST[i].pos[0], SPR_LIST[i].pos[1]);
					.visible = true;
				}
			}
			break;
		}
	}

	function spriteAction(spr, path=[], accel=0, time=0, show=true){
		spr.stopActivation();

		if(!show){
			spr.visible = false;
			return;
		}

		for(var i=0;i<path.count;i+=7){
			if(path[i+2] == -1) path[i+2] = spr.absolute;
		}

		spr.setMovingSplineEnvelope2(path, accel);
		spr.beginActivation(time);
		spr.visible = true;
	}

	function onAnyInput(){
		if(!valid) return;

		// Some iOS containers emit a synthetic tap as the view is attached.
		// Ignore only that short startup window; real taps must still be able to
		// skip the intro after the application has settled.
		if(IsIOSPlatform()) {
			var inputGuardElapsed = System.getTickCount() - _inputGuardStartedAt;
			if(inputGuardElapsed >= 0 && inputGuardElapsed < 1000) return;
		}

		cancel();

		_te.stop();

		switch(_state){
		case stLogo :
			if(_movie !== null){
				try{ _movie.stop(); }catch(eStop){}
			}
			gotoTitle();
			break;
		case stAttentionPlay : 
			_fCancel = true;
			keyframe(stAttentionEnd);
			_state = stAttentionEnd;
			OnceCall(step04, 4000);
			break;
		case stAttentionEnd : 
		default : 
			_fCancel = true;
			step05(); 
			break;
		}
	}

	function debugJump(str, label=""){
		StopBgm();
		close();
		game.changeScene(SCENE_ADV, false, %[debug:str, label:label]);
	}

	//ムービー開始用タイマーコールバック(全画面化の完了を待つ)
	function movieStartCallback(){
		_movieWaitCount++;
		if((_logoWindow !== void && _logoWindow.fullScreen) ||
			(_logoWindow !== void && (_logoWindow.innerWidth != WINDOW_WIDTH || _logoWindow.innerHeight != WINDOW_HEIGHT)) ||
			_movieWaitCount >= 20){
			if(_movieTimer !== void && isvalid _movieTimer) invalidate _movieTimer;
			_movieTimer = void;
			if(_movie === null) return;
			// iOS は、長い GOP と無音 AAC トラックを持つ元の動画で
			// 参照フレームを失うと、再生時刻だけ進んで映像が停止することがある。
			// 1 秒間隔の I フレーム、B フレームなし、映像のみで再エンコードした
			// iOS 専用版を使用し、他プラットフォームの素材は変更しない。
			var logoMovie = "sphere";
			if(IsIOSPlatform()) logoMovie = "sphere_ios";
			if(!_movie.start(logoMovie, this)){
				var failedMovie = _movie;
				_movie = null;
				if(failedMovie !== void && failedMovie !== null && isvalid failedMovie)
					invalidate failedMovie;
				OnceCall(step02, 1);
			}
		}
	}

	// ムービー停止通知が届かない場合の強制進行(通常は何もしない)
	function flowWatchdog1(){
		if(!valid || _fGoTitle) return;
		if(_state == stLogo){
			if(_movie !== null){
				try{ _movie.stop(); }catch(eStop){}
			}
			step02();
		}
		OnceCall(flowWatchdog2, 12000, "logo-watchdog2");
	}
	function flowWatchdog2(){
		if(!valid || _fGoTitle) return;
		if(_state == stAttentionPlay || _state == stAttentionEnd){
			step05();
		}
	}

	function action(ev){
		if(ev.type == "Movie.onStatusChanged" && ev.status == "stop"){
			// ネイティブ動画レイヤーは停止後も最後のフレームを残すことがあり、
			// 白画面のまま残るため、即座に破棄して白残りを防ぐ。
			var m = _movie;
			_movie = null;
			if(m !== void && m !== null && isvalid m){
				try{ m.visible = false; }catch(eVis){}
				try{ invalidate m; }catch(eInv){}
			}
			step02();
		}
	}
}

class MovieScene extends Layer, SceneBase{
	function MovieScene(win, par){
		Layer(...);
		hasImage = false;
		setSize(WINDOW_WIDTH, WINDOW_HEIGHT);

		if(SPR_COVER != null){
			with(SPR_COVER){
				.setTransitionCompleteCall();
				.opacity = 0;
				.visible = false;
			}
		}

		if(!PlayMovie("cube", this)) OnceCall(returnToTitle, 1);
		visible = true;
		win.addInputNotify(this);
	}
	function finalize(){
		win.removeInputNotify(this);
		global.Layer.finalize();
	}

	function who(){return "MovieScene";}

	function close(){
		StopMovie();
		visible = false;
		valid = false;
		try{ win.removeInputNotify(this); }catch(e){}
	}
	function returnToTitle(){
		close();
		game.changeScene(SCENE_TITLE);
	}

	function action(ev){
		if(ev.status == "stop") returnToTitle();
	}

	function debugJump(str, label=""){
		StopBgm();
		close();
		game.changeScene(SCENE_ADV, false, %[debug:str, label:label]);
	}

	function onKeyDown(key, shift){
		if(key == VK_ESCAPE) returnToTitle();
	}
	function onMouseDown(x, y, button, shift){
		if(button == mbRight || (IsIOSPlatform() && button == mbLeft))
			returnToTitle();
	}
}

class Title extends Sprite, SelectItemNotifyBase, SceneBase, ChainItemBase{
	var _spr = [];
	var _titleCharacterLayers = [];

	// 各角色路线结局会在剧本末尾写入对应的全局标记。
	// 按画面前后关系排列，确保全部解锁时能还原完整标题图。
	var TITLE_CHARACTER_LIST = [
		%[flag:25, file:"ui_1920/main_menu/QD-13-motoka.png"],
		%[flag:24, file:"ui_1920/main_menu/QD-13-kazuha.png"],
		%[flag:22, file:"ui_1920/main_menu/QD-13-nao.png"],
		%[flag:21, file:"ui_1920/main_menu/QD-13-sora.png"],
		%[flag:23, file:"ui_1920/main_menu/QD-13-akira.png"]
	];

	var _btnBase;
	var _ptGrp = [];
	var _grpBtn, _grpBtnBonus;

	var _separate =[];

	var _logo;
	@if(__TRIAL__ != 0)
		var _logoTR;
	@endif

	var _version;

	var _sprASaveInfo;

	var _enterBonus = false;
	var _btnBonusBack;

	var BTN_LIST = [
		
		%[id:"btnContinue", file:"ui_1920/main_menu/QD-02.png", ptn:2, par:0, flag:0], 
		%[id:"btnStart"   , file:"ui_1920/main_menu/QD-01.png", ptn:2, par:0, flag:0], 
		%[id:"btnLoad"    , file:"ui_1920/main_menu/QD-03.png", ptn:2, par:0, flag:0], 
		%[id:"btnConfig"  , file:"ui_1920/main_menu/QD-04.png", ptn:2, par:0, flag:0], 

		// 这一行是鉴赏，还没做完
		%[id:"btnBonus"   , file:"ui_1920/main_menu/QD-05.png", ptn:2, par:0, flag:0], 
		%[id:"btnEnd"     , file:"ui_1920/main_menu/QD-06.png", ptn:2, par:0, flag:0], 

		%[id:"btnAlbum"   , file:"ui_1920/main_menu/QD-08.png", ptn:2, par:1, flag:0], 
		%[id:"btnMusic"   , file:"ui_1920/main_menu/QD-07.png", ptn:2, par:1, flag:0], 
		%[id:"btnMemories", file:"ui_1920/main_menu/QD-09.png", ptn:2, par:1, flag:0],
		%[id:"btnVoice"   , file:"ui_1920/main_menu/QD-10.png", ptn:2, par:1, flag:0]
	];

	function Title(win, par, fBonus=false){
		Sprite(...);
		hitThreshold = 0;
		loadImages("ui_1920/main_menu/QD-13-BG.png");
		setSizeToImageSize();
		absolute = LAYER_TITLE;

		for(var i=0;i<TITLE_CHARACTER_LIST.count;i++){
			var ref = TITLE_CHARACTER_LIST[i];
			if(!ChkGlobalFlagOn(ref.flag)) continue;

			var character = new global.Sprite(win, this);
			with(character){
				.loadImages(ref.file);
				.setSizeToImageSize();
				.setPos(0, 0);
				.hitThreshold = 256;
				.visible = true;
			}
			_titleCharacterLayers.add(character);
		}

		_btnBase = new global.Layer(win, this);
		with(_btnBase){
			.loadImages("ui_1920/main_menu/QD-12.png");
			.setSizeToImageSize();

			.setPos(0, WINDOW_HEIGHT-.height);

			.hitThreshold = 256;
			.visible = true;
		}

		_version = new global.Layer(win, this);
		with(_version){
			var text = "version "+GAME_VERSION;
			.font.height = 21;
			.font.bold = true;
			var w = .font.getTextWidth(text) + 8;
			.setSize(w, .font.height+4);
			.setPos(_btnBase.left, _btnBase.top);
			.setPos(.left+_btnBase.width-.width, .top+_btnBase.height-.height);
			.drawText(4, 0, text, 0xffffff, 255, true, 1024*3, GetDefineColor("black"), 3, 0, 0);
			.visible = true;
		}

		var bit = 16;
		var h = 43;
		var pitch = h + bit;
		_grpBtn = new SelectItemGroupSprite(win, this);
		with(_grpBtn){
			.setSize(_btnBase.width, _btnBase.height);
			.setPos(_btnBase.left, _btnBase.top);
		}
		_grpBtnBonus = new SelectItemGroupSprite(win, this);
		with(_grpBtnBonus){
			.setSize(_btnBase.width, _btnBase.height);
			.setPos(_btnBase.left, _btnBase.top);
			.opacity = 0;
			.visible = true;
		}

		_ptGrp[0] = new Point(_grpBtn.left, _grpBtn.top);
		_ptGrp[1] = new Point(_grpBtnBonus.left, _grpBtnBonus.top);
		for(var i=0;i<BTN_LIST.count;i++){
			this[BTN_LIST[i].id] = new Button(win, this);
			with(this[BTN_LIST[i].id]){
				.parent = BTN_LIST[i].par == 0 ? _grpBtn : _grpBtnBonus;

				if(BTN_LIST[i].file !== void)
					.create(BTN_LIST[i].file, BTN_LIST[i].ptn);

				.visible = false;
			}
		}

		var interval = 12;
		var layout = [];
		if(ChkAutoSave()){
			layout.add(btnContinue);
		}
		layout.add(btnStart);
		layout.add(btnLoad);
		layout.add(btnConfig);
		@if(__TRIAL__ == 0)
			if(ChkGlobalFlag(1)){
				layout.add(btnBonus);
			}
		@endif
		layout.add(btnEnd);
		setLayout(layout, 55, interval);

		layout.clear();
		layout.add(btnAlbum);
		layout.add(btnMusic);
		layout.add(btnMemories);
		layout.add(btnVoice);
		setLayout(layout, 55, interval);

		// iOS has no synthesized right mouse button. Provide the same explicit
		// return control used by the appreciation screens so the bonus menu is
		// never a one-way navigation path on touch-only devices.
		if(IsIOSPlatform()){
			_btnBonusBack = new Button(win, this);
			_btnBonusBack.create("ui_1920/appreciation/backtotitle.png", 2);
			_btnBonusBack.setPos(56, 1005);
			_btnBonusBack.hitThreshold = 0;
			_btnBonusBack.visible = false;
		}

		@if(__TRIAL__ == 0)
			if(!ChkGlobalFlag(1))	btnBonus.visible = false;
		@endif
		@if(__TRIAL__ != 0)
			btnBonus.visible = false;
		@endif

		btnStart.hitThreshold = 0;
		btnLoad.hitThreshold = 0;
		btnContinue.hitThreshold = 0;
		btnConfig.hitThreshold = 0;
		btnBonus.hitThreshold = 0;
		btnEnd.hitThreshold = 0;
		btnAlbum.hitThreshold = 256;
		btnMusic.hitThreshold = 256;
		btnMemories.hitThreshold = 256;
		btnVoice.hitThreshold = 256;

		addChainItem(btnContinue);
		addChainItem(btnStart);
		addChainItem(btnLoad);
		addChainItem(btnConfig);
		if(btnBonus.visible) addChainItem(btnBonus);
		addChainItem(btnEnd);

		_logo = new global.Sprite(win, this);
		with(_logo){
			.loadImages("ui_1920/main_menu/QD-11.png");
			.setSizeToImageSize();

			.setPos(620, 88);

			.hitThreshold = 256;
			.visible = true;

			PlaySystemVoice("タイトルコール");
		}
		@if(__TRIAL__)
			_logoTR = new global.Sprite(win, this);
			with(_logoTR){
				
				.loadImages("ui_1920/main_menu/QD-11.png");
				.setSizeToImageSize();

				.setPos(_logo.left+_logo.width-.width, _logo.top+_logo.height);

				.hitThreshold = 256;
				.visible = true;

				PlaySystemVoice("タイトルコール");
			}
		@endif

		if(SPR_COVER == null){
			CreateSprCover();
			SPR_COVER.fillRect(0, 0, SPR_COVER.width, SPR_COVER.height, 0xffffffff);
		}
		with(SPR_COVER){
			.opacity = 255;
			.setBlendingEnvelope(0);
			.type = ltAdditive;
			.beginActivation(1000);
			.visible = true;
		}

		PlayBgm("BGM07");

		_sprASaveInfo = new SavedataHeader(win, this, true);

		fadeEnd();
		visible = true;

		if(fBonus) enterBonus(0);

		window.addInputNotify(this);

	}
	function finalize(){
		window.removeInputNotify(this);

		InvalidateArray(_spr);
		invalidate _spr;
		InvalidateArray(_titleCharacterLayers);
		invalidate _titleCharacterLayers;
		for(var i=0;i<BTN_LIST.count;i++){
			var button = this[BTN_LIST[i].id];
			if(button !== void && button !== null) invalidate button;
		}
		invalidate _btnBase;
		invalidate _grpBtn;
		invalidate _grpBtnBonus;
		invalidate _btnBonusBack;
		InvalidateArray(_ptGrp);

		InvalidateArray(_separate);

		invalidate _logo;
		@if(__TRIAL__ != 0)
			invalidate _logoTR;
		@endif
		invalidate _version;
		invalidate _sprASaveInfo;

		global.Sprite.finalize();
	}

	function close(){
		if(_btnBonusBack !== void) _btnBonusBack.visible = false;
		visible = false;
		valid = false;
		// P1-2: detach input immediately. finalize may call remove again; safe twice.
		try{
			window.removeInputNotify(this);
		}catch{
		}
	}

	function fadeEnd(){
		setTransitionCompleteCall();
		with(_grpBtn){
			.opacity = 0;
			.setBlendingEnvelope(255);
			.beginActivation(500);
			.visible = true;
		}
	}

	function setLayout(layout=[], sy, interval=0){
		var total = 0;
		for(var i=0;i<layout.count;i++){
			total += layout[i].width;
			if(i != 0) total += interval;
		}
		var dx = int((WINDOW_WIDTH-total)/2);
		var dy = sy;
		for(var i=0;i<layout.count;i++){
			with(layout[i]){
				.setPos(dx, dy);
				dx += .width + interval;
				.visible = true;
			}
		}
	}

	function debugJump(str, label=""){
		StopBgm();
		close();
		game.changeScene(SCENE_ADV, false, %[debug:str, label:label]);
	}

	function onButtonDownL(target){
		if(_btnBonusBack !== void && target == _btnBonusBack){
			leaveBonus();
			return;
		}
		switch(target){
		case btnStart :
			hitThresholdSelectItems(256);
			
			game.changeScene(SCENE_ADV, true, %[scenario:"00_z000"]);

			

			StopBgm(5000);

			var mv = [[0, 0], [64, 0], [-64, 0], [128, 0], [-128, 0]];
			for(var i=0;i<_spr.count;i++){
				with(_spr[i]){
					if(i==0){
						.setZoomingEnvelope(.zoomx, 120);
						.beginActivation(5000);
					}else{
						.setBlendingEnvelope(0);
						.setMovingEnvelope(.left, .top, .left+mv[i][0], .top+mv[i][1], 2);
						.beginActivation(1000);
					}
				}
			}

			setTransitionCompleteCall(close);
			setBlendingEnvelope(0);
			beginActivation(3000);

			break;
		case btnLoad :
			PlaySystemVoice("タイトル：ロード");

			CallLoadSaveHD(true, null, true);
			break;
case btnContinue :
			// Immediate ADV load. SceneManager(sync=false) finalizes this Title;
			// do not schedule further Title animations after the switch.
			hitThresholdSelectItems(256);
			game.changeScene(SCENE_ADV, false, %[file:"asave.bmp"]);
			break;
		case btnConfig :
			PlaySystemVoice("タイトル：コンフィグ");

			CallConfig();
			break;
		case btnBonus :
			PlaySystemVoice("タイトル：鑑賞");
			enterBonus();
			break;
		case btnAlbum :

			hitThresholdSelectItems(256);

			game.changeScene(SCENE_ALBUM);

			//StopBgm(5000);

			setBlendingEnvelope(0);
			beginActivation(500);
			setTransitionCompleteCall(close);
			break;
		case btnMusic :
			hitThresholdSelectItems(256);

			game.changeScene(SCENE_MUSIC);

			StopBgm(5000);

			setBlendingEnvelope(0);
			beginActivation(500);
			setTransitionCompleteCall(close);
			break;
		case btnMemories :
			hitThresholdSelectItems(256);

			game.changeScene(SCENE_MEMORIES);

			//StopBgm(5000);

			setBlendingEnvelope(0);
			beginActivation(500);
			setTransitionCompleteCall(close);
			break;
		case btnVoice :
			hitThresholdSelectItems(256);

			game.changeScene(SCENE_VOICE);

			setBlendingEnvelope(0);
			beginActivation(500);
			setTransitionCompleteCall(close);
			break;
		case btnEnd :
			PlaySystemVoice("ゲーム終了：確認");
			CallConfirm("要结束游戏吗？", SystemRegister.CONFIRM_END, game.exitGame, endCancel, true);
			break;
		}
	}
	function onButtonDownR(target){
		onMouseDown(0, 0, mbRight, 0);
	}

	function onButtonEnter(target){
		switch(target){
		case btnStart :
			break;
		case btnLoad :
			break;
		case btnContinue :
			if(target == btnContinue){
				var ref = saveMan.atASave();
				if(!ref.valid) return;
				with(_sprASaveInfo){
					var x = btnContinue.parent.left + btnContinue.left + btnContinue.width \ 2- .width \ 2;
					var y = btnContinue.parent.top +btnContinue.top - .height - 4;

					.set(0, -1, ref.realDate, ref.gameDate, ref.comment, ref.file, ref.root, ref.comment_edit);
					.setupInfo();
					.setupThumb();

					._btn[0].visible = true;
					._btn[0].valid = false;

					.opacity = 0;
					.setBlendingEnvelope(255);
					.setMovingEnvelope(x, y-16, x, y, 2);
					.beginActivation(300);

					.onButtonEnter();
					.visible = true;
				}
			}
			break;
		case btnConfig :
			break;
		case btnBonus :
			break;
		case btnEnd :
			break;

		default :
			break;
		}
	}
	function onButtonLeave(target){
		if(target == btnContinue){
			_sprASaveInfo.visible = false;
			_sprASaveInfo.onButtonLeave();
		}
	}

	function onMouseDown(x, y, button, shift){
		if(button == mbRight && _enterBonus){
			leaveBonus();
		}
	}
	function onKeyDown(key, shift){
		if(key == VK_ESCAPE && _enterBonus){
			leaveBonus();
		}else{
			global.ChainItemBase.onKeyDown(key, shift);
		}
	}

	function enterBonus(time=300){
		_enterBonus = true;

		btnStart.hitThreshold = 256;
		btnContinue.hitThreshold = 256;
		btnLoad.hitThreshold = 256;
		btnConfig.hitThreshold = 256;
		btnBonus.hitThreshold = 256;
		btnEnd.hitThreshold = 256;
		btnAlbum.hitThreshold = 0;
		btnMusic.hitThreshold = 0;
		btnMemories.hitThreshold = 0;
		btnVoice.hitThreshold = 0;

		removeChainItemAll();
		addChainItem(btnAlbum);
		addChainItem(btnMusic);
		addChainItem(btnMemories);
		addChainItem(btnVoice);
		if(_btnBonusBack !== void){
			_btnBonusBack.visible = true;
			addChainItem(_btnBonusBack);
		}

		_grpBtn.flushActivation();
		_grpBtnBonus.flushActivation();

		_grpBtn.setMovingEnvelope(_ptGrp[0].x, _ptGrp[0].y, _ptGrp[0].x, _ptGrp[0].y+32, 2);
		_grpBtn.setBlendingEnvelope(0);
		_grpBtn.beginActivation(time);
		_grpBtnBonus.opacity = 0;
		_grpBtnBonus.setMovingEnvelope(_ptGrp[1].x, _ptGrp[1].y+32, _ptGrp[1].x, _ptGrp[1].y, 2);
		_grpBtnBonus.setBlendingEnvelope(255);
		_grpBtnBonus.beginActivation(time);
	}
	function leaveBonus(){
		_enterBonus = false;
		if(_btnBonusBack !== void) _btnBonusBack.visible = false;

		btnStart.hitThreshold = 0;
		btnContinue.hitThreshold = 0;
		btnLoad.hitThreshold = 0;
		btnConfig.hitThreshold = 0;
		btnBonus.hitThreshold = 0;
		btnEnd.hitThreshold = 0;
		btnAlbum.hitThreshold = 256;
		btnMusic.hitThreshold = 256;
		btnMemories.hitThreshold = 256;
		btnVoice.hitThreshold = 256;

		removeChainItemAll();
		addChainItem(btnContinue);
		addChainItem(btnStart);
		addChainItem(btnLoad);
		addChainItem(btnConfig);
		if(btnBonus.visible) addChainItem(btnBonus);
		addChainItem(btnEnd);

		_grpBtn.flushActivation();
		_grpBtnBonus.flushActivation();

		_grpBtn.opacity = 0;
		_grpBtn.setMovingEnvelope(_ptGrp[0].x, _ptGrp[0].y+32, _ptGrp[0].x, _ptGrp[0].y, 2);
		_grpBtn.setBlendingEnvelope(255);
		_grpBtn.beginActivation(300);
		_grpBtnBonus.setMovingEnvelope(_ptGrp[1].x, _ptGrp[1].y, _ptGrp[1].x, _ptGrp[1].y+32, 2);
		_grpBtnBonus.setBlendingEnvelope(0);
		_grpBtnBonus.beginActivation(300);
	}

	function endCancel(){
		//startMovingBg(0, 0, 500);
	}

	function hitThresholdSelectItems(threshold){
		for(var i=0;i<BTN_LIST.count;i++)
			this[BTN_LIST[i].id].hitThreshold = threshold;
	}
}

class EndScene extends Sprite, SceneBase{
	var _timer;
	var _voice;
	var _fPlay;

	function EndScene(win, par){
		Sprite(...);
		absolute = LAYER_END;

		var img = new global.Layer(win, this);
		img.loadImages("ui_1920/FRM_0501.png");
		img.setSizeToImageSize();
		setImageSize(WINDOW_WIDTH, WINDOW_HEIGHT);
		stretchCopy(0, 0, WINDOW_WIDTH, WINDOW_HEIGHT, img, 0, 0, img.width, img.height, stFastLinear);
		setSize(WINDOW_WIDTH, WINDOW_HEIGHT);
		invalidate img;

		opacity = 0;
		setBlendingEnvelope(255);
		beginActivation(300);
		visible = true;

		_timer = new Timer(callback, "");

		StopVoice(2000);
		StopEnvSe(, 2000);
		StopBgm(2000);
		StopSystemSound();

		var file = "";
		if(!CONFIG.muteSystem)
			file = PlaySystemVoice("ゲーム終了", false);

		_fPlay = false;
		if(file != ""){
			var head = file.substring(0, 2);
			_voice = new WaveSoundBuffer(this);
			_voice.open(file + ".ogg");
			with(_voice){
				var personalVol = CONFIG.voiceDetails[VCID_TO_INDEX[head]].volumeSyv;
				.volume2 = CONFIG.volSystem * personalVol * 100000;
				.volume = CONFIG.volMaster * 100000;
			}
			_voice.play();
			_fPlay = true;
		}else{
			_timer.interval = 3000;
			_timer.enabled = true;
		}

		setMode();

		win.addInputNotify(this);
	}
	function finalize(){
		_timer.enabled = false;
		invalidate _timer;
		invalidate _voice;

		win.removeInputNotify(this);
		global.Sprite.finalize();
	}

	function callback(){
		_timer.enabled = false;

		if(!valid) return;

		game.shutdown();
	}

	function action(ev){
		if(_fPlay && ev.target == _voice){
			_timer.interval = 2000;
			_timer.enabled = true;
		}
	}

	function onKeyDown(){
		close();
	}
	function onMouseDown(){
		close();
	}

	function close(){
		if(!valid) return;

		stopActivation();
		_timer.enabled = false;
		game.shutdown();
		valid = false;
	}
}
