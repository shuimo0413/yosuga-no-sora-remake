
class MovieLayer extends VideoOverlay{
	var _owner;
	var _layer;
	var _window;
	var _native = false;
	// Phase machine:
	// 0=idle, 1=opening (only open-init stop filtered), 2=play_requested, 3=running, 4=stopping
	var _phase = 0;
	var _instanceId = 0;
	var _openStopIgnored = false;
	var _terminal = false;
	var _stopDone = false;
	var _ownerDetached = false;
	var _finalizeDone = false;
	var _playGeneration = 0;
	function MovieLayer(win, par, fFullscreen=false){
		super.VideoOverlay(...);
		_window = win;

		_layer = new Layer(...);
		with(_layer){
			if(fFullscreen){
				.setSize(WINDOW_WIDTH, WINDOW_HEIGHT);
				.setPos(0, 0);
			}else{
				.setSize(800, 600);
				.setPos((WINDOW_WIDTH-.width)/2, (WINDOW_HEIGHT-.height)/2);
			}
			.type = ltOpaque;
			.hitThreshold = 256;
			.absolute = LAYER_MOVIE;
			.visible = true;
		}

		mode = vomLayer;
		layer1 = _layer;
		_owner = null;
		_phase = 0;
		_instanceId = 0;
		_openStopIgnored = false;
		_terminal = false;
		_stopDone = false;
		_ownerDetached = false;
		_finalizeDone = false;
		_playGeneration = 0;
		_window.addInputNotify(this);
	}
	function finalize(){
		if(_finalizeDone) return;
		_finalizeDone = true;
		_terminal = true;
		try{ _window.removeInputNotify(this); }catch(e){}
		detachOwner();
		try{ super.finalize(); }catch(eSuper){ Debug.message("Movie finalize failed: " + eSuper); }
		try{ invalidate _layer; }catch(eLayer){}
	}

	function syncNativeBounds(){
		if(!_native || _window === void || _window === null) return;
		// VideoOverlay bounds use the engine's logical primary-layer coordinates;
		// the window applies its own zoom to native child windows.
		setBounds(
			_window.baseLayer.left + _layer.left,
			_window.baseLayer.top + _layer.top,
			_layer.width,
			_layer.height
		);
	}
	function action(ev){
		if(ev.type == "onMoveSizeEnd" || ev.type == "onChangeScreenMode" || ev.type == "onActivate")
			syncNativeBounds();
	}
	// MainWindow dispatches concrete input methods to every registered observer.
	function onKeyDown(key, shift){ return 0; }
	function onKeyUp(key, shift){ return 0; }
	function onMouseWheel(shift, delta, x, y){ return 0; }
	function onMouseMove(x, y, shift){ return 0; }
	function onMouseDown(x, y, button, shift){ return 0; }
	function onMouseUp(x, y, button, shift){ return 0; }
	function detachOwner(){
		if(_ownerDetached) return;
		_ownerDetached = true;
		_owner = null;
	}
	function markTerminal(){
		_terminal = true;
		if(_phase < 4) _phase = 4;
	}
	function stopOnce(){
		if(_stopDone) return;
		_stopDone = true;
		markTerminal();
		try{ stop(); }catch(eStop){ Debug.message("Movie stop failed: " + eStop); }
	}
	function requestStop(){
		markTerminal();
		detachOwner();
		stopOnce();
	}

	function start(file, owner=null){
		_owner = owner;
		_ownerDetached = false;
		_terminal = false;
		_stopDone = false;
		var platform = System.platformName;
		var isWindows = platform == "Win32" || platform == "Win64";
		var isMacOS = platform == "Mac OS X" || platform == "macOS";
		var isAndroid = platform == "Android";
		var useNativeVideo = false;
		var nativeVideoMode = vomLayer;
		var nativeBackendName = "";

		if((isWindows || isMacOS || isAndroid) &&
			Storages.isExistentStorage(file + ".mp4")){
			file += ".mp4";
			useNativeVideo = true;
			if(isWindows){
				nativeVideoMode = vomMFEVR;
				nativeBackendName = "Windows Media Foundation";
			}else if(isMacOS){
				nativeVideoMode = vomOverlay;
				nativeBackendName = "macOS AVPlayer";
			}else{
				nativeVideoMode = vomOverlay;
				nativeBackendName = "Android MediaPlayer";
			}
		}else if(Storages.isExistentStorage(file + ".mp4")){
            file += ".mp4";
            useNativeVideo = true;
		    nativeVideoMode = vomOverlay;
		    nativeBackendName = "SDL ffmpeg overlay";
		}else if(Storages.isExistentStorage(file + ".mpg"))
			file += ".mpg";
		else if(Storages.isExistentStorage(file + ".wmv"))
			file += ".wmv";
		else if(Storages.isExistentStorage(file + ".flv"))
			file += ".flv";
		else{
			Debug.message("Movie playback failed: storage not found: " + file);
			markTerminal();
			return false;
		}

		try{
			_instanceId++;
			var myId = _instanceId;
			_openStopIgnored = false;
			_phase = 1;
			if(useNativeVideo){
				_native = true;
				mode = nativeVideoMode;
				layer1 = null;
				syncNativeBounds();
				visible = true;
				Debug.message(
					"Movie: " + nativeBackendName +
					" backend: " + file);
			}else{
				_native = false;
				mode = vomLayer;
				layer1 = _layer;
			}

			open(file);
			if(_instanceId != myId || _terminal) return false;

			if(numberOfAudioStream > 0){
				if(CONFIG.muteMaster == 1 || CONFIG.muteMovie == 1)
					audioVolume = 0;
				else
					audioVolume = int(100000 * CONFIG.volMaster * CONFIG.volMovie);
			}
			pause = true;
			_phase = 2;
			play();
			if(_instanceId != myId || _terminal) return false;
			pause = false;
			if(_phase == 2) _phase = 3;
			return !_terminal && _phase == 3;
		}catch(e){
			markTerminal();
			Debug.message("Movie playback failed: " + file + ": " + e);
			stopOnce();
			detachOwner();
			return false;
		}
	}
	function onStatusChanged(status){
		// open() can emit an initialization stop while it is still running.
		// Filter only that phase: SetStatus(play) cancels older queued events,
		// so the first stop seen after playback starts can be the real end.
		if(status == "stop" && _phase == 1 && !_openStopIgnored){
			_openStopIgnored = true;
			Debug.message("Movie: ignored open-init stop instance=" + _instanceId);
			return;
		}
		if(_terminal) return;
		if(_playGeneration != 0 && _playGeneration != MOVIE_GENERATION){
			markTerminal();
			return;
		}
		if(status == "stop") markTerminal();
		if(_owner != null){
			if(!isvalid _owner){ detachOwner(); return; }
			var elm = %[];
			elm.type = "Movie.onStatusChanged";
			elm.status = status;
			elm.target = this;
			elm.instanceId = _instanceId;
			elm.phase = _phase;
			elm.generation = _playGeneration;
			_owner.action(elm);
		}
	}
}
var MOVIE_OBJECT = null;
var MOVIE_PENDING = null;
var MOVIE_STOPPING = false;
var MOVIE_GENERATION = 0;
function IsFullscreenMovie(file){
	var name = string(file).toLowerCase();
	return name == "yosugacn" || name.indexOf("staff_roll") == 0;
}
function DisposeMovieInstance(movie, pending=false){
	if(movie === void || movie === null) return;
	try{ if(isvalid movie) movie.requestStop(); }catch(eStop){ Debug.message("Movie requestStop failed: " + eStop); }
	if(!pending){
		try{ if(isvalid movie) invalidate movie; }catch(eInv){ Debug.message("Movie cleanup failed: " + eInv); }
	}
}
function PlayMovie(file, owner=null){
	if(MOVIE_OBJECT != null || MOVIE_PENDING != null) StopMovie();

	MOVIE_GENERATION++;
	var gen = MOVIE_GENERATION;
	var movie = new MovieLayer(win, win.baseLayer, IsFullscreenMovie(file));
	movie._playGeneration = gen;
	MOVIE_PENDING = movie;
	var started = movie.start(file, owner);
	if(MOVIE_PENDING === movie) MOVIE_PENDING = null;
	if(!started || !isvalid movie || movie._terminal || movie._phase != 3 || gen != MOVIE_GENERATION){
		DisposeMovieInstance(movie, false);
		return false;
	}
	MOVIE_OBJECT = movie;
	return true;
}
function StopMovie(){
	if(MOVIE_STOPPING) return;
	var pending = MOVIE_PENDING;
	var active = MOVIE_OBJECT;
	if(pending === null && active === null) return;

	MOVIE_STOPPING = true;
	MOVIE_PENDING = null;
	MOVIE_OBJECT = null;
	if(pending !== null) DisposeMovieInstance(pending, true);
	if(active !== null && active !== pending) DisposeMovieInstance(active, false);
	MOVIE_STOPPING = false;
}
function IsPlayMovie(){
	return (MOVIE_OBJECT != null && isvalid MOVIE_OBJECT && !MOVIE_OBJECT._terminal && MOVIE_OBJECT._phase == 3);
}
