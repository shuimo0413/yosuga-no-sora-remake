/*
	システム変数クラス
*/

class SystemRegister{
	var _file;			//セーブするファイル名

	//セーブされる情報
	var _newSaveNo;		//最新セーブ番号
	var _autoSave;		//オートセーブの有無
	var _readFlag;		//既読フラグ
	var _cgFlag;		//CＧフラグ
	var _globalFlag;	//広域フラグ
	var _config;		//コンフィグ設定

	//ゲームの一時的な状態を保存

	//CGモード
	var _cgModeShowPreview;

	//回想復帰用
	var _recollectChar;	//キャラ番号
	var _recollectPage;	//ページ番号
	var _recollectBtn;	//ボタンID

	//ロードセーブ画面を閉じたときのページ位置
	var _closeSaveMenuIndex;

	//コンフィグを閉じた時のページ
	var _closeConfigPage;

	var DEFINE_PARAM = [
		["muteMaster", 0], 
		["volMaster", 1.0], 
		["muteBgm", 0], 
		["volBgm", 0.5], 
		["muteSe", 0], 
		["volSe", 0.7], 
		["muteEnvSe", 0], 
		["volEnvSe", 0.7], 
		["muteVoice", 0], 
		["volVoice", 1.0], 
		["muteSystem", 0], 
		["volSystem", 1.0], 
		["muteMovie", 0], 
		["volMovie", 1.0], 
		["muteBgv", 0], 
		["volBgv", 1.0], 
		["muteSyv", 0], 
		["volSyv", 1.0], 

		["screenModeKeep", 1], 				//前回終了時の画面設定を保持する

		["fullScreen", 1], 					//フルスクリーン

		["windowZoom", WINDOW_ZOOM_PER], 	//ウィンドウ拡大率
		["windowRatio", WINDOWRATIO_16X9], 	//ウィンドウ比率

		["screenEffect", 1], 				//画面効果
											//[0:なし 1:通常]
		["screenEffectSpeed", 1.0], 		//演出速度(1.0で通常)

		["screenEffectSpeedSys", 1.0], 		//システム演出速度(1.0で通常)

		["windowDepth", 50], 
		["portraitVisible", 1], 				// 人物头像显示 [0:隐藏 1:显示]
		["messageSpeed", 5], 

		["readSkip", 1], 					//既読スキップ
											//[0:全て 1:既読のみ]
		["readMessColor", 1], 				//既読メッセージの文字色変更
											//[0:しない 1:する]

		["lockSkip", 0], 					//選択肢後のスキップ解除
											//[0:解除 1:固定]
		["lockAuto", 0], 					//選択肢後のオート
											//[0:解除 1:固定]

		["eventCamera", 1], 				//イベントCＧのカメラワーク
											//[0:無効 1:有効]

		["messageFlushOnClick", 1], 		//メッセージ出力中のクリック動作
											//[0:次のメッセージに進む 1:メッセージの出力を完了させる]

		["voiceStopOnClick", 0], 			//クリック時の音声制御
											//[0:再生 1:停止]

		["autoSpeed", 5000], 				//オート待機時間(ミリ秒)

		["mouseTracking", 1], 				//マウスカーソルの自動追尾
											//[0:しない 1:する]

		["triggerCounterShow", 1], 			//射精カウンター

		["echoVoice", 1], 					//エコーボイス切り替え
											//[0:しない 1:する]

		["selectFix", 0], 					//選択固定オプション
											//[0:固定無し 1以降:固定]

		["selectFix_finish1", 0], 			//選択固定オプション
											//[0:口内 1:顔射]
		["selectFix_finish2", 0], 			//選択固定オプション
											//[0:中出し 1:外出し]

		["routeGuide", 1], 					//ルートガイド
											//[0:表示しない 1:表示する]

		["fontType", 0], 					//フォントタイプ

		["systemMenuLock", 1], 				//システムメニューの表示固定

		//確認ダイアログ
		["confirmWindow", [
			1, // CONFIRM_OVERWRITE
			1, // CONFIRM_LOAD
			1, // CONFIRM_END
			1, // CONFIRM_TITLE
			1, // CONFIRM_DEFAULT
			1, // CONFIRM_CLEARREADFLAG
			1, // CONFIRM_SELECTJUMP
			1, // CONFIRM_COPY
			1, // CONFIRM_MOVE
			1, // CONFIRM_SWAP
			1, // CONFIRM_DELETE
			1  // CONFIRM_LOGJUMP
		]], 

		//個別音声設定（ここはゲーム毎に編集が必要）
		["voiceDetails", [
			//音声, 環境音声, システム音声
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:1, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0], 
			%[mute:0, volume:1.0, muteBgv:0, volumeBgv:1.0, muteSyv:0, volumeSyv:1.0]
		]], 

		//システム音声設定
		["systemVoice", 0], 

		//デバック用パラメータ
		["debugVisible", true], 
		["debugX", 0], 
		["debugY", 0], 
		["debugJump", "チュートリアル"], 
		["debugSearch", ""], 
		["debugEditerPath", ""], 
		["debugBuCenter", 0], 
		["debugSupExp", 1]
	];

	function SystemRegister(file){

		_file = file;

		_readFlag = new Flag(READ_FLAG_MAX);
		_cgFlag = new Flag(CG_FLAG_MAX);
		_globalFlag = new Flag(GLOBAL_FLAG_MAX);

		initialize();
		if(Storages.isExistentStorage(DATA_PATH + file)){
			load(file);
		}else{
			save(file);
		}

		_cgModeShowPreview = 1;

		_recollectChar = 0;
		_recollectPage = 0;
		_recollectBtn = 0;

		if(_newSaveNo != -1)
			_closeSaveMenuIndex = (_newSaveNo-1)\SAVEDATA_PAGE_NUM;
		else
			_closeSaveMenuIndex = 0;

		_closeConfigPage = 0;
	}
	function finalize(){
		invalidate _readFlag;
		invalidate _cgFlag;
		invalidate _globalFlag;
		invalidate _config;
	}

	function initialize(){
		_newSaveNo = -1;
		_autoSave = 0;

		clearReadFlag();
		clearCgFlag();
		clearGlobalFlag();

		_config = %[];

		initConfig();
	}

	function setDefaultConfigParam(tag, value){
		var atrb = typeof value;
		if(atrb == "Object"){
			if(typeof value.count == "undefined"){
			//これはDictionary
				_config[tag] = %[];
				(Dictionary.assignStruct incontextof _config[tag])(value);
			}else{
			//これはArray
				_config[tag] = [];
				_config[tag].assignStruct(value);
			}
		}else{
			_config[tag] = value;
		}
	}

	function initConfig(){
		for(var i=0;i<DEFINE_PARAM.count;i++)
			setDefaultConfigParam(DEFINE_PARAM[i][0], DEFINE_PARAM[i][1]);
	}

	function load(file=""){
		if(file == "") file = _file;

		var temp = Scripts.evalStorage(DATA_PATH + file);
		_newSaveNo = temp[0];
		with(temp[1]){
			_readFlag.create(.readFlagNum);
			_readFlag.object().assign(.readFlagObj);
			_cgFlag.create(.cgFlagNum);
			_cgFlag.object().assign(.cgFlagObj);
			_globalFlag.create(.globalFlagNum);
			_globalFlag.object().assign(.globalFlagObj);
		}

		(Dictionary.assign incontextof _config)(temp[2]);
		//コンフィグの内容チェック
		for(var i=0;i<DEFINE_PARAM.count;i++){
			//定義タグが存在しない場合はデフォルト値を設定する
			if(_config[DEFINE_PARAM[i][0]] === void)
				setDefaultConfigParam(DEFINE_PARAM[i][0], DEFINE_PARAM[i][1]);
		}
		_autoSave = temp[3];
	}
	function save(file=""){
		var temp = [];

		//[0] : 最新セーブ番号
		//[1] : 各グローバルフラグ
		//[2] : コンフィグ設定
		temp[0] = _newSaveNo;
		temp[1] = %[];
		with(temp[1]){
			.readFlagNum = _readFlag.length();
			.readFlagObj = _readFlag.object();
			.cgFlagNum = _cgFlag.length();
			.cgFlagObj = _cgFlag.object();
			.globalFlagNum = _globalFlag.length();
			.globalFlagObj = _globalFlag.object();
		}
		temp[2] = _config;
		temp[3] = _autoSave;

		if(file == "") file = _file;

		@if(__FILE_CRYPT__ == 0)
			temp.saveStruct(DATA_PATH + file);
		@endif
		@if(__FILE_CRYPT__ == 1)
			// krkrsdl2 may write a stale compressed-size field for saveStruct
			// data. Windows then rejects the otherwise valid file with a
			// "Read error". The uncompressed structure format is understood
			// by both runtimes, so use it only on macOS.
			var savePlatform = System.platformName;
			var saveOnMacOS =
				savePlatform == "Mac OS X" || savePlatform == "macOS";
			if(saveOnMacOS)
				temp.saveStruct(DATA_PATH + file);
			else
				temp.saveStruct(DATA_PATH + file, "z");
		@endif
	}

	function clearReadFlag(){_readFlag.clear();}
	function clearCgFlag(){_cgFlag.clear();}
	function clearGlobalFlag(){_globalFlag.clear();}
}
SystemRegister.CONFIRM_OVERWRITE		= 0;
SystemRegister.CONFIRM_LOAD				= 1;
SystemRegister.CONFIRM_END				= 2;
SystemRegister.CONFIRM_TITLE			= 3;
SystemRegister.CONFIRM_DEFAULT			= 4;
SystemRegister.CONFIRM_CLEARREADFLAG	= 5;
SystemRegister.CONFIRM_SELECTJUMP		= 6;
SystemRegister.CONFIRM_COPY				= 7;
SystemRegister.CONFIRM_MOVE				= 8;
SystemRegister.CONFIRM_SWAP				= 9;
SystemRegister.CONFIRM_DELETE			= 10;
SystemRegister.CONFIRM_LOGJUMP			= 11;

SystemRegister.WINDOWRATIO_16X9		= 0;
SystemRegister.WINDOWRATIO_4X3		= 1;

class SaveDataManager{
	var _saveFile = "saveMan.json";
	var _manifestVersion = 1;
	var _obj = [];
	var _qsave;
	var _normalSaveNum = SAVEDATA_BOOK_MAX * SAVEDATA_PAGE_MAX * SAVEDATA_PAGE_NUM;

	function SaveDataManager(){
		_obj[0] = [];
		_obj[1] = %[index:0, stack:0, buf:[]];
		_obj[2] = [];

		_qsave = new RingBuffer(QSAVEDATA_MAX);

		if(!load()){
			init();
			save();
		}
	}
	function finalize(){
		if(!isvalid this) return;

		invalidate _qsave;
		InvalidateArray(_obj);
		invalidate _obj;
	}

	function createNormalSaveData(){
		return %[
			valid : false, 
			lock : false, 
			file : "", 
			gameDate : "", 
			realDate : "", 
			comment_edit : false, 
			comment : "", 
			root : 0
		];
	}
	function createQuickSaveData(){
		return %[valid:false, file:"", gameDate:"", realDate:"", comment:"", root:0];
	}
	function fillNormalSaveData(obj){
		if(obj === void) obj = createNormalSaveData();
		if(obj.valid === void) obj.valid = false;
		if(obj.lock === void) obj.lock = false;
		if(obj.file === void) obj.file = "";
		if(obj.gameDate === void) obj.gameDate = "";
		if(obj.realDate === void) obj.realDate = "";
		if(obj.comment_edit === void) obj.comment_edit = false;
		if(obj.comment === void) obj.comment = "";
		if(obj.root === void) obj.root = 0;
		obj.file = normalizeSaveFilename(obj.file);
		return obj;
	}
	function fillQuickSaveData(obj){
		if(obj === void) obj = createQuickSaveData();
		if(obj.valid === void) obj.valid = false;
		if(obj.file === void) obj.file = "";
		if(obj.gameDate === void) obj.gameDate = "";
		if(obj.realDate === void) obj.realDate = "";
		if(obj.comment === void) obj.comment = "";
		if(obj.root === void) obj.root = 0;
		obj.file = normalizeSaveFilename(obj.file);
		return obj;
	}
	function ensureNormalBook(book){
		if(_obj[0] === void) _obj[0] = [];
		if(_obj[0][book] === void)
			_obj[0][book] = %[bookname:"BOOK%02d".sprintf(book+1), pages:[]];
		if(_obj[0][book].bookname === void) _obj[0][book].bookname = "BOOK%02d".sprintf(book+1);
		if(_obj[0][book].pages === void) _obj[0][book].pages = [];
		return _obj[0][book];
	}
	function ensureNormalPage(book, page){
		var ref = ensureNormalBook(book);
		if(ref.pages[page] === void)
			ref.pages[page] = %[pagename:"PAGE%02d".sprintf(page+1), data:[]];
		if(ref.pages[page].pagename === void) ref.pages[page].pagename = "PAGE%02d".sprintf(page+1);
		if(ref.pages[page].data === void) ref.pages[page].data = [];
		return ref.pages[page];
	}
	function ensureNormalData(book, page, index){
		var ref = ensureNormalPage(book, page);
		if(ref.data[index] === void)
			ref.data[index] = createNormalSaveData();
		else
			fillNormalSaveData(ref.data[index]);
		return ref.data[index];
	}
	function normalizeNormal(){
		for(var book=0;book<SAVEDATA_BOOK_MAX;book++){
			for(var page=0;page<SAVEDATA_PAGE_MAX;page++){
				for(var index=0;index<SAVEDATA_PAGE_NUM;index++){
					ensureNormalData(book, page, index);
				}
			}
		}
	}
	function initNormal(){
		_obj[0] = [];
		normalizeNormal();
	}

	function init(){
		initNormal();
		_qsave.clear(createQuickSaveData());
		syncQSaveToObject();
		_obj[2][0] = fillQuickSaveData(%[]);
	}
	function normalizeLoadedObject(){
		if(_obj === void || typeof _obj != "Object") _obj = [];
		if(_obj[0] === void) _obj[0] = [];
		normalizeNormal();

		if(_obj[1] === void) _obj[1] = %[index:0, stack:0, buf:[]];
		if(_obj[1].index === void) _obj[1].index = 0;
		if(_obj[1].stack === void) _obj[1].stack = 0;
		if(_obj[1].buf === void) _obj[1].buf = [];
		for(var i=0;i<QSAVEDATA_MAX;i++)
			_obj[1].buf[i] = fillQuickSaveData(_obj[1].buf[i]);

		if(_obj[2] === void) _obj[2] = [];
		_obj[2][0] = fillQuickSaveData(_obj[2][0]);

		syncQSaveFromObject();
	}
	function syncQSaveFromObject(){
		_qsave.clear(createQuickSaveData());
		_qsave._index = int _obj[1].index;
		_qsave._stack = int _obj[1].stack;
		_qsave._buf.assign(_obj[1].buf);
		for(var i=0;i<QSAVEDATA_MAX;i++)
			_qsave._buf[i] = fillQuickSaveData(_qsave._buf[i]);
	}
	function syncQSaveToObject(){
		if(_obj[1] === void) _obj[1] = %[index:0, stack:0, buf:[]];
		_obj[1].index = _qsave._index;
		_obj[1].stack = _qsave._stack;
		_obj[1].buf = [];
		for(var i=0;i<QSAVEDATA_MAX;i++)
			_obj[1].buf[i] = fillQuickSaveData(_qsave._buf[i]);
	}

	function load(){
		return loadJsonManifest();
	}
	function loadJsonManifest(){
		if(!Storages.isExistentStorage(DATA_PATH + _saveFile)) return false;
		try{
			var manifest = Scripts.evalJSONStorage(DATA_PATH + _saveFile);
			importManifest(manifest);
			normalizeLoadedObject();
			return true;
		}catch(e){
			dm("SaveDataManager: native JSON failed, using TJS fallback: " + e);
			try{
				var text = readTextStorage(_saveFile);
				var manifest = parseJson(text);
				importManifest(manifest);
				normalizeLoadedObject();
				return true;
			}catch(e2){
				dm("SaveDataManager: failed to load JSON manifest: " + e2);
				return false;
			}
		}
	}
	function save(){
		syncQSaveToObject();
		saveJsonManifest();
	}
	function saveJsonManifest(){
		try{
			writeTextStorage(_saveFile, exportManifestJson());
			return true;
		}catch(e){
			dm("SaveDataManager: failed to save JSON manifest: " + e);
			return false;
		}
	}
	function readTextStorage(filename){
		var lines = [];
		lines.load(DATA_PATH + filename);
		var text = "";
		for(var i=0;i<lines.count;i++){
			if(i != 0) text += "\n";
			text += lines[i];
		}
		return text;
	}
	function writeTextStorage(filename, text){
		var lines = [text];
		lines.save(DATA_PATH + filename);
	}


	function importManifest(manifest){
		if(manifest === void || typeof manifest != "Object") throw "invalid manifest";
		_obj[0] = [];
		var normal = manifest.normal;
		if(normal !== void){
			for(var book=0;book<SAVEDATA_BOOK_MAX;book++){
				var srcBook = normal[book];
				var dstBook = ensureNormalBook(book);
				if(srcBook !== void && srcBook.bookname !== void) dstBook.bookname = srcBook.bookname;
				for(var page=0;page<SAVEDATA_PAGE_MAX;page++){
					var srcPage = (srcBook !== void && srcBook.pages !== void) ? srcBook.pages[page] : void;
					var dstPage = ensureNormalPage(book, page);
					if(srcPage !== void && srcPage.pagename !== void) dstPage.pagename = srcPage.pagename;
					for(var index=0;index<SAVEDATA_PAGE_NUM;index++){
						var srcData = (srcPage !== void && srcPage.data !== void) ? srcPage.data[index] : void;
						dstPage.data[index] = fillNormalSaveData(srcData);
					}
				}
			}
		}else{
			initNormal();
		}

		_obj[1] = %[index:0, stack:0, buf:[]];
		if(manifest.qsave !== void){
			if(manifest.qsave.index !== void) _obj[1].index = int manifest.qsave.index;
			if(manifest.qsave.stack !== void) _obj[1].stack = int manifest.qsave.stack;
			if(manifest.qsave.buf !== void){
				for(var i=0;i<QSAVEDATA_MAX;i++)
					_obj[1].buf[i] = fillQuickSaveData(manifest.qsave.buf[i]);
			}
		}

		_obj[2] = [];
		_obj[2][0] = fillQuickSaveData(manifest.asave);
	}
	function exportManifestJson(){
		var text = "{\r\n";
		text += "  \"format\": \"yosuga-save-manifest\",\r\n";
		text += "  \"version\": " + _manifestVersion + ",\r\n";
		text += "  \"normal\": [\r\n";
		for(var book=0;book<SAVEDATA_BOOK_MAX;book++){
			var bookRef = ensureNormalBook(book);
			text += "    {\r\n";
			text += "      \"bookname\": " + jsonQuote(bookRef.bookname) + ",\r\n";
			text += "      \"pages\": [\r\n";
			for(var page=0;page<SAVEDATA_PAGE_MAX;page++){
				var pageRef = ensureNormalPage(book, page);
				text += "        {\r\n";
				text += "          \"pagename\": " + jsonQuote(pageRef.pagename) + ",\r\n";
				text += "          \"data\": [\r\n";
				for(var index=0;index<SAVEDATA_PAGE_NUM;index++){
					text += jsonNormalSaveData(ensureNormalData(book, page, index), "            ");
					if(index != SAVEDATA_PAGE_NUM-1) text += ",";
					text += "\r\n";
				}
				text += "          ]\r\n";
				text += "        }";
				if(page != SAVEDATA_PAGE_MAX-1) text += ",";
				text += "\r\n";
			}
			text += "      ]\r\n";
			text += "    }";
			if(book != SAVEDATA_BOOK_MAX-1) text += ",";
			text += "\r\n";
		}
		text += "  ],\r\n";
		text += "  \"qsave\": {\r\n";
		text += "    \"index\": " + _qsave._index + ",\r\n";
		text += "    \"stack\": " + _qsave._stack + ",\r\n";
		text += "    \"buf\": [\r\n";
		for(var i=0;i<QSAVEDATA_MAX;i++){
			text += jsonQuickSaveData(fillQuickSaveData(_qsave._buf[i]), "      ");
			if(i != QSAVEDATA_MAX-1) text += ",";
			text += "\r\n";
		}
		text += "    ]\r\n";
		text += "  },\r\n";
		text += "  \"asave\": " + jsonQuickSaveData(fillQuickSaveData(_obj[2][0]), "  ") + "\r\n";
		text += "}\r\n";
		return text;
	}
	function jsonNormalSaveData(obj, indent){
		obj = fillNormalSaveData(obj);
		var text = indent + "{\r\n";
		text += indent + "  \"valid\": " + jsonBool(obj.valid) + ",\r\n";
		text += indent + "  \"lock\": " + jsonBool(obj.lock) + ",\r\n";
		text += indent + "  \"file\": " + jsonQuote(obj.file) + ",\r\n";
		text += indent + "  \"gameDate\": " + jsonQuote(obj.gameDate) + ",\r\n";
		text += indent + "  \"realDate\": " + jsonQuote(obj.realDate) + ",\r\n";
		text += indent + "  \"comment_edit\": " + jsonBool(obj.comment_edit) + ",\r\n";
		text += indent + "  \"comment\": " + jsonQuote(obj.comment) + ",\r\n";
		text += indent + "  \"root\": " + int obj.root + "\r\n";
		text += indent + "}";
		return text;
	}
	function jsonQuickSaveData(obj, indent){
		obj = fillQuickSaveData(obj);
		var text = indent + "{\r\n";
		text += indent + "  \"valid\": " + jsonBool(obj.valid) + ",\r\n";
		text += indent + "  \"file\": " + jsonQuote(obj.file) + ",\r\n";
		text += indent + "  \"gameDate\": " + jsonQuote(obj.gameDate) + ",\r\n";
		text += indent + "  \"realDate\": " + jsonQuote(obj.realDate) + ",\r\n";
		text += indent + "  \"comment\": " + jsonQuote(obj.comment) + ",\r\n";
		text += indent + "  \"root\": " + int obj.root + "\r\n";
		text += indent + "}";
		return text;
	}
	function jsonBool(value){
		return value ? "true" : "false";
	}
	function jsonQuote(value){
		if(value === void) value = "";
		value = string value;
		var text = "\"";
		for(var i=0;i<value.length;i++){
			var ch = value[i];
			if(ch == "\"") text += "\\\"";
			else if(ch == "\\") text += "\\\\";
			else if(ch == "\r") text += "\\r";
			else if(ch == "\n") text += "\\n";
			else if(ch == "\t") text += "\\t";
			else text += ch;
		}
		text += "\"";
		return text;
	}

	function parseJson(text){
		var reader = %[text:text, pos:0];
		var value = jsonParseValue(reader);
		jsonSkipSpace(reader);
		if(reader.pos < reader.text.length) throw "trailing JSON data";
		return value;
	}
	function jsonSkipSpace(reader){
		while(reader.pos < reader.text.length){
			var ch = reader.text[reader.pos];
			if(ch == " " || ch == "\t" || ch == "\r" || ch == "\n" || #ch == 65279)
				reader.pos++;
			else
				break;
		}
	}
	function jsonParseValue(reader){
		jsonSkipSpace(reader);
		if(reader.pos >= reader.text.length) throw "unexpected JSON end";
		var ch = reader.text[reader.pos];
		if(ch == "\"") return jsonParseString(reader);
		if(ch == "{") return jsonParseObject(reader);
		if(ch == "[") return jsonParseArray(reader);
		if(reader.text.substring(reader.pos, 4) == "true"){
			reader.pos += 4;
			return true;
		}
		if(reader.text.substring(reader.pos, 5) == "false"){
			reader.pos += 5;
			return false;
		}
		if(reader.text.substring(reader.pos, 4) == "null"){
			reader.pos += 4;
			return;
		}
		return jsonParseNumber(reader);
	}
	function jsonParseObject(reader){
		var obj = %[];
		reader.pos++;
		jsonSkipSpace(reader);
		if(reader.text[reader.pos] == "}"){
			reader.pos++;
			return obj;
		}
		while(reader.pos < reader.text.length){
			var key = jsonParseString(reader);
			jsonSkipSpace(reader);
			jsonExpect(reader, ":");
			obj[key] = jsonParseValue(reader);
			jsonSkipSpace(reader);
			if(reader.text[reader.pos] == ","){
				reader.pos++;
				jsonSkipSpace(reader);
				continue;
			}
			if(reader.text[reader.pos] == "}"){
				reader.pos++;
				return obj;
			}
			throw "invalid JSON object";
		}
		throw "unterminated JSON object";
	}
	function jsonParseArray(reader){
		var array = [];
		reader.pos++;
		jsonSkipSpace(reader);
		if(reader.text[reader.pos] == "]"){
			reader.pos++;
			return array;
		}
		while(reader.pos < reader.text.length){
			array.add(jsonParseValue(reader));
			jsonSkipSpace(reader);
			if(reader.text[reader.pos] == ","){
				reader.pos++;
				jsonSkipSpace(reader);
				continue;
			}
			if(reader.text[reader.pos] == "]"){
				reader.pos++;
				return array;
			}
			throw "invalid JSON array";
		}
		throw "unterminated JSON array";
	}
	function jsonParseString(reader){
		jsonExpect(reader, "\"");
		var text = "";
		while(reader.pos < reader.text.length){
			var ch = reader.text[reader.pos++];
			if(ch == "\"") return text;
			if(ch == "\\"){
				if(reader.pos >= reader.text.length) throw "unterminated JSON escape";
				var esc = reader.text[reader.pos++];
				if(esc == "\"") text += "\"";
				else if(esc == "\\") text += "\\";
				else if(esc == "/") text += "/";
				else if(esc == "b") text += "\b";
				else if(esc == "f") text += "\f";
				else if(esc == "n") text += "\n";
				else if(esc == "r") text += "\r";
				else if(esc == "t") text += "\t";
				else if(esc == "u"){
					text += "\\u" + reader.text.substring(reader.pos, 4);
					reader.pos += 4;
				}else{
					throw "invalid JSON escape";
				}
			}else{
				text += ch;
			}
		}
		throw "unterminated JSON string";
	}
	function jsonParseNumber(reader){
		var start = reader.pos;
		while(reader.pos < reader.text.length){
			var ch = reader.text[reader.pos];
			if(ch == "-" || ch == "+" || ch == "." || ch == "e" || ch == "E" || ("0" <= ch && ch <= "9"))
				reader.pos++;
			else
				break;
		}
		if(reader.pos == start) throw "invalid JSON value";
		var value = reader.text.substring(start, reader.pos - start);
		if(value.indexOf(".") != -1 || value.indexOf("e") != -1 || value.indexOf("E") != -1)
			return real value;
		return int value;
	}
	function jsonExpect(reader, expected){
		if(reader.pos >= reader.text.length || reader.text[reader.pos] != expected)
			throw "expected JSON token " + expected;
		reader.pos++;
	}

	function at(index=0){
		if(0 > index || index >= _normalSaveNum) return;

		var dic = getBookIndexFromIndex(index);

		return ensureNormalData(dic.book, dic.page, dic.index);
	}

	function atBook(book=0){
		if(0 > book || book >= SAVEDATA_BOOK_MAX) return;

		return ensureNormalBook(book);
	}
	function atPage(book=0, page=0){
		if(0 > book || book >= SAVEDATA_BOOK_MAX) return;
		if(0 > page || page >= SAVEDATA_PAGE_MAX) return;

		return ensureNormalPage(book, page);
	}

	function getBookIndexFromIndex(index){
		return %[
			 book : index \ SAVEDATA_PAGEDATA_MAX, 
			 page : (index % SAVEDATA_PAGEDATA_MAX) \ SAVEDATA_PAGE_NUM, 
			index : index % SAVEDATA_PAGE_NUM
		];
	}
	function getIndexFromBookIndex(book, page, index=0){
		return (book * SAVEDATA_PAGEDATA_MAX + page * SAVEDATA_PAGE_NUM + index);
	}

	function atQSave(index=0){
		return _qsave.get(index);
	}
	function qsaveIndex(){
		return _qsave.index;
	}
	function qsaveStack(){
		return _qsave.stack;
	}

	function atASave(){
		return _obj[2][0];
	}

	function setObj(obj, valid=true, file="", gameDate="", realDate="", comment="", root=0, comment_edit=false, lock=false){
		with(obj){
			.valid = valid;
			.lock = lock;
			.file = normalizeSaveFilename(file);
			.gameDate = gameDate;
			.realDate = realDate;
			.comment_edit = comment_edit;
			.comment = comment;
			.root = root;
		}
	}
	function set(index, file="", gameDate="", realDate="", comment="", root=0, comment_edit=false){
		if(0 > index || index >= _normalSaveNum) return false;

		var dic = getBookIndexFromIndex(index);
		setObj(ensureNormalData(dic.book, dic.page, dic.index), true, file, gameDate, realDate, comment, root, comment_edit, false);
		return true;
	}
	function setQSave(file="", gameDate="", realDate="", comment="", root=0){
		_qsave.add(%[valid:true, file:normalizeSaveFilename(file), gameDate:gameDate, realDate:realDate, comment:comment, root:root]);
	}
	function setASave(file="", gameDate="", realDate="", comment="", root=0, comment_edit=false){
		setObj(_obj[2][0], true, file, gameDate, realDate, comment, root, comment_edit, false);
	}

	function reset(index){
		if(0 > index || index >= _normalSaveNum) return false;

		var dic = getBookIndexFromIndex(index);
		setObj(ensureNormalData(dic.book, dic.page, dic.index), false, "", "", "", "", 0, false, false);
		return true;
	}
	function resetQSave(){
		_qsave.clear(createQuickSaveData());
	}
	function resetASave(){
		setObj(_obj[2][0], false, "", "", "", "", 0, false, false);
	}

	function normalizeSaveFilename(filename){
		if(filename === void) return "";
		if(filename == "") return "";
		if(filename.indexOf(DATA_PATH) == 0) return filename.substring(DATA_PATH.length);
		if(filename.indexOf("savedata/") == 0) return filename.substring(9);
		return filename;
	}
	function getSaveFilename(index){
		return "save" + "%02d_%03d.bmp".sprintf(index\SAVEDATA_PAGEDATA_MAX+1, index%SAVEDATA_PAGEDATA_MAX+1);
	}
	function isSaveFileExists(filename){
		filename = normalizeSaveFilename(filename);
		return (filename != "" && Storages.isExistentStorage(DATA_PATH + filename));
	}
	function deleteSaveFileUnless(filename, keepFilename=""){
		filename = normalizeSaveFilename(filename);
		keepFilename = normalizeSaveFilename(keepFilename);
		if(filename == "" || filename == keepFilename) return;
		if(Storages.isExistentStorage(DATA_PATH + filename))
			Storages.deleteFile(DATA_PATH + filename);
	}
	function resolveSlotFilename(index){
		if(0 > index || index >= _normalSaveNum) return "";

		var obj = at(index);
		var filename = normalizeSaveFilename(obj.file);
		if(isSaveFileExists(filename)) return filename;

		filename = getSaveFilename(index);
		if(isSaveFileExists(filename)) return filename;

		return normalizeSaveFilename(obj.file);
	}
	function cleanupSlotFiles(index, keepFilename=""){
		if(0 > index || index >= _normalSaveNum) return;

		var obj = at(index);
		deleteSaveFileUnless(obj.file, keepFilename);
		deleteSaveFileUnless(getSaveFilename(index), keepFilename);
	}

	function isLoadableSaveFile(filename){
		filename = normalizeSaveFilename(filename);
		if(!isSaveFileExists(filename)) return false;

		var img = new global.Layer(win, win.baseLayer);
		try{
			img.loadImages(DATA_PATH + filename);
			var temp = Scripts.evalStorage(DATA_PATH + filename, "o%d".sprintf(GetImageFileSize(img)));
			invalidate img;
			return (typeof temp[0] == "Object");
		}catch(e){
			dm("savedata verify failed: " + filename + ": " + e);
			invalidate img;
			return false;
		}
	}
	function copySaveFile(srcFilename, dstFilename){
		srcFilename = normalizeSaveFilename(srcFilename);
		dstFilename = normalizeSaveFilename(dstFilename);
		if(srcFilename == "" || dstFilename == "") return false;
		if(srcFilename == dstFilename) return isLoadableSaveFile(srcFilename);
		if(!isSaveFileExists(srcFilename)) return false;

		var srcPath = DATA_PATH + srcFilename;
		var dstPath = DATA_PATH + dstFilename;
		var img = new global.Layer(win, win.baseLayer);
		var copied = false;
		try{
			img.loadImages(srcPath);
			var temp = Scripts.evalStorage(srcPath, "o%d".sprintf(GetImageFileSize(img)));
			img.saveLayerImage(dstPath);
			temp.saveStruct(dstPath, "o%d".sprintf(GetImageFileSize(img)));
			copied = isLoadableSaveFile(dstFilename);
		}catch(e){
			dm("savedata copy failed: " + srcFilename + " -> " + dstFilename + ": " + e);
		}
		invalidate img;

		return copied;
	}

	function newestIndex(){
		var date = new Date();
		var array = [];
		for(var book=0;book<SAVEDATA_BOOK_MAX;book++){
			for(var page=0;page<SAVEDATA_PAGE_MAX;page++){
				for(var index=0;index<SAVEDATA_PAGE_NUM;index++){
					var obj = ensureNormalData(book, page, index);
					if(obj.valid){
						var buf = obj.realDate.split("_");
						date.parse(buf[0] + " " + buf[1]);
						array.add([date.getTime(), book * SAVEDATA_PAGEDATA_MAX + page * SAVEDATA_PAGE_NUM + index]);
					}
				}
			}
		}
		if(array.count == 0) return -1;
		if(array.count == 1) array[0][0];

		invalidate date;

		array.sort(function(a, b){return a[0] > b[0];}, true);

		return array[0][1];
	}

	function copy(srcIndex, dstIndex){
		if(srcIndex == dstIndex) return false;
		if(0 > srcIndex || srcIndex >= _normalSaveNum) return false;
		if(0 > dstIndex || dstIndex >= _normalSaveNum) return false;

		var srcObj = at(srcIndex);
		if(srcObj === void || !srcObj.valid) return false;

		var dstObj = at(dstIndex);
		if(dstObj === void || dstObj.lock) return false;

		var srcFilename = resolveSlotFilename(srcIndex);
		var dstFilename = getSaveFilename(dstIndex);
		var oldDstFilename = normalizeSaveFilename(dstObj.file);

		if(!copySaveFile(srcFilename, dstFilename)) return false;

		setObj(dstObj, true, dstFilename, srcObj.gameDate, srcObj.realDate, srcObj.comment, srcObj.root, srcObj.comment_edit, false);
		if(oldDstFilename != srcFilename)
			deleteSaveFileUnless(oldDstFilename, dstFilename);
		save();

		SetNewSaveNo(saveMan.newestIndex() + 1);
		SaveSystemRegister();
		return true;
	}
	function move(srcIndex, dstIndex){
		if(srcIndex == dstIndex) return false;
		if(0 > srcIndex || srcIndex >= _normalSaveNum) return false;
		if(0 > dstIndex || dstIndex >= _normalSaveNum) return false;

		var srcObj = at(srcIndex);
		if(srcObj === void || !srcObj.valid) return false;

		var dstObj = at(dstIndex);
		if(dstObj === void || dstObj.lock) return false;

		var srcFilename = resolveSlotFilename(srcIndex);
		var dstFilename = getSaveFilename(dstIndex);
		var oldDstFilename = normalizeSaveFilename(dstObj.file);
		var srcCanonicalFilename = getSaveFilename(srcIndex);

		var gameDate = srcObj.gameDate;
		var realDate = srcObj.realDate;
		var comment = srcObj.comment;
		var root = srcObj.root;
		var commentEdit = srcObj.comment_edit;

		if(!copySaveFile(srcFilename, dstFilename)) return false;

		setObj(dstObj, true, dstFilename, gameDate, realDate, comment, root, commentEdit, false);
		setObj(srcObj, false, "", "", "", "", 0, false, false);

		deleteSaveFileUnless(oldDstFilename, dstFilename);
		deleteSaveFileUnless(srcFilename, dstFilename);
		deleteSaveFileUnless(srcCanonicalFilename, dstFilename);

		save();

		if(GetNewSaveNo() == srcIndex + 1){
			SetNewSaveNo(dstIndex + 1);
			SaveSystemRegister();
		}else{
			SetNewSaveNo(saveMan.newestIndex() + 1);
			SaveSystemRegister();
		}
		return true;
	}

	function del(index){
		if(0 > index || index >= _normalSaveNum) return false;

		var obj = at(index);
		if(obj === void || !obj.valid) return false;

		var filename = resolveSlotFilename(index);
		setObj(obj, false, "", "", "", "", 0, false, false);
		deleteSaveFileUnless(filename);
		deleteSaveFileUnless(getSaveFilename(index));

		save();

		if(GetNewSaveNo() == index + 1){
			SetNewSaveNo(saveMan.newestIndex() + 1);
			SaveSystemRegister();
		}
		return true;
	}
}
var saveMan = new SaveDataManager();

function ParameterInit(param){
	param.clear();
}

//コンフィグの音声再生のチェック
function CheckPlayVoice(name){
	//マスターミュートならダメ
	if(CONFIG.muteMaster) return false;
	//音声ミュートならダメ
	if(CONFIG.muteVoice) return false;

	var ok = false;
	if(VCID_TO_INDEX[name] !== void){
		ok = CONFIG.voiceDetails[VCID_TO_INDEX[name]].mute==0;
	}else{
		ok = CONFIG.voiceDetails[VCID_TO_INDEX["NP"]].mute==0;
	}

	return ok;
}

//コンフィグの環境音声再生のチェック
function CheckPlayBgv(name){
	//マスターミュートならダメ
	if(CONFIG.muteMaster) return false;
	//音声ミュートならダメ
	if(CONFIG.muteBgv) return false;

	var ok = false;
	if(VCID_TO_INDEX[name] !== void){
		ok = CONFIG.voiceDetails[VCID_TO_INDEX[name]].muteBgv==0;
	}else{
		ok = CONFIG.voiceDetails[VCID_TO_INDEX["NP"]].muteBgv==0;
	}

	return ok;
}

//コンフィグのシステム音声再生のチェック
function CheckPlaySystemVoice(name){
	//マスターミュートならダメ
	if(CONFIG.muteMaster) return false;
	//音声ミュートならダメ
	if(CONFIG.muteSyv) return false;

	var ok = false;
	if(VCID_TO_INDEX[name] !== void){
		ok = CONFIG.voiceDetails[VCID_TO_INDEX[name]].muteSyv==0;
	}else{
		ok = CONFIG.voiceDetails[VCID_TO_INDEX["NP"]].muteSyv==0;
	}

	return ok;
}

//キャラクター情報の初期化
function CharDataInit(){
	var csv = new CSVParser();
	csv.initStorage("charData.csv");

	var head = csv.getNextLine();

	var elm;
	while((elm = csv.getNextLine()) !== void){
		if(elm[0].charAt(0) == "#") continue;
		var id = CHAR_DATA.count;
		CHAR_DATA[id] = %[];
		for(var i=0;i<head.count;i++){
			CHAR_DATA[id][head[i]] = elm[i];
		}
	}

	invalidate csv;

	for(var i=0;i<CHAR_DATA.count;i++){
		global[CHAR_DATA[i].id] = int CHAR_DATA[i].index;

		BUID_TO_INDEX[CHAR_DATA[i].buid] = int CHAR_DATA[i].index;
		VCID_TO_INDEX[CHAR_DATA[i].vcid] = int CHAR_DATA[i].index;

		if(CHAR_DATA[i].name.length)
			NAME_TO_INDEX[CHAR_DATA[i].name] = int CHAR_DATA[i].index;
	}
}

//シーン間のつなぎなどのフェードイン・アウトなどで利用しましょう
var SPR_COVER = null;
function CreateSprCover(){
	SPR_COVER = new Sprite(win, win.baseLayer);
	with(SPR_COVER){
		.setSize(WINDOW_WIDTH, WINDOW_HEIGHT);
		.hitThreshold = 256;
		.absolute = LAYER_COVER;
		.type = ltAlpha;
		.opacity = 255;
	}
}
function ResetSprCover(){
	if(SPR_COVER === null) return;

	invalidate SPR_COVER;
	SPR_COVER = null;
}

//現在選択されているフォントにサイズなどの情報を追加して返す
function GetFontFace(face){
	face = face.toUpperCase();

	switch(CONFIG.fontType){
	case 0 : face = "スーラ" + face; break;
	case 1 : face = "筑紫明朝" + face; break;
	case 2 : face = "ハミング" + face; break;
	case 3 : face = "ニューシネマ" + face; break;
	case 4 : face = "ロダンカトレア" + face; break;
	case 5 : face = "ロダンハッピー" + face; break;
	default : face = "スーラ" + face; break;
	}

	return face;
}

//==========================================================
//ラッパークラス
//==========================================================
function InitSystemRegister(){
	sysReg.initialize();
}
function GetNewSaveNo(){
	return sysReg._newSaveNo;
}
function SetNewSaveNo(v = -1){
	sysReg._newSaveNo = v;
}
function ChkAutoSave(){
	return sysReg._autoSave != 0;
}
function SetReadFlag(id, f){
	if(f)
		sysReg._readFlag.on(id);
	else
		sysReg._readFlag.off(id);
}
function ChkReadFlag(id){
	return sysReg._readFlag.check(id);
}
function SetCgFlag(id, f){
	if(f)
		sysReg._cgFlag.on(id);
	else
		sysReg._cgFlag.off(id);
}
function ChkCgFlag(id){
	return sysReg._cgFlag.check(id);
}
function SetGlobalFlag(id, f){
	if(f)
		sysReg._globalFlag.on(id);
	else
		sysReg._globalFlag.off(id);
}
function ChkGlobalFlag(id){
	return sysReg._globalFlag.check(id);
}
function ChkGlobalFlagOn(id){
	return sysReg._globalFlag.check(id);
}
function ChkGlobalFlagOff(id){
	return (sysReg._globalFlag.check(id) == false);
}
function IsGameClear(){
	return ChkGlobalFlagOn(1);
}

//==========================================================
//
//==========================================================
function GetConfigParam(id){
	if(sysReg._config[id] !== void)
		return sysReg._config[id];
}
function SetConfigParam(id, param){
	if(sysReg._config[id] !== void)
		return sysReg._config[id] = param;
}
function SaveSystemRegister(fDebugSave=true){
	if(fDebugSave){
		@if(__DEBUGMODE__)
			CONFIG.debugVisible = debug.visible;
			CONFIG.debugX = debug.left;
			CONFIG.debugY = debug.top;
			CONFIG.debugJump = debug.edtScenarioJump.text;
			CONFIG.debugSearch = debug.edtSearchSkip.text;
			CONFIG.debugBuCenter = debug.tglBuCenter.state;
			CONFIG.debugSupExp = debug.tglSupExp.state;
		@endif
	}
	sysReg.save();
}

function ReviceEffectSpeed(sSpeed){
	return int(sSpeed * sysReg._config.screenEffectSpeed);
}
function ReviceSystemSpeed(sSpeed){
	return ReviceEffectSpeed(...);
}


