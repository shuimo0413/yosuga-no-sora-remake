/*
	ゲームシーン管理クラス
*/

/* const */
var index = 0;
var SCENE_LOGO			= index++;
var SCENE_MOVIE			= index++;
var SCENE_TITLE			= index++;
var SCENE_ADV			= index++;
var SCENE_ALBUM			= index++;
var SCENE_MUSIC			= index++;
var SCENE_MEMORIES		= index++;
var SCENE_STAFFROLL		= index++;
var SCENE_END			= index++;
var SCENE_VOICE			= index++;
delete index;

class SceneBase extends InputNotifyBase{
	var _valid = true;

	function SceneBase(){}

	function action(ev){}

	function who(){return "SceneBase";}

	property valid{
		setter(v){_valid = v;}
		getter(){return _valid;}
	}
}

class SceneManager extends SceneBase{
	var _win;
	var _scene;
	var _nextScene;
	var _sceneObj;

	var _fExitGame;

	var _param;
	var _sceneChangeTimer;

	var _enableClose;
	var _sceneFailureNotified;

	function SceneManager(win){
		_win = win;

		_sceneObj = new Array();
		_scene = _nextScene = -1;

		_param = %[];

		_fExitGame = false;

		_sceneChangeTimer = new Timer(onWaitSceneChange, "");
		_sceneChangeTimer.interval = 100;
		_sceneChangeTimer.enabled = false;

		_enableClose = true;
		_sceneFailureNotified = false;

		_win.addInputNotify(this);
	}
	function finalize(){
		InvalidateArray(_sceneObj);

		invalidate _param;
		invalidate _sceneChangeTimer;
	}

	function who(){return "SceneManager";}

	function onCloseQuery(canclose){
		canclose = false;
		return canclose;
	}

	function beginSceneConstruction(){
		return _win.beginInputTransaction();
	}
	function commitSceneConstruction(transaction){
		try{ _win.commitInputTransaction(transaction); }catch(eCommit){
			Debug.message("=== input transaction commit failed: " + eCommit);
		}
	}
	function rollbackSceneConstruction(transaction){
		var objects = [];
		try{ objects = _win.rollbackInputTransaction(transaction); }catch(eRollback){
			Debug.message("=== input transaction rollback failed: " + eRollback);
		}
		for(var i = 0; i < objects.count; i++)
			disposeSceneObject(objects[i], false);
	}
	function terminateSceneFailure(message){
		if(_sceneFailureNotified) return false;
		_sceneFailureNotified = true;
		System.inform(message);
		System.terminate();
		return false;
	}
	function disposeSceneObject(obj, doClose){
		if(obj === void || obj === null) return;
		if(doClose){
			try{
				if(typeof obj.close != "undefined") obj.close();
			}catch(eClose){
				Debug.message("=== disposeSceneObject close failed: " + eClose);
			}
		}
		try{ _win.removeInputNotify(obj); }catch(eRem){
			Debug.message("=== disposeSceneObject removeInputNotify failed: " + eRem);
		}
		try{ invalidate obj; }catch(eInv){
			Debug.message("=== disposeSceneObject invalidate failed: " + eInv);
		}
	}
	function recoverInitialScene(failedScene, reason){
		Debug.message("=== Initial scene construction failed: scene=" + failedScene + " reason=" + reason);
		_nextScene = -1;
		_sceneChangeTimer.enabled = false;
		(Dictionary.clear incontextof _param)();
		_scene = -1;

		// Initial non-Title failure gets exactly one isolated Title fallback attempt.
		if(failedScene != SCENE_TITLE){
			var fallbackTransaction = beginSceneConstruction();
			var fallback = null;
			try{
				fallback = createSceneObject(SCENE_TITLE);
			}catch(eFallback){
				Debug.message("=== Initial title fallback exception: " + eFallback);
				fallback = null;
			}
			if(fallback !== void && fallback !== null){
				_scene = SCENE_TITLE;
				_sceneObj[SCENE_TITLE] = fallback;
				commitSceneConstruction(fallbackTransaction);
				Debug.message("=== Initial title fallback committed");
				return true;
			}
			rollbackSceneConstruction(fallbackTransaction);
		}

		Debug.message("=== Initial scene recovery exhausted; terminating");
		return terminateSceneFailure("场景初始化失败，程序将关闭。详细信息已写入日志。");
	}

	function changeScene(scene, sync=true, param=%[]){
		Debug.message("=== changeScene called: scene=" + scene + " _scene=" + _scene + " sync=" + sync + " param.scenario=" + param.scenario);

		(Dictionary.assign incontextof _param)(param);

		if(_scene == -1)
			return setScene(scene);

		if(sync == false){
			var oldIndex = _scene;
			var oldScene = _sceneObj[oldIndex];
			var newScene = null;
			var sceneTransaction = beginSceneConstruction();
			var oldInputDetached = false;

			if(oldScene !== void && oldScene !== null){
				try{
					_win.removeInputNotify(oldScene);
					oldInputDetached = true;
				}catch(eDetach){
					Debug.message("=== Error detaching old scene input before construct: " + eDetach);
				}
			}

			try{
				newScene = createSceneObject(scene);
			}catch(eCreate){
				Debug.message("=== Scene switch construction failed: scene=" + scene + " error=" + eCreate);
				newScene = null;
			}
			if(newScene === void || newScene === null){
				Debug.message("=== Scene switch construction returned empty: scene=" + scene);
				if(oldInputDetached && oldScene !== void && oldScene !== null){
					try{ _win.addInputNotify(oldScene); }catch(eRe){
						Debug.message("=== Error restoring old scene input after construct failure: " + eRe);
					}
				}
				rollbackSceneConstruction(sceneTransaction);
				(Dictionary.clear incontextof _param)();
				return false;
			}

			if(oldScene !== void && oldScene !== null){
				try{
					if(typeof oldScene.close != "undefined") oldScene.close();
				}catch(eClose){
					Debug.message("=== Error closing old scene method: " + eClose);
				}
				try{ _win.removeInputNotify(oldScene); }catch(eRem){
					Debug.message("=== Error removeInputNotify old scene: " + eRem);
				}
				try{ invalidate oldScene; }catch(eInv){
					Debug.message("=== Error invalidate old scene: " + eInv);
				}
				_sceneObj[oldIndex] = void;
			}

			_scene = scene;
			_sceneObj[scene] = newScene;
			(Dictionary.clear incontextof _param)();
			commitSceneConstruction(sceneTransaction);
			return true;
		}

		_nextScene = scene;
		_sceneChangeTimer.enabled = true;
		return true;
	}
	function getScene(scene){
		return _sceneObj[scene];
	}

	function createSceneObject(scene){
		var result = null;
		switch(scene){
		case SCENE_LOGO:
			result = new Logo(_win, _win.baseLayer);
			break;
		case SCENE_MOVIE:
			result = new MovieScene(_win, _win.baseLayer);
			break;
		case SCENE_TITLE:
			var subMenu = int GetElm(_param.submenu, 0);
			result = new Title(_win, _win.baseLayer, subMenu);
			break;
		case SCENE_ADV:
			var recollectParam = %[
				recollect : GetElm(_param.recollect, true, false),
				start : int GetElm(_param.recollectStart, 0),
				end : int GetElm(_param.recollectEnd, 0),
			];
			Debug.message(">>> Creating ADVScreen for scene " + scene);
			result = new ADVScreen(_win, LAYER_ADVSCREEN, LAYER_ADVMESSAGE, recollectParam);
			try{
				var label = "";
				if(_param.label !== void) label = _param.label;
				if(_param.scenario !== void)
					result.start(_param.scenario, label);
				else if(_param.debug !== void)
					result.debugStart(_param.debug, label);
				else if(_param.file !== void)
					result.load(_param.file);
			}catch(eAdvStart){
				Debug.message("=== ADV post-construct start/load failed: " + eAdvStart);
				disposeSceneObject(result, false);
				result = null;
				throw eAdvStart;
			}
			break;
		case SCENE_ALBUM:
			result = new AlbumModeScene(_win, _win.baseLayer);
			break;
		case SCENE_MUSIC:
			result = new MusicModeScene(_win, _win.baseLayer);
			break;
		case SCENE_MEMORIES:
			result = new MemoriesModeScene(_win, _win.baseLayer);
			break;
		case SCENE_STAFFROLL:
			var adv = null;
			if(game.getScene(SCENE_ADV) !== void) adv = game.getScene(SCENE_ADV);
			result = new StaffRollScene(_win, _win.baseLayer, adv);
			break;
		case SCENE_VOICE:
			result = new VoiceModeScene(_win, _win.baseLayer);
			break;
		case SCENE_END:
			result = new EndScene(_win, _win.baseLayer);
			break;
		}
		return result;
	}

	function setScene(scene){
		Debug.message("=== setScene called: scene=" + scene);
		System.doCompact(clIdle);
		var created = null;
		var sceneTransaction = beginSceneConstruction();
		try{
			created = createSceneObject(scene);
		}catch(e){
			Debug.message("=== Scene switch construction failed: scene=" + scene + " error=" + e);
			rollbackSceneConstruction(sceneTransaction);
			return recoverInitialScene(scene, e);
		}
		if(created === void || created === null){
			Debug.message("=== Scene switch construction returned empty: scene=" + scene);
			rollbackSceneConstruction(sceneTransaction);
			return recoverInitialScene(scene, "constructor returned empty");
		}
		_scene = scene;
		_sceneObj[scene] = created;
		(Dictionary.clear incontextof _param)();
		commitSceneConstruction(sceneTransaction);
		return true;
	}
	function recoverDeferredScene(current, target, reason){
		Debug.message("=== Deferred scene fallback: target=" + target + " reason=" + reason);
		_nextScene = -1;
		_sceneChangeTimer.enabled = false;

		var oldIndex = _scene;
		if(current !== void && current !== null)
			disposeSceneObject(current, false);
		if(oldIndex >= 0) _sceneObj[oldIndex] = void;
		(Dictionary.clear incontextof _param)();

		if(target != SCENE_TITLE){
			var fallbackTransaction = beginSceneConstruction();
			var fallback = null;
			try{
				fallback = createSceneObject(SCENE_TITLE);
			}catch(eFallback){
				Debug.message("=== Deferred title fallback failed: " + eFallback);
				fallback = null;
			}
			if(fallback !== void && fallback !== null){
				_scene = SCENE_TITLE;
				_sceneObj[SCENE_TITLE] = fallback;
				commitSceneConstruction(fallbackTransaction);
				return true;
			}
			rollbackSceneConstruction(fallbackTransaction);
		}

		_scene = -1;
		return terminateSceneFailure("场景加载失败，程序将关闭。详细信息已写入日志。");
	}
	function onWaitSceneChange(){
		var target = _nextScene;
		var current = null;
		if(_scene >= 0 && _sceneObj[_scene] !== void && _sceneObj[_scene] !== null)
			current = _sceneObj[_scene];

		if(current === null){
			_nextScene = -1;
			_sceneChangeTimer.enabled = false;
			if(target >= 0 && !setScene(target))
				recoverDeferredScene(null, target, "active scene missing and target construction failed");
			return;
		}
		if(current.valid != false) return;

		var sceneTransaction = beginSceneConstruction();
		var created = null;
		try{
			created = createSceneObject(target);
		}catch(e){
			Debug.message("=== Deferred scene construction failed: scene=" + target + " error=" + e);
			rollbackSceneConstruction(sceneTransaction);
			recoverDeferredScene(current, target, e);
			return;
		}
		if(created === void || created === null){
			Debug.message("=== Deferred scene construction returned empty: scene=" + target);
			rollbackSceneConstruction(sceneTransaction);
			recoverDeferredScene(current, target, "constructor returned empty");
			return;
		}

		var oldIndex = _scene;
		disposeSceneObject(current, false);
		_sceneObj[oldIndex] = void;
		_scene = target;
		_sceneObj[target] = created;
		_nextScene = -1;
		_sceneChangeTimer.enabled = false;
		(Dictionary.clear incontextof _param)();
		commitSceneConstruction(sceneTransaction);
	}
	function onKeyDown(key, shift, process=true){
		// @if(__DEBUGMODE__)
			// if(key == VK_F2){
				// switch(_scene){
				// case SCENE_LOGO :
