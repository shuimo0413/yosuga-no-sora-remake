// ADV / backlog 文本全局样式。
// 预渲染字体只有 12/24/30/36/48 档；50px 正文使用 48px 字形和
// 60px 行高，40px backlog 使用 36px 字形和 48px 行高。
var ADV_TEXT_STYLE = %[
	messageFontSize:50,
	messagePrerenderedSize:48,
	messageLineHeight:60,
	backlogFontSize:40,
	backlogPrerenderedSize:36,
	backlogLineHeight:48,
	unreadColor:0xFFFFFF,
	readColor:0xB8DDE7,
	shadowColor:0x165768,
	shadowLevel:3002,
	shadowWidth:1,
	messageShadowX:3,
	messageShadowY:3,
	backlogShadowX:2,
	backlogShadowY:2
];

var ADV_FONT_NAME_FACE = "30";		// 角色名（小说模式 fallback）
var ADV_FONT_NAME_SIZE = 30;
var ADV_FONT_MESS_SIZE = ADV_TEXT_STYLE.messageFontSize;
var ADV_FONT_MESS_INDENT = ADV_TEXT_STYLE.messageLineHeight;
function GetAdvFontMessFace(){
	return string ADV_TEXT_STYLE.messagePrerenderedSize;
}
var ADV_FONT_MESS_FACE = GetAdvFontMessFace();	// 由 SIZE 派生

function GetBacklogFontFace(){
	return string ADV_TEXT_STYLE.backlogPrerenderedSize;
}

function ApplyAdvTextDrawStyle(area, read=false){
	var color = read ? ADV_TEXT_STYLE.readColor : ADV_TEXT_STYLE.unreadColor;
	area.setDefaultDrawTextParam(
		color, 255, true,
		ADV_TEXT_STYLE.shadowLevel, ADV_TEXT_STYLE.shadowColor,
		ADV_TEXT_STYLE.shadowWidth,
		ADV_TEXT_STYLE.messageShadowX, ADV_TEXT_STYLE.messageShadowY);
	area.resetDrawTextParam();
}

function ApplyBacklogTextDrawStyle(area){
	area.setDefaultDrawTextParam(
		ADV_TEXT_STYLE.unreadColor, 255, true,
		ADV_TEXT_STYLE.shadowLevel, ADV_TEXT_STYLE.shadowColor,
		ADV_TEXT_STYLE.shadowWidth,
		ADV_TEXT_STYLE.backlogShadowX, ADV_TEXT_STYLE.backlogShadowY);
	area.resetDrawTextParam();
}

var SHORTCUT_MENU_FONT_FILE = "Xiaolai-Regular.ttf";
var SHORTCUT_MENU_FONT_FACE = null;
try{
	if(typeof global.Font == "Object" &&
		typeof global.Font.addFont == "Object" &&
		Storages.isExistentStorage(SHORTCUT_MENU_FONT_FILE)){
		var shortcutMenuFontFaces =
			global.Font.addFont(SHORTCUT_MENU_FONT_FILE);
		if(shortcutMenuFontFaces.count > 0)
			SHORTCUT_MENU_FONT_FACE = shortcutMenuFontFaces[0];
		invalidate shortcutMenuFontFaces;
	}
}catch(e){
	dm("Shortcut menu Xiaolai font fallback: " + e);
}

function GetShortcutMenuFontFace(){
	return SHORTCUT_MENU_FONT_FACE !== null ?
		SHORTCUT_MENU_FONT_FACE : FONT_DEFAULT_FACE;
}

function PaintMenuRoundedRect(
	layer, x, y, width, height, color, radius=8){
	if(radius <= 0){
		layer.fillRect(x, y, width, height, color);
		return;
	}
	if(radius * 2 > width) radius = width \ 2;
	if(radius * 2 > height) radius = height \ 2;

	var baseAlpha = (color >> 24) & 0xff;
	var rgb = color & 0x00ffffff;
	for(var row=0;row<height;row++){
		var boundary = 0;
		if(row < radius){
			var dy = radius - row - 0.5;
			boundary =
				radius - Math.sqrt(radius * radius - dy * dy);
		}else if(row >= height - radius){
			var edgeRow = height - 1 - row;
			var dy = radius - edgeRow - 0.5;
			boundary =
				radius - Math.sqrt(radius * radius - dy * dy);
		}

		var inset = int(boundary + 0.999);
		var span = width - inset * 2;
		if(span > 0)
			layer.fillRect(
				x + inset, y + row,
				span, 1, color);

		if(inset > 0){
			var coverage = inset - boundary;
			var edgeAlpha = int(baseAlpha * coverage);
			if(edgeAlpha > 0){
				var edgeColor = (edgeAlpha << 24) | rgb;
				layer.fillRect(
					x + inset - 1, y + row,
					1, 1, edgeColor);
				layer.fillRect(
					x + width - inset, y + row,
					1, 1, edgeColor);
			}
		}
	}
}

