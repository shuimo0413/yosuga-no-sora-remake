		["ui_1920/adv_menu/DHK-21.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 60 , 60]],
		["ui_1920/adv_menu/DHK-25.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 60 , 120]],
		["ui_1920/adv_menu/DHK-17.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 60 , 0]],
		["ui_1920/adv_menu/DHK-18.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 120 , 0]],
		["ui_1920/adv_menu/DHK-24.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 0 , 120]],
		["ui_1920/adv_menu/DHK-26.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 120, 120]],
		["ui_1920/adv_menu/DHK-19.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 180, 0]],
		["ui_1920/adv_menu/DHK-60.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X + 180, 120]],
		["ui_1920/adv_menu/DHK-16.png",  [12 + SYSTEM_MENU_BUTTON_OFFSET_X +  0, 0]],
	];
	var _hintTexts = [
		"快速保存",
		"快速读取",
		"保存存档",
		"读取存档",
		"系统设置",
		"自动模式",
		"快进模式",
		"文本记录",
		"锁定按钮",
		"下一选项",
		"返回主页",
		"上一选项",
	];


	var _qsaveMenu;
	var _saveMenu;
	var _loadMenu;
	var _configMenu;

	var _shortcutOpenTimer;
	var _shortcutCloseTimer;
	var _shortcutPendingButton = null;
	var _shortcutPendingMenu = null;
	var _shortcutOpenButton = null;
	var _shortcutOpenMenu = null;
	var SHORTCUT_OPEN_DELAY = 200;
	var SHORTCUT_CLOSE_DELAY = 300;

	var HIDE_OPACITY = 0;		// 菜单隐藏时透明度

	function SystemMenu(win, par, o=null, adv=null){
		SubMenu(win, par, o);
		_name = "SystemMenu";
		_adv = adv;
		_messageFrame = par;

		hasImage = false;

		setSize(1500,180);

		// 构造时把 480x40 图集等分成 12 个独立 40x40 图层；
		// 运行时只切换图层显隐，不移动源图或图像原点。
		_autoIndicatorSource = new global.Layer(win, this);
		with(_autoIndicatorSource){
			.loadImages(AUTO_INDICATOR_FILE);
			.setSizeToImageSize();
			.hitThreshold = 256;
			.visible = false;
		}
		_autoIndicator = new global.Layer(win, this);
		with(_autoIndicator){
			.hasImage = false;
			.setSize(AUTO_INDICATOR_FRAME_WIDTH, AUTO_INDICATOR_FRAME_HEIGHT);
			.setPos(AUTO_INDICATOR_X, AUTO_INDICATOR_Y);
			.hitThreshold = 256;
			.visible = false;
		}
		for(var i=0;i<AUTO_INDICATOR_FRAME_COUNT;i++){
			_autoIndicatorFrames[i] = new global.Layer(win, _autoIndicator);
			with(_autoIndicatorFrames[i]){
				.setImageSize(AUTO_INDICATOR_FRAME_WIDTH, AUTO_INDICATOR_FRAME_HEIGHT);
				.setSize(AUTO_INDICATOR_FRAME_WIDTH, AUTO_INDICATOR_FRAME_HEIGHT);
				.type = ltAlpha;
				.fillRect(0, 0,
					AUTO_INDICATOR_FRAME_WIDTH, AUTO_INDICATOR_FRAME_HEIGHT,
					0x00000000);
				.copyRect(
					0, 0, _autoIndicatorSource,
					AUTO_INDICATOR_FRAME_WIDTH * i, 0,
					AUTO_INDICATOR_FRAME_WIDTH, AUTO_INDICATOR_FRAME_HEIGHT);
				.setPos(0, 0);
				.hitThreshold = 256;
				.visible = false;
			}
		}
		setAutoIndicatorFrame(0);
		_autoIndicatorTimer = new Timer(onAutoIndicatorTimer, "");
		with(_autoIndicatorTimer){
			.interval = AUTO_INDICATOR_INTERVAL;
			.capacity = 1;
			.enabled = false;
		}

		var index = 0;
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		_btn[index] = new ToggleButton(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			._nNormalB = ._nFocusB = ._nInvalidB = 1;
			index++;
		}
		_btn[index] = new ToggleButton(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			._nNormalB = ._nFocusB = ._nInvalidB = 1;
			index++;
		}
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		_btn[index] = new ToggleButton(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}

		// 下一选项是普通按钮，不保留按下状态。
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		// 右下角返回标题按钮只有普通和悬浮两态。
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}
		// 上一选项是普通按钮，可根据选择栈状态禁用。
		_btn[index] = new Button(win, this);
		with(_btn[index]){
			.create(_files[index][0], 2);
			.setPos(_files[index][1][0], _files[index][1][1]);
			index++;
		}

		_qsaveMenu = new global.QuickSaveMenu(win, par, this);
		_qsaveMenu.join = JOIN_TOP;

		_saveMenu = new global.LoadShortcutMenu(win, par, this, true);
		_saveMenu.join = JOIN_TOP;

		_loadMenu = new global.LoadShortcutMenu(win, par, this, false);
		_loadMenu.join = JOIN_TOP;

		_configMenu = new ConfigSubMenu(win, par, this, _adv);
		_configMenu.join = JOIN_TOP;

		_shortcutOpenTimer = new Timer(onShortcutOpenTimer, "");
		with(_shortcutOpenTimer){
			.interval = SHORTCUT_OPEN_DELAY;
			.capacity = 1;
			.enabled = false;
		}
		_shortcutCloseTimer = new Timer(onShortcutCloseTimer, "");
		with(_shortcutCloseTimer){
			.interval = SHORTCUT_CLOSE_DELAY;
			.capacity = 1;
			.enabled = false;
		}

		addItem(_btn[0]);
		// 第二排的快捷浮窗由本类延时控制，避免鼠标向上经过时立即
		// 弹出并盖住第一排按钮。
		addItem(_btn[1]);
		addItem(_btn[2]);
		addItem(_btn[3]);
		addItem(_btn[4], _configMenu);
		addItem(_btn[5]);
		addItem(_btn[6]);
		addItem(_btn[7]);
		addItem(_btn[8]);
		// 前后选项按钮直接执行跳转，不绑定悬浮子菜单。
		addItem(_btn[9]);
		addItem(_btn[10]);
		addItem(_btn[11]);

		lock = (CONFIG.systemMenuLock != 0);

//		opacity = HIDE_OPACITY;
//		if(lock) opacity =255;
		opacity = 255;

		// ADVScreen 此时尚未初始化选择历史栈和参数，只设置安全的初始状态。
		refresh(false);
	}
	function finalize(){
		if(isvalid(_messageFrame)) _messageFrame.hideSystemMenuHint();
		cancelShortcutOpen();
		cancelShortcutClose();
		invalidate _shortcutOpenTimer;
		invalidate _shortcutCloseTimer;
		if(isvalid(_autoIndicatorTimer))
			_autoIndicatorTimer.enabled = false;
		invalidate _autoIndicatorTimer;
		InvalidateArray(_autoIndicatorFrames);
		invalidate _autoIndicatorFrames;
		invalidate _autoIndicator;
		invalidate _autoIndicatorSource;
		invalidate _qsaveMenu;
		invalidate _saveMenu;
		invalidate _loadMenu;
		invalidate _configMenu;
		_messageFrame = null;
		super.finalize();
	}

	function shortcutMenuForButton(target){
		switch(target){
		case _btn[1] : return _qsaveMenu;
		case _btn[2] : return _saveMenu;
		case _btn[3] : return _loadMenu;
		}
		return null;
	}

	function cancelShortcutOpen(){
		if(isvalid(_shortcutOpenTimer))
			_shortcutOpenTimer.enabled = false;
		_shortcutPendingButton = null;
		_shortcutPendingMenu = null;
	}

	function cancelShortcutClose(){
		if(isvalid(_shortcutCloseTimer))
			_shortcutCloseTimer.enabled = false;
	}

	function requestShortcutOpen(target, menu){
		if(menu === null || !isvalid(menu)) return;

		cancelShortcutOpen();
		if(_shortcutOpenMenu == menu){
			cancelShortcutClose();
			if(!menu.visible) menu.show(target);
			return;
		}

		_shortcutPendingButton = target;
		_shortcutPendingMenu = menu;
		with(_shortcutOpenTimer){
			.interval = SHORTCUT_OPEN_DELAY;
			.enabled = true;
		}
	}

	function requestShortcutClose(menu=null){
		if(_shortcutOpenMenu === null) return;
		if(menu !== null && menu != _shortcutOpenMenu) return;

		cancelShortcutClose();
		with(_shortcutCloseTimer){
			.interval = SHORTCUT_CLOSE_DELAY;
			.enabled = true;
		}
	}

	function closeShortcutMenu(){
		cancelShortcutClose();
		if(_shortcutOpenMenu !== null && isvalid(_shortcutOpenMenu)){
			_shortcutOpenMenu.hideSubMenu();
			_shortcutOpenMenu.hide();
		}
		_shortcutOpenButton = null;
		_shortcutOpenMenu = null;
	}
	function closeAllPopups(){
		// 同时清理延迟任务、状态引用和可见图层，避免关闭后又被计时器打开。
		cancelShortcutOpen();
		cancelShortcutClose();
		closeShortcutMenu();
		hideSubMenu();

		var menus = [
			_qsaveMenu, _saveMenu, _loadMenu, _configMenu
		];
		for(var i=0;i<menus.count;i++){
			if(!isvalid(menus[i])) continue;
			menus[i].hideSubMenu();
			menus[i].hide();
		}
		invalidate menus;

		if(isvalid(_messageFrame))
			_messageFrame.hideSystemMenuHint();
	}

	function onShortcutOpenTimer(){
		if(isvalid(_shortcutOpenTimer))
			_shortcutOpenTimer.enabled = false;

		var target = _shortcutPendingButton;
		var menu = _shortcutPendingMenu;
		_shortcutPendingButton = null;
		_shortcutPendingMenu = null;

		if(!_buttonsEnabled || target === null || menu === null) return;
		if(!isButtonEnter(target)) return;

		closeShortcutMenu();
		_shortcutOpenButton = target;
		_shortcutOpenMenu = menu;
		menu.show(target);
	}

	function onShortcutCloseTimer(){
		if(isvalid(_shortcutCloseTimer))
			_shortcutCloseTimer.enabled = false;
		closeShortcutMenu();
	}

	function onShortcutMenuEnter(menu){
		if(menu != _shortcutOpenMenu) return;
		cancelShortcutClose();
		if(isvalid(_messageFrame))
			_messageFrame.onSystemMenuPointerEnter();
	}

	function onShortcutMenuLeave(menu){
		if(menu != _shortcutOpenMenu) return;
		requestShortcutClose(menu);
		if(isvalid(_messageFrame))
			_messageFrame.onSystemMenuPointerLeave();
	}

	function setAutoIndicatorFrame(frame){
		if(frame < 0 || frame >= AUTO_INDICATOR_FRAME_COUNT) frame = 0;

		if(_autoIndicatorFrame >= 0 &&
			_autoIndicatorFrame < _autoIndicatorFrames.count &&
			isvalid(_autoIndicatorFrames[_autoIndicatorFrame])){
			_autoIndicatorFrames[_autoIndicatorFrame].visible = false;
		}
		_autoIndicatorFrame = frame;
		if(_autoIndicatorFrame < _autoIndicatorFrames.count &&
			isvalid(_autoIndicatorFrames[_autoIndicatorFrame])){
			_autoIndicatorFrames[_autoIndicatorFrame].visible = true;
		}
	}

	function syncAutoIndicator(){
		if(!isvalid(_autoIndicator) || !isvalid(_autoIndicatorTimer)) return;

		var active = _buttonsEnabled && _btn[5].state;
		if(active){
			if(!_autoIndicator.visible){
				setAutoIndicatorFrame(0);
				_autoIndicator.visible = true;
			}
			_autoIndicatorTimer.enabled = true;
		}else{
			_autoIndicatorTimer.enabled = false;
			_autoIndicator.visible = false;
			setAutoIndicatorFrame(0);
		}
	}

	function onAutoIndicatorTimer(){
		if(!_buttonsEnabled || !_btn[5].state || !isvalid(_autoIndicator)){
			syncAutoIndicator();
			return;
		}

		var nextFrame = _autoIndicatorFrame + 1;
		if(nextFrame >= AUTO_INDICATOR_FRAME_COUNT) nextFrame = 0;
		setAutoIndicatorFrame(nextFrame);
	}

	function refresh(refreshJump=true){
		_qsaveMenu.refresh();
		_saveMenu.refresh();
		_loadMenu.refresh();
		if(saveMan.qsaveStack()){
			addItem(_btn[1]);
			_btn[1].opacity = 255;
			_btn[1].valid = true;
		}else{
			removeItem(_btn[1]);
			_btn[1].opacity = 128;
			_btn[1].valid = false;
		}

		if(_adv.isRecollect()){
			for(var i=0;i<4;i++){
				_btn[i].opacity = 128;
				_btn[i].hitThreshold = 256;
				_btn[i].valid = false;
			}
			removeItem(_btn[1]);
		}

		if(refreshJump){
			refreshJumpButtons();
		}else{
			// 构造阶段还不能读取 ADVScreen 的选择状态。
			var nextValid = !_adv.isRecollect();
			_btn[11].valid = false;
			_btn[11].opacity = 96;
			_btn[9].valid = nextValid;
			_btn[9].opacity = nextValid ? 255 : 96;
		}
	}

	function refreshJumpButtons(){
		var jumpAvailable = !_adv.isRecollect();
		var prevValid = jumpAvailable && _adv.canJumpSelectPrev();
		var nextValid = jumpAvailable && !_adv.isSelectTerminate() && !_adv.isSelect();

		_btn[11].valid = prevValid;
		_btn[11].opacity = prevValid ? 255 : 96;
		_btn[9].valid = nextValid;
		_btn[9].opacity = nextValid ? 255 : 96;
	}

	function onButtonDownL(target){
		cancelShortcutOpen();
		closeShortcutMenu();

		var event = "";
		switch(target){
		case _btn[0] : event = "qsave"; break;
		case _btn[1] :
			var save = saveMan.atQSave();
			event = "qload/" + save.file;
			break;
		case _btn[2] : event = "save"; break;
		case _btn[3] : event = "load"; break;
		case _btn[4] :
			// 进入右下角设置页面前，关闭 ADV 页面上的其他所有弹窗。
			if(isvalid(_messageFrame))
				_messageFrame.closeAllPagePopups();
			event = "config";
			break;
		case _btn[5] : event = "auto"; break;
		case _btn[6] : event = "skip"; break;
		case _btn[7] : event = "log"; break;
		case _btn[9] :
			refreshJumpButtons();
			if(!_btn[9].valid) return;
			event = "jumpSelectNext";
			break;
		case _btn[10] : event = "title"; break;
		case _btn[11] :
			refreshJumpButtons();
			if(!_btn[11].valid) return;
			event = "jumpSelectPrev";
			break;
		case _btn[8] :
			lock = (target.state == 0);
			event = "lock";
			break;
		}

		onMenuDecide(event);
	}
	function onButtonDownR(target){}
	function onButtonEnter(target){
		var shortcutMenu = shortcutMenuForButton(target);
		if(shortcutMenu !== null){
			requestShortcutOpen(target, shortcutMenu);
		}else{
			cancelShortcutOpen();
			// 配置按钮有自己的悬浮菜单，切换到它时不保留存读档浮窗。
			if(target == _btn[4]) closeShortcutMenu();
		}

		switch(target){
		case _btn[9] :
		case _btn[11] :
			refreshJumpButtons();
			break;
		}
		super.onButtonEnter(target);

		if(!enable || !isvalid(_messageFrame)) return;
		for(var i=0;i<_btn.count;i++){
			if(target == _btn[i]){
				_messageFrame.showSystemMenuHint(target, _hintTexts[i]);
				break;
			}
		}
	}
	function onButtonLeave(target){
		if(isvalid(_messageFrame)) _messageFrame.hideSystemMenuHint(target);

		if(target == _shortcutPendingButton)
			cancelShortcutOpen();
		if(target == _shortcutOpenButton)
			requestShortcutClose(_shortcutOpenMenu);

		super.onButtonLeave(target);
	}

	function isCursorOverButton(x, y){
		if(!_buttonsEnabled) return false;
		var localX = x - left;
		var localY = y - top;
		for(var i=0;i<_btn.count;i++){
			if(!isvalid(_btn[i]) || !_btn[i].visible || !_btn[i].valid)
				continue;
			if(_btn[i].left <= localX &&
				localX < _btn[i].left + _btn[i].width &&
				_btn[i].top <= localY &&
				localY < _btn[i].top + _btn[i].height)
				return true;
		}
		return false;
	}

	function setAutoHidePointerEnabled(flag){
		if(flag && !_buttonsEnabled) flag = false;
		if(flag){
			HitThresholdSelectItems(_btn, 0);
			hitThreshold = 0;
		}else{
			if(isvalid(_messageFrame)) _messageFrame.hideSystemMenuHint();
			cancelShortcutOpen();
			closeShortcutMenu();
			hideSubMenu();
			HitThresholdSelectItems(_btn, 256);
			hitThreshold = 256;
		}
	}

	function buttonEnable(flag){
		_buttonsEnabled = flag;
		if(flag) refreshJumpButtons();
		setAutoHidePointerEnabled(flag);
		syncAutoIndicator();
	}

	function onMenuEnter(){
		if(isvalid(_messageFrame))
			_messageFrame.onSystemMenuPointerEnter();
		super.onMenuEnter();
	}
	function onMenuLeave(){
		if(isvalid(_messageFrame)) _messageFrame.hideSystemMenuHint();
		parent.onMenuLeave();

		super.onMenuLeave();
	}

	property lock{
		getter(){return _btn[8].state == 0;}
		setter(v){
			_btn[8].state = v?0:1;
			CONFIG.systemMenuLock = v?1:0;
		}
	}

	property auto{
		getter(){return _btn[5].state;}
		setter(v){
			_btn[5].state = v;
			syncAutoIndicator();
		}
	}
	property skip{
		getter(){return _btn[6].state;}
		setter(v){_btn[6].state = v;}
	}

	class MenuArea extends Layer{
		var _owner;
		function MenuArea(win, par, owner){
			Layer(...);
			_owner = owner;
			hasImage = false;
			hitThreshold = 0;
			visible = true;
		}

		function onMouseEnter(){
			_owner.onMenuAreaEnter();
		}
		function onMouseLeave(){
			_owner.onMenuAreaLeave();
		}
	}
}
class QuickSaveMenu extends SubMenu{
	var _btn = [];
	var _panel;
	var _title;

	var MAX = 9;
	var PANEL_WIDTH = 512;
	var PANEL_HEIGHT = 345;
	var HOVER_GAP_HEIGHT = 138;
	var WINDOW_RIGHT_GAP = 18;
	var SLOT_WIDTH = 150;
	var SLOT_HEIGHT = 80;
	var SLOT_GAP_X = 14;
	var SLOT_GAP_Y = 14;
	var SLOT_START_X = 17;
	var SLOT_START_Y = 60;
	var SLOT_RADIUS = 7;
	var THUMB_INSET_X = 4;
	var THUMB_INSET_Y = 4;
	var THUMB_WIDTH = 142;
	var THUMB_HEIGHT = 72;
	var THUMB_RADIUS = 3;

	var PANEL_COLOR = 0xf0397990;
	var PANEL_GRADIENT_COLOR = 0x687ebace;
	var SLOT_COLOR = 0xe0446f76;
	var SLOT_HOVER_INNER_COLOR = 0xf0477d86;
	var SLOT_HOVER_OVERLAY_COLOR = 0x387ac6d0;
	var SLOT_EMPTY_DISABLED_COLOR = 0x90405f65;
	var LABEL_COLOR = 0xb0154751;
	var TITLE_TEXT_COLOR = 0xf4fbfa;

	function QuickSaveMenu(win, par, o=null){
		SubMenu(...);
		_name = "QuickLoadShortcutMenu";

		// 快捷读档浮窗与 SystemMenu 同属 MessageFrame 的直属图层；
		// 显式放到菜单提示之上，避免被消息框和系统按钮遮住。
		absolute = 1004;
		type = ltAlpha;
		hasImage = false;
		setSize(PANEL_WIDTH, PANEL_HEIGHT);

		_panel = new global.Layer(win, this);
		with(_panel){
			.setImageSize(PANEL_WIDTH, PANEL_HEIGHT);
			.setSize(PANEL_WIDTH, PANEL_HEIGHT);
			.type = ltAlpha;
			.absolute = 0;
			.hitThreshold = 256;
			.visible = true;
		}
		_title = new global.Layer(win, this);
		with(_title){
			.setImageSize(PANEL_WIDTH, 54);
			.setSize(PANEL_WIDTH, 54);
			.type = ltAlpha;
			.absolute = 1;
			.hitThreshold = 256;
			.visible = true;
		}
		paintPanel();
		syncBackgroundOpacity();

		createSlots(win);
		refresh();
	}
	function finalize(){
		InvalidateArray(_btn);
		invalidate _panel;
		invalidate _title;
		super.finalize();
	}

	function paintRounded(
		layer, x, y, width, height, color,
		radius=6, corners=15){
		if(radius <= 0){
			layer.fillRect(x, y, width, height, color);
			return;
		}
		if(radius * 2 > width) radius = width \ 2;
		if(radius * 2 > height) radius = height \ 2;

		var baseAlpha = (color >> 24) & 0xff;
		var rgb = color & 0x00ffffff;
		for(var row=0;row<height;row++){
			var boundary = 0;
			var leftRounded = false;
			var rightRounded = false;
			if(row < radius){
				var dy = radius - row - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
				leftRounded = (corners & 0x01) != 0;
				rightRounded = (corners & 0x02) != 0;
			}else if(row >= height - radius){
				var edgeRow = height - 1 - row;
				var dy = radius - edgeRow - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
				leftRounded = (corners & 0x08) != 0;
				rightRounded = (corners & 0x04) != 0;
			}

			var leftInset =
				leftRounded ? int(boundary + 0.999) : 0;
			var rightInset =
				rightRounded ? int(boundary + 0.999) : 0;
			var span = width - leftInset - rightInset;
			if(span > 0)
				layer.fillRect(
					x + leftInset, y + row,
					span, 1,
					color);

			if(leftInset > 0){
				var coverage = leftInset - boundary;
				var edgeAlpha = int(baseAlpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor = (edgeAlpha << 24) | rgb;
					layer.fillRect(
						x + leftInset - 1, y + row,
						1, 1,
						edgeColor);
				}
			}
			if(rightInset > 0){
				var coverage = rightInset - boundary;
				var edgeAlpha = int(baseAlpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor = (edgeAlpha << 24) | rgb;
					layer.fillRect(
						x + width - rightInset, y + row,
						1, 1,
						edgeColor);
				}
			}
		}
	}

	function paintPanelGradient(){
		var radius = 15;
		var denominator = PANEL_HEIGHT - 1;
		var startAlpha = (PANEL_COLOR >> 24) & 0xff;
		var startRed = (PANEL_COLOR >> 16) & 0xff;
		var startGreen = (PANEL_COLOR >> 8) & 0xff;
		var startBlue = PANEL_COLOR & 0xff;
		var endAlpha = (PANEL_GRADIENT_COLOR >> 24) & 0xff;
		var endRed = (PANEL_GRADIENT_COLOR >> 16) & 0xff;
		var endGreen = (PANEL_GRADIENT_COLOR >> 8) & 0xff;
		var endBlue = PANEL_GRADIENT_COLOR & 0xff;

		for(var row=0;row<PANEL_HEIGHT;row++){
			var alpha = startAlpha +
				((endAlpha - startAlpha) * row) \ denominator;
			var red = startRed +
				((endRed - startRed) * row) \ denominator;
			var green = startGreen +
				((endGreen - startGreen) * row) \ denominator;
			var blue = startBlue +
				((endBlue - startBlue) * row) \ denominator;
			var rowColor =
				(alpha << 24) |
				(red << 16) |
				(green << 8) |
				blue;

			var boundary = 0;
			if(row < radius){
				var dy = radius - row - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}else if(row >= PANEL_HEIGHT - radius){
				var edgeRow = PANEL_HEIGHT - 1 - row;
				var dy = radius - edgeRow - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}

			var inset = int(boundary + 0.999);
			var span = PANEL_WIDTH - inset * 2;
			if(span > 0)
				_panel.fillRect(inset, row, span, 1, rowColor);
			if(inset > 0){
				var coverage = inset - boundary;
				var edgeAlpha = int(alpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor =
						(edgeAlpha << 24) |
						(rowColor & 0x00ffffff);
					_panel.fillRect(
						inset - 1, row, 1, 1, edgeColor);
					_panel.fillRect(
						PANEL_WIDTH - inset, row,
						1, 1, edgeColor);
				}
			}
		}
	}

	function paintPanel(){
		_panel.fillRect(
			0, 0, PANEL_WIDTH, PANEL_HEIGHT,
			0x00000000);
		paintPanelGradient();

		_title.fillRect(0, 0, _title.width, _title.height, 0);
		_title.font.face = GetShortcutMenuFontFace();
		_title.font.bold = true;
		_title.font.height = 24;
		var title = "快速读档";
		var textX =
			(PANEL_WIDTH - _title.font.getTextWidth(title)) \ 2;
		_title.drawText(
			textX, 15, title,
			TITLE_TEXT_COLOR,
			255, true, 1024, 0x285b63, 1);
	}
	function syncBackgroundOpacity(){
		var depth = CONFIG.windowDepth;
		if(depth < 0) depth = 0;
		if(depth > 100) depth = 100;
		_panel.opacity = (255 * depth) \ 100;
	}

	function paintSlotFrame(layer, offsetX, hover){
		var innerColor = hover ? SLOT_HOVER_INNER_COLOR : SLOT_COLOR;
		layer.fillRect(offsetX, 0, SLOT_WIDTH, SLOT_HEIGHT, 0);
		paintRounded(
			layer, offsetX, 0,
			SLOT_WIDTH, SLOT_HEIGHT,
			innerColor, SLOT_RADIUS);
		paintRounded(
			layer,
			offsetX + THUMB_INSET_X, THUMB_INSET_Y,
			THUMB_WIDTH, THUMB_HEIGHT,
			innerColor, THUMB_RADIUS);
	}

	function createSlots(win){
		var slotImage = new global.Layer(win, this);
		with(slotImage){
			.setImageSize(SLOT_WIDTH * 2, SLOT_HEIGHT);
			.setSize(SLOT_WIDTH * 2, SLOT_HEIGHT);
			.type = ltAlpha;
			.fillRect(0, 0, .width, .height, 0);
		}
		paintSlotFrame(slotImage, 0, false);
		paintSlotFrame(slotImage, SLOT_WIDTH, true);

		for(var i=0;i<MAX;i++){
			var column = i % 3;
			var row = i \ 3;
			_btn[i] = %[];
			_btn[i].btn = new Button(win, this);
			with(_btn[i].btn){
				.create(slotImage, 2);
				.setPos(
					SLOT_START_X + column * (SLOT_WIDTH + SLOT_GAP_X),
					SLOT_START_Y + row * (SLOT_HEIGHT + SLOT_GAP_Y));
				.absolute = 2;
				.visible = true;
			}

			_btn[i].thumb = new global.Layer(win, _btn[i].btn);
			with(_btn[i].thumb){
				.setImageSize(THUMB_WIDTH, THUMB_HEIGHT);
				.setSize(THUMB_WIDTH, THUMB_HEIGHT);
				.setPos(THUMB_INSET_X, THUMB_INSET_Y);
				.type = ltAlpha;
				.fillRect(0, 0, .width, .height, 0);
				.font.height = 20;
				.hitThreshold = 256;
				.visible = true;
			}

			_btn[i].hover = new global.Layer(win, _btn[i].btn);
			with(_btn[i].hover){
				.setImageSize(SLOT_WIDTH, SLOT_HEIGHT);
				.setSize(SLOT_WIDTH, SLOT_HEIGHT);
				.setPos(0, 0);
				.type = ltAlpha;
				.fillRect(0, 0, .width, .height, 0);
				.hitThreshold = 256;
				.visible = false;
			}
			paintRounded(
				_btn[i].hover, 0, 0,
				SLOT_WIDTH, SLOT_HEIGHT,
				SLOT_HOVER_OVERLAY_COLOR, SLOT_RADIUS);

			_btn[i].label = new global.Layer(win, _btn[i].btn);
			with(_btn[i].label){
				.setImageSize(50, 24);
				.setSize(50, 24);
				.setPos(8, 7);
				.type = ltAlpha;
				.fillRect(0, 0, .width, .height, 0);
				.font.height = 18;
				.hitThreshold = 256;
				.visible = true;
			}
			_btn[i].file = "";
			addItem(_btn[i].btn);
		}

		invalidate slotImage;
	}

	function clipThumbnailCorners(target){
		var mask = new global.Layer(window, this);
		with(mask){
			.setImageSize(target.width, target.height);
			.setSize(target.width, target.height);
			.type = ltAlpha;
			.fillRect(0, 0, .width, .height, 0);
		}
		paintRounded(
			mask, 0, 0,
			target.width, target.height,
			0xffffffff, THUMB_RADIUS);
		var originalFace = target.face;
		target.face = dfMask;
		target.copyRect(
			0, 0, mask,
			0, 0, target.width, target.height);
		target.face = originalFace;
		invalidate mask;
	}

	function show(target=null){
		refresh();
		syncBackgroundOpacity();
		super.show(target);
		// 与存/读档面板使用相同的无命中通行间隔。
		if(target !== null){
			top -= HOVER_GAP_HEIGHT;
			left -= WINDOW_RIGHT_GAP;
			if(left < 0) left = 0;
		}
	}

	function loadThumbnail(target, filename){
		if(filename === void || filename == "") return false;

		var image = new global.Layer(window, this);
		var loaded = false;
		try{
			if(Storages.isExistentStorage(DATA_PATH + filename))
				image.loadImages(DATA_PATH + filename);
			else if(Storages.isExistentStorage(filename))
				image.loadImages(filename);
			else if(Storages.isExistentStorage("savedata/" + filename))
				image.loadImages("savedata/" + filename);
			else
				throw "thumbnail not found";

			image.setSizeToImageSize();

			var sourceX = 0;
			var sourceY = 0;
			var sourceWidth = image.width;
			var sourceHeight = image.height;
			if(image.width * target.height > image.height * target.width){
				sourceWidth = (image.height * target.width) \ target.height;
				sourceX = (image.width - sourceWidth) \ 2;
			}else if(image.width * target.height < image.height * target.width){
				sourceHeight = (image.width * target.height) \ target.width;
				sourceY = (image.height - sourceHeight) \ 2;
			}
			target.stretchCopy(
				0, 0, target.width, target.height,
				image,
				sourceX, sourceY, sourceWidth, sourceHeight,
				stFastLinear);
			clipThumbnailCorners(target);
			loaded = true;
		}catch(e){
			dm("QuickLoadShortcutMenu thumbnail failed: " + filename + ": " + e);
		}
		invalidate image;
		return loaded;
	}

	function refresh(){
		var stack = saveMan.qsaveStack();
		for(var i=0;i<MAX;i++){
			var save = i < stack ? saveMan.atQSave(i) : void;
			var valid = save !== void && save.valid;

			with(_btn[i].thumb){
				.fillRect(0, 0, .width, .height, 0);
			}
			if(!valid)
				paintRounded(
					_btn[i].thumb, 0, 0,
					_btn[i].thumb.width, _btn[i].thumb.height,
					SLOT_EMPTY_DISABLED_COLOR,
					THUMB_RADIUS);
			with(_btn[i].label){
				.fillRect(0, 0, .width, .height, 0);
			}
			paintRounded(
				_btn[i].label, 0, 0,
				_btn[i].label.width, _btn[i].label.height,
				LABEL_COLOR, 12);
			with(_btn[i].label){
				var text = "Q%d".sprintf(i + 1);
				var textX = (.width - .font.getTextWidth(text)) \ 2;
				.drawText(
					textX, 3, text,
					valid ? 0xf2fafa : 0x9db8bb,
					255, true, 1024, 0x255b48, 1);
			}

			_btn[i].file = valid ? save.file : "";
			if(valid) loadThumbnail(_btn[i].thumb, save.file);
			_btn[i].hover.visible = false;
			_btn[i].btn.valid = valid;
			_btn[i].btn.opacity = valid ? 255 : 120;
		}
	}

	function onButtonEnter(target){
		for(var i=0;i<_btn.count;i++){
			if(_btn[i].btn == target){
				_btn[i].hover.visible =
					target.valid && _btn[i].file != "";
				break;
			}
		}
		super.onButtonEnter(target);
	}
	function onButtonLeave(target){
		for(var i=0;i<_btn.count;i++){
			if(_btn[i].btn == target){
				_btn[i].hover.visible = false;
				break;
			}
		}
		super.onButtonLeave(target);
	}

	function onButtonDownL(target){
		for(var i=0;i<_btn.count;i++){
			if(_btn[i].btn == target){
				if(_btn[i].file == "") return;
				onMenuDecide("qload/" + _btn[i].file);
				break;
			}
		}
	}

	function onMenuEnter(){
		if(isvalid(owner) &&
			typeof owner.onShortcutMenuEnter != "undefined")
			owner.onShortcutMenuEnter(this);
		super.onMenuEnter();
	}
	function onMenuLeave(){
		if(isvalid(owner) &&
			typeof owner.onShortcutMenuLeave != "undefined")
			owner.onShortcutMenuLeave(this);
		super.onMenuLeave();
	}
}

// 存档/读档按钮共用的悬浮快捷面板。面板位置仍由 JOIN_TOP 对齐，
// 打开意图与跨越间隔时的关闭缓冲由 SystemMenu 统一控制。
class LoadShortcutMenu extends SubMenu{
	var _btn = [];
	var _nav = [];
	var _pageLabel;
	var _panel;
	var _saveMode = false;

	var _page = -1;
	var PANEL_SCALE = 150;
	var NAV_SCALE = 135;
	var PAGE_SIZE = 12;
	var PANEL_WIDTH = 360;
	var PANEL_HEIGHT = 221;
	// 存读档按钮位于菜单第二排（y=60）。向上留出 138px，
	// 使放大后的面板底边与文本设置弹窗底边对齐。
	var HOVER_GAP_HEIGHT = 138;
	var WINDOW_RIGHT_GAP = 12;
	var SLOT_WIDTH = 80;
	var SLOT_HEIGHT = 48;
	var SLOT_GAP_X = 6;
	var SLOT_GAP_Y = 5;
	var SLOT_START_X = 11;
	var SLOT_START_Y = 56;
	var SLOT_RADIUS = 5;
	var THUMB_INSET_X = 3;
	var THUMB_INSET_Y = 3;
	var THUMB_WIDTH = 74;
	var THUMB_HEIGHT = 42;
	var THUMB_RADIUS = 2;

	var PANEL_COLOR = 0xf0397990;
	var PANEL_GRADIENT_COLOR = 0x687ebace;
	var ACCENT_COLOR = 0xfff2fafa;
	var SLOT_COLOR = 0xe0446f76;
	var SLOT_HOVER_INNER_COLOR = 0xf0477d86;
	var SLOT_HOVER_OVERLAY_COLOR = 0x387ac6d0;
	var SLOT_EMPTY_DISABLED_COLOR = 0x90405f65;
	var LABEL_COLOR = 0xb0154751;
	var LABEL_DISABLED_TEXT_COLOR = 0x8ca9ac;
	var LABEL_TEXT_SHADOW_COLOR = 0x234f59;
	var LABEL_TEXT_SHADOW_WIDTH = 1;
	var EMPTY_TEXT_COLOR = 0xc3d2d4;
	var EMPTY_TEXT_SHADOW_COLOR = 0xd9e5e5;
	var PAGE_BACKGROUND_COLOR = 0xefcbdce3;
	var PAGE_TEXT_COLOR = 0x315e67;
	var PAGE_TEXT_SHADOW_COLOR = 0xf4fbfb;
	var NAV_BACKGROUND_COLOR = 0x01000000;
	var NAV_HOVER_BACKGROUND_COLOR = 0x604a8590;
	var NAV_TEXT_COLOR = 0xdce9eb;
	var NAV_HOVER_TEXT_COLOR = 0xf2fafa;
	var NAV_TEXT_SHADOW_COLOR = 0x285b63;

	function scaled(v){
		return (v * PANEL_SCALE) \ 100;
	}
	function navScaled(v){
		return (v * NAV_SCALE) \ 100;
	}

	function LoadShortcutMenu(win, par, o=null, saveMode=false){
		SubMenu(...);
		_saveMode = saveMode;
		_name = _saveMode ? "SaveShortcutMenu" : "LoadShortcutMenu";
		if(_saveMode){
			ACCENT_COLOR = 0xffffff;
			SLOT_COLOR = 0xe06e466f;
			SLOT_HOVER_INNER_COLOR = 0xf0a085a1;
			SLOT_HOVER_OVERLAY_COLOR = 0x407b577c;
			SLOT_EMPTY_DISABLED_COLOR = 0xe0d6cbd6;
			LABEL_COLOR = 0xd06e466f;
			LABEL_DISABLED_TEXT_COLOR = 0xbda8bd;
			LABEL_TEXT_SHADOW_COLOR = 0x6e466f;
			LABEL_TEXT_SHADOW_WIDTH = 0;
			EMPTY_TEXT_COLOR = 0x6e466f;
			EMPTY_TEXT_SHADOW_COLOR = 0xe9dfe9;
			PAGE_BACKGROUND_COLOR = 0xe8d1e1e7;
			PAGE_TEXT_COLOR = 0x60838c;
			PAGE_TEXT_SHADOW_COLOR = 0xf9f3f9;
			NAV_BACKGROUND_COLOR = 0x808f6b90;
			NAV_HOVER_BACKGROUND_COLOR = 0xb06e466f;
			NAV_TEXT_COLOR = 0xf0e7f0;
			NAV_HOVER_TEXT_COLOR = 0xffffff;
			NAV_TEXT_SHADOW_COLOR = 0x4f3151;
		}

		PANEL_WIDTH = scaled(PANEL_WIDTH);
		PANEL_HEIGHT = scaled(PANEL_HEIGHT);
		WINDOW_RIGHT_GAP = scaled(WINDOW_RIGHT_GAP);
		SLOT_WIDTH = scaled(SLOT_WIDTH);
		SLOT_HEIGHT = scaled(SLOT_HEIGHT);
		SLOT_GAP_X = scaled(SLOT_GAP_X);
		SLOT_GAP_Y = scaled(SLOT_GAP_Y);
		SLOT_START_X = scaled(SLOT_START_X);
		SLOT_START_Y = scaled(SLOT_START_Y);
		SLOT_RADIUS = scaled(SLOT_RADIUS);
		THUMB_INSET_X = scaled(THUMB_INSET_X);
		THUMB_INSET_Y = scaled(THUMB_INSET_Y);
		THUMB_WIDTH = scaled(THUMB_WIDTH);
		THUMB_HEIGHT = scaled(THUMB_HEIGHT);
		THUMB_RADIUS = scaled(THUMB_RADIUS);

		absolute = 1004;
		type = ltAlpha;
		hasImage = false;
		setSize(PANEL_WIDTH, PANEL_HEIGHT);

		_panel = new global.Layer(win, this);
		with(_panel){
			.setImageSize(PANEL_WIDTH, PANEL_HEIGHT);
			.setSize(PANEL_WIDTH, PANEL_HEIGHT);
			.type = ltAlpha;
			.fillRect(0, 0, PANEL_WIDTH, PANEL_HEIGHT, 0);
			.setPos(0, 0);
			.absolute = 0;
			.hitThreshold = 256;
			.visible = true;
		}
		paintPanel();

		createNavigation(win);
		createSlots(win);
		syncBackgroundOpacity();
		refresh();
	}
	function finalize(){
		InvalidateArray(_btn);
		InvalidateArray(_nav);
		invalidate _pageLabel;
		invalidate _panel;
		super.finalize();
	}

	function paintRounded(
		layer, x, y, width, height, color,
		radius=6, corners=15){
		if(radius <= 0){
			layer.fillRect(x, y, width, height, color);
			return;
		}
		if(radius * 2 > width) radius = width \ 2;
		if(radius * 2 > height) radius = height \ 2;

		var baseAlpha = (color >> 24) & 0xff;
		var rgb = color & 0x00ffffff;
		for(var row=0;row<height;row++){
			var boundary = 0;
			var leftRounded = false;
			var rightRounded = false;
			if(row < radius){
				var dy = radius - row - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
				leftRounded = (corners & 0x01) != 0;
				rightRounded = (corners & 0x02) != 0;
			}else if(row >= height - radius){
				var edgeRow = height - 1 - row;
				var dy = radius - edgeRow - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
				leftRounded = (corners & 0x08) != 0;
				rightRounded = (corners & 0x04) != 0;
			}

			var leftInset =
				leftRounded ? int(boundary + 0.999) : 0;
			var rightInset =
				rightRounded ? int(boundary + 0.999) : 0;
			var span = width - leftInset - rightInset;
			if(span > 0)
				layer.fillRect(
					x + leftInset, y + row,
					span, 1,
					color);

			if(leftInset > 0){
				var coverage = leftInset - boundary;
				var edgeAlpha = int(baseAlpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor = (edgeAlpha << 24) | rgb;
					layer.fillRect(
						x + leftInset - 1, y + row,
						1, 1,
						edgeColor);
				}
			}
			if(rightInset > 0){
				var coverage = rightInset - boundary;
				var edgeAlpha = int(baseAlpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor = (edgeAlpha << 24) | rgb;
					layer.fillRect(
						x + width - rightInset, y + row,
						1, 1,
						edgeColor);
				}
			}
		}
	}

	function paintPanelGradient(){
		// 与 150% 的文本设置浮窗一致：10px 基准圆角缩放为 15px。
		var radius = scaled(10);
		var denominator = PANEL_HEIGHT - 1;
		var startAlpha = (PANEL_COLOR >> 24) & 0xff;
		var startRed = (PANEL_COLOR >> 16) & 0xff;
		var startGreen = (PANEL_COLOR >> 8) & 0xff;
		var startBlue = PANEL_COLOR & 0xff;
		var endAlpha = (PANEL_GRADIENT_COLOR >> 24) & 0xff;
		var endRed = (PANEL_GRADIENT_COLOR >> 16) & 0xff;
		var endGreen = (PANEL_GRADIENT_COLOR >> 8) & 0xff;
		var endBlue = PANEL_GRADIENT_COLOR & 0xff;

		for(var row=0;row<PANEL_HEIGHT;row++){
			var alpha = startAlpha +
				((endAlpha - startAlpha) * row) \ denominator;
			var red = startRed +
				((endRed - startRed) * row) \ denominator;
			var green = startGreen +
				((endGreen - startGreen) * row) \ denominator;
			var blue = startBlue +
				((endBlue - startBlue) * row) \ denominator;
			var rowColor =
				(alpha << 24) |
				(red << 16) |
				(green << 8) |
				blue;

			var boundary = 0;
			if(row < radius){
				var dy = radius - row - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}else if(row >= PANEL_HEIGHT - radius){
				var edgeRow = PANEL_HEIGHT - 1 - row;
				var dy = radius - edgeRow - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}

			var inset = int(boundary + 0.999);
			var span = PANEL_WIDTH - inset * 2;
			if(span > 0)
				_panel.fillRect(
				inset, row,
				span, 1,
				rowColor);
			if(inset > 0){
				var coverage = inset - boundary;
				var edgeAlpha = int(alpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor =
						(edgeAlpha << 24) |
						(rowColor & 0x00ffffff);
					_panel.fillRect(
						inset - 1, row,
						1, 1,
						edgeColor);
					_panel.fillRect(
						PANEL_WIDTH - inset, row,
						1, 1,
						edgeColor);
				}
			}
		}
	}

	function paintPanel(){
		_panel.fillRect(
			0, 0, PANEL_WIDTH, PANEL_HEIGHT,
			0x00000000);
		paintPanelGradient();
	}

	function paintSlotFrame(layer, offsetX, hover){
		var outerColor = hover ? SLOT_HOVER_INNER_COLOR : SLOT_COLOR;
		layer.fillRect(offsetX, 0, SLOT_WIDTH, SLOT_HEIGHT, 0);
		paintRounded(
			layer, offsetX, 0,
			SLOT_WIDTH, SLOT_HEIGHT,
			outerColor, SLOT_RADIUS);
		paintRounded(
			layer,
			offsetX + THUMB_INSET_X, THUMB_INSET_Y,
			THUMB_WIDTH, THUMB_HEIGHT,
			outerColor, THUMB_RADIUS);
	}

	function createScaledTwoStateButton(win, storage, x, y){
		var source = new global.Layer(win, this);
		with(source){
			.loadImages(storage);
			.setSizeToImageSize();
			.visible = false;
		}
		var sourceStateWidth = source.width \ 2;
		var targetStateWidth = navScaled(sourceStateWidth);
		var targetHeight = navScaled(source.height);
		var buttonImage = new global.Layer(win, this);
		with(buttonImage){
			.setImageSize(targetStateWidth * 2, targetHeight);
			.setSize(targetStateWidth * 2, targetHeight);
			.type = ltAlpha;
			.fillRect(0, 0, .width, .height, 0);
			.stretchCopy(
				0, 0, targetStateWidth, targetHeight,
				source,
				0, 0, sourceStateWidth, source.height,
				stFastLinear);
			.stretchCopy(
				targetStateWidth, 0,
				targetStateWidth, targetHeight,
				source,
				sourceStateWidth, 0,
				sourceStateWidth, source.height,
				stFastLinear);
		}

		var button = new Button(win, this);
		with(button){
			.create(buttonImage, 2);
			.setPos(x, y);
			.absolute = 2;
			.visible = true;
		}
		invalidate source;
		invalidate buttonImage;
		return button;
	}

	function createNavigation(win){
		var navFiles = [
			"ui_1920/adv_menu/DHK-49.png",
			"ui_1920/adv_menu/DHK-50.png",
			"ui_1920/adv_menu/DHK-51.png",
			"ui_1920/adv_menu/DHK-52.png",
			"ui_1920/adv_menu/DHK-53.png",
			"ui_1920/adv_menu/DHK-54.png"
		];
		var navX = [22, 50, 83, 258, 281, 313];
		var navY = [19, 20, 19, 19, 20, 19];
		for(var i=0;i<navFiles.count;i++){
			_nav[i] = createScaledTwoStateButton(
				win, navFiles[i],
				scaled(navX[i]),
				scaled(navY[i]));
			addItem(_nav[i]);
		}

		_pageLabel = new global.Layer(win, this);
		with(_pageLabel){
			.setImageSize(scaled(94), scaled(32));
			.setSize(scaled(94), scaled(32));
			.setPos(
				scaled(133),
				scaled(13));
			.type = ltAlpha;
			.absolute = 1;
			.fillRect(0, 0, .width, .height, 0);
			.font.face = GetShortcutMenuFontFace();
			.font.bold = true;
			.font.height = scaled(16);
			.hitThreshold = 256;
			.visible = true;
		}
		invalidate navFiles;
		invalidate navX;
		invalidate navY;
	}

	function createSlots(win){
		var slotImage = new global.Layer(win, this);
		with(slotImage){
			.setImageSize(SLOT_WIDTH * 2, SLOT_HEIGHT);
			.setSize(SLOT_WIDTH * 2, SLOT_HEIGHT);
			.type = ltAlpha;
			.fillRect(0, 0, .width, .height, 0);
		}
		paintSlotFrame(slotImage, 0, false);
		paintSlotFrame(slotImage, SLOT_WIDTH, true);

		for(var i=0;i<PAGE_SIZE;i++){
			var column = i % 4;
			var row = i \ 4;
			_btn[i] = %[];
			_btn[i].btn = new Button(win, this);
			with(_btn[i].btn){
				.create(slotImage, 2);
				.setPos(
					SLOT_START_X + column * (SLOT_WIDTH + SLOT_GAP_X),
					SLOT_START_Y + row * (SLOT_HEIGHT + SLOT_GAP_Y));
				.absolute = 2;
				.visible = true;
			}

			_btn[i].thumb = new global.Layer(win, _btn[i].btn);
			with(_btn[i].thumb){
				.setImageSize(THUMB_WIDTH, THUMB_HEIGHT);
				.setSize(THUMB_WIDTH, THUMB_HEIGHT);
				.setPos(THUMB_INSET_X, THUMB_INSET_Y);
				.type = ltAlpha;
				.fillRect(0, 0, .width, .height, 0);
				.font.face = GetShortcutMenuFontFace();
				.font.height = scaled(13);
				.hitThreshold = 256;
				.visible = true;
			}

			_btn[i].hover = new global.Layer(win, _btn[i].btn);
			with(_btn[i].hover){
				.setImageSize(SLOT_WIDTH, SLOT_HEIGHT);
				.setSize(SLOT_WIDTH, SLOT_HEIGHT);
				.setPos(0, 0);
				.type = ltAlpha;
				.fillRect(0, 0, .width, .height, 0);
				.hitThreshold = 256;
				.visible = false;
			}
			paintRounded(
				_btn[i].hover, 0, 0,
				SLOT_WIDTH, SLOT_HEIGHT,
				SLOT_HOVER_OVERLAY_COLOR, SLOT_RADIUS);

			_btn[i].label = new global.Layer(win, _btn[i].btn);
			with(_btn[i].label){
				.setImageSize(scaled(46), scaled(13));
				.setSize(scaled(46), scaled(13));
				.setPos(scaled(17), scaled(1));
				.type = ltAlpha;
				.fillRect(0, 0, .width, .height, 0);
				.font.face = GetShortcutMenuFontFace();
				.font.bold = true;
				.font.height = scaled(9);
				.hitThreshold = 256;
				.visible = true;
			}
			_btn[i].file = "";
			addItem(_btn[i].btn);
		}

		invalidate slotImage;
	}

	function clipThumbnailCorners(target){
		var mask = new global.Layer(window, this);
		with(mask){
			.setImageSize(target.width, target.height);
			.setSize(target.width, target.height);
			.type = ltAlpha;
			.fillRect(0, 0, .width, .height, 0);
		}
		paintRounded(
			mask, 0, 0,
			target.width, target.height,
			0xffffffff, THUMB_RADIUS);
		var originalFace = target.face;
		target.face = dfMask;
		target.copyRect(
			0, 0, mask,
			0, 0, target.width, target.height);
		target.face = originalFace;
		invalidate mask;
	}

	function pageCount(){
		var count = SAVEDATA_BOOK_MAX * SAVEDATA_PAGE_MAX * SAVEDATA_PAGE_NUM;
		return (count + PAGE_SIZE - 1) \ PAGE_SIZE;
	}

	function refresh(){
		if(_page < 0){
			if(_saveMode){
				var nextSave = GetNewSaveNo();
				if(nextSave <= 0) nextSave = saveMan.newestIndex() + 1;
				_page = nextSave > 0 ? (nextSave - 1) \ PAGE_SIZE : 0;
			}else{
				var newest = saveMan.newestIndex();
				_page = newest >= 0 ? newest \ PAGE_SIZE : 0;
			}
		}
		setPage(_page);
	}

	function show(target=null){
		refresh();
		syncBackgroundOpacity();
		super.show(target);
		// 用实际位置偏移留出通行区，通行区不属于浮窗图层。
		if(target !== null){
			top -= HOVER_GAP_HEIGHT;
			left -= WINDOW_RIGHT_GAP;
			if(left < 0) left = 0;
		}
	}
	function syncBackgroundOpacity(){
		var depth = CONFIG.windowDepth;
		if(depth < 0) depth = 0;
		if(depth > 100) depth = 100;
		_panel.opacity = (255 * depth) \ 100;
	}

	function onMenuEnter(){
		if(isvalid(owner) &&
			typeof owner.onShortcutMenuEnter != "undefined")
			owner.onShortcutMenuEnter(this);
		super.onMenuEnter();
	}
	function onMenuLeave(){
		if(isvalid(owner) &&
			typeof owner.onShortcutMenuLeave != "undefined")
			owner.onShortcutMenuLeave(this);
		super.onMenuLeave();
	}

	function setPage(page){
		var count = pageCount();
		if(page < 0) page = 0;
		if(page >= count) page = count - 1;
		_page = page;

		refreshPageLabel();
		refreshNavigation();
		refreshSlots();
	}

	function refreshPageLabel(){
		_pageLabel.fillRect(0, 0, _pageLabel.width, _pageLabel.height, 0);
		paintRounded(
			_pageLabel, 0, 0,
			_pageLabel.width, _pageLabel.height,
			PAGE_BACKGROUND_COLOR, scaled(10));
		var text = "%04d".sprintf(_page + 1);
		var x = (_pageLabel.width - _pageLabel.font.getTextWidth(text)) \ 2;
		_pageLabel.drawText(
			x, scaled(8), text,
			PAGE_TEXT_COLOR,
			255, true, 1024, PAGE_TEXT_SHADOW_COLOR, 1);
	}

	function refreshNavigation(){
		var canBack = _page > 0;
		var canForward = _page < pageCount() - 1;
		for(var i=0;i<3;i++){
			_nav[i].valid = canBack;
			_nav[i].opacity = canBack ? 255 : 96;
		}
		for(var i=3;i<6;i++){
			_nav[i].valid = canForward;
			_nav[i].opacity = canForward ? 255 : 96;
		}
	}

	function loadThumbnail(target, filename){
		if(filename === void || filename == "") return false;

		var image = new global.Layer(window, this);
		var loaded = false;
		try{
			if(Storages.isExistentStorage(DATA_PATH + filename))
				image.loadImages(DATA_PATH + filename);
			else if(Storages.isExistentStorage(filename))
				image.loadImages(filename);
			else if(Storages.isExistentStorage("savedata/" + filename))
				image.loadImages("savedata/" + filename);
			else
				throw "thumbnail not found";

			image.setSizeToImageSize();

			// 按目标槽位比例从源缩略图中央裁切，再缩放填满。
			// 这样不会把 16:9 存档截图横向压扁成槽位比例。
			var sourceX = 0;
			var sourceY = 0;
			var sourceWidth = image.width;
			var sourceHeight = image.height;
			if(image.width * target.height > image.height * target.width){
				sourceWidth = (image.height * target.width) \ target.height;
				sourceX = (image.width - sourceWidth) \ 2;
			}else if(image.width * target.height < image.height * target.width){
				sourceHeight = (image.width * target.height) \ target.width;
				sourceY = (image.height - sourceHeight) \ 2;
			}
			target.stretchCopy(
				0, 0, target.width, target.height,
				image,
				sourceX, sourceY, sourceWidth, sourceHeight,
				stFastLinear);
			clipThumbnailCorners(target);
			loaded = true;
		}catch(e){
			dm(
				(_saveMode ? "SaveShortcutMenu" : "LoadShortcutMenu") +
				" thumbnail failed: " + filename + ": " + e);
		}
		invalidate image;
		return loaded;
	}

	function refreshSlots(){
		for(var i=0;i<PAGE_SIZE;i++){
			var dataIndex = _page * PAGE_SIZE + i;
			var info = saveMan.at(dataIndex);
			var valid = info !== void && info.valid;
			var locked = valid && info.lock !== void && info.lock;
			var actionable = _saveMode ? !locked : valid;

			with(_btn[i].thumb){
				.fillRect(0, 0, .width, .height, 0);
			}
			if(!valid)
				paintRounded(
					_btn[i].thumb, 0, 0,
					_btn[i].thumb.width, _btn[i].thumb.height,
					SLOT_EMPTY_DISABLED_COLOR, THUMB_RADIUS);
			with(_btn[i].label){
				.fillRect(0, 0, .width, .height, 0);
			}
			paintRounded(
				_btn[i].label, 0, 0,
				_btn[i].label.width, _btn[i].label.height,
				LABEL_COLOR, scaled(6));
			with(_btn[i].label){
				var label = "%03d".sprintf(dataIndex + 1);
				var labelX = (.width - .font.getTextWidth(label)) \ 2;
				.drawText(
					labelX, scaled(3), label,
					actionable ?
						ACCENT_COLOR : LABEL_DISABLED_TEXT_COLOR,
					255, true, 1024,
					LABEL_TEXT_SHADOW_COLOR,
					LABEL_TEXT_SHADOW_WIDTH);
			}

			_btn[i].dataIndex = dataIndex;
			_btn[i].file = valid ? info.file : "";
			if(valid) loadThumbnail(_btn[i].thumb, info.file);

			if(!valid){
				with(_btn[i].thumb){
					var emptyText = _saveMode ? "空" : "—";
					var emptyX = (.width - .font.getTextWidth(emptyText)) \ 2;
					.drawText(
						emptyX, scaled(12), emptyText,
						EMPTY_TEXT_COLOR,
						255, true, 1024, EMPTY_TEXT_SHADOW_COLOR, 1);
				}
			}else if(locked){
				paintRounded(
					_btn[i].thumb, 0, 0,
					_btn[i].thumb.width, _btn[i].thumb.height,
					0x80311d28, scaled(8));
				with(_btn[i].thumb){
					var lockText = "锁";
					var lockX = (.width - .font.getTextWidth(lockText)) \ 2;
					.drawText(
						lockX, scaled(11), lockText,
						0xf1c3d5, 255, true, 1024, 0x4b2638, 1);
				}
			}

			_btn[i].hover.visible = false;
			_btn[i].btn.valid = actionable;
			_btn[i].btn.opacity = actionable ? 255 : 120;
		}
	}

	function onButtonEnter(target){
		for(var i=0;i<_btn.count;i++){
			if(_btn[i].btn == target){
				_btn[i].hover.visible =
					target.valid && _btn[i].file != "";
				break;
			}
		}
		super.onButtonEnter(target);
	}
	function onButtonLeave(target){
		for(var i=0;i<_btn.count;i++){
			if(_btn[i].btn == target){
				_btn[i].hover.visible = false;
				break;
			}
		}
		super.onButtonLeave(target);
	}

	function onButtonDownL(target){
		switch(target){
		case _nav[0] : setPage(0); return;
		case _nav[1] : setPage(_page - 10); return;
		case _nav[2] : setPage(_page - 1); return;
		case _nav[3] : setPage(_page + 1); return;
		case _nav[4] : setPage(_page + 10); return;
		case _nav[5] : setPage(pageCount() - 1); return;
		}

		for(var i=0;i<_btn.count;i++){
			if(target == _btn[i].btn){
				if(_saveMode){
					hide();
					onMenuDecide("slotsave/" + _btn[i].dataIndex);
					return;
				}
				if(_btn[i].file == "") return;
				hide();
				onMenuDecide("slotload/" + _btn[i].file);
				return;
			}
		}
	}
	function onButtonDownR(target){}
}

// 文本设置滑块：轨道、圆点和交互全部由代码绘制。
class TextSettingsSlider extends SelectItemBase{
	var _visual;
	var _range = 100;
	var _trim = 0;
	var _trackWidth = 0;
	var _trackX = 0;
	var _knobSize = 0;
	var _maxKnobSize = 0;
	var _dragging = false;
	var _hover = false;

	function TextSettingsSlider(win, par){
		super.SelectItemBase(win, par);
		hasImage = false;
		hitThreshold = 0;
	}
	function kind(){return "SliderH";}
	function create(trackWidth, hitHeight, knobSize, range=100){
		_trackWidth = trackWidth;
		_knobSize = knobSize;
		_maxKnobSize = knobSize + 4;
		_trackX = _maxKnobSize \ 2;
		_range = range;

		// 右侧多留 2px，避免最大值 hover 时圆点阴影被画布裁切。
		setSize(_trackWidth + _maxKnobSize + 2, hitHeight);
		_width = width;
		_height = height;
		var visualWidth = width;
		var visualHeight = height;

		_visual = new global.Layer(window, this);
		with(_visual){
			.setImageSize(visualWidth, visualHeight);
			.setSize(visualWidth, visualHeight);
			.type = ltAlpha;
			.hitThreshold = 256;
			.visible = true;
		}
		redraw();
		visible = true;
	}
	function finalize(){
		invalidate _visual;
		super.finalize();
	}
	function clampTrim(value){
		if(value < 0) return 0;
		if(value > _range) return _range;
		return int(value);
	}
	function trimFromX(x){
		if(_trackWidth <= 0) return 0;
		return clampTrim(
			((x - _trackX) * _range + (_trackWidth \ 2)) \
				_trackWidth);
	}
	function knobCenterX(){
		if(_range <= 0) return _trackX;
		return _trackX + (_trackWidth * _trim) \ _range;
	}
	function redraw(){
		if(!isvalid(_visual)) return;
		_visual.fillRect(
			0, 0, _visual.imageWidth, _visual.imageHeight,
			0x00000000);

		var centerY = height \ 2;
		PaintMenuRoundedRect(
			_visual,
			_trackX + 1, centerY - 3,
			_trackWidth, 9,
			0x50204f5d, 5);
		PaintMenuRoundedRect(
			_visual,
			_trackX, centerY - 4,
			_trackWidth, 9,
			0xfff4fbfc, 5);
		PaintMenuRoundedRect(
			_visual,
			_trackX + 1, centerY - 3,
			_trackWidth - 2, 7,
			0xff5799ab, 4);

		var knobSize = _hover ? _maxKnobSize : _knobSize;
		var knobX = knobCenterX() - (knobSize \ 2);
		var knobY = centerY - (knobSize \ 2);
		PaintMenuRoundedRect(
			_visual,
			knobX + 2, knobY + 2,
			knobSize, knobSize,
			0x70204f5d, knobSize \ 2);
		PaintMenuRoundedRect(
			_visual,
			knobX, knobY,
			knobSize, knobSize,
			0xffffffff, knobSize \ 2);
		PaintMenuRoundedRect(
			_visual,
			knobX + 3, knobY + 3,
			knobSize - 6, knobSize - 6,
			_hover ? 0xff84cbd9 : 0xff5ba3b5,
			(knobSize - 6) \ 2);
	}
	function onMouseDown(x, y, button, shift){
		if(!valid) return;
		if(button == mbLeft){
			_dragging = true;
			trim = trimFromX(x);
			parent.onSliderMoveStart(this);
			parent.onSliderMove(this);
		}else if(button == mbRight &&
			typeof parent.onButtonDownR != "undefined"){
			parent.onButtonDownR(this);
		}
	}
	function onMouseUp(x, y, button, shift){
		if(button != mbLeft) return;
		var wasDragging = _dragging;
		_dragging = false;
		if(valid && wasDragging) parent.onSliderMoveEnd(this);
	}
	function onMouseMove(x, y, shift){
		if(!valid || !_dragging) return;
		trim = trimFromX(x);
		parent.onSliderMove(this);
	}
	function onMouseEnter(){
		if(!valid) return;
		super.onMouseEnter();
		_hover = true;
		redraw();
		parent.onSliderEnter(this);
		cursor = crSizeWE;
	}
	function onMouseLeave(){
		if(!valid) return;
		super.onMouseLeave();
		_hover = false;
		redraw();
		parent.onSliderLeave(this);
		cursor = crDefault;
	}
	function onValid(){redraw();}
	function onInvalid(){redraw();}
	property trim{
		setter(v){_trim = clampTrim(v); redraw();}
		getter(){return _trim;}
	}
	property range{
		setter(v){_range = v; trim = _trim;}
		getter(){return _range;}
	}
}

// 文本设置单选项：圆形状态与 Xiaolai 标签均由代码绘制。
class TextSettingsRadioButton extends SelectItemBase{
	var _group;
	var _visual;
	var _label = "";
	var _circleSize = 0;
	var _fontSize = 0;
	var _hover = false;

	function TextSettingsRadioButton(win, par){
		super.SelectItemBase(win, par);
		hasImage = false;
		hitThreshold = 0;
	}
	function kind(){return "RadioButton";}
	function create(label, buttonWidth, buttonHeight, circleSize, fontSize){
		_label = label;
		_circleSize = circleSize;
		_fontSize = fontSize;
		setSize(buttonWidth, buttonHeight);

		_visual = new global.Layer(window, this);
		with(_visual){
			.setImageSize(buttonWidth, buttonHeight);
			.setSize(buttonWidth, buttonHeight);
			.type = ltAlpha;
			.hitThreshold = 256;
			.visible = true;
			.font.face = GetShortcutMenuFontFace();
			.font.height = _fontSize;
			.font.bold = true;
		}
		redraw();
		visible = true;
	}
	function finalize(){
		invalidate _visual;
		super.finalize();
	}
	function redraw(){
		if(!isvalid(_visual)) return;
		_visual.fillRect(
			0, 0, _visual.imageWidth, _visual.imageHeight,
			0x00000000);

		// Xiaolai 的可见字形略靠上，圆圈同步上移以对齐字面中心。
		var circleY = (height - _circleSize) \ 2 - 2;
		PaintMenuRoundedRect(
			_visual,
			2, circleY + 2,
			_circleSize, _circleSize,
			0x70204f5d, _circleSize \ 2);
		PaintMenuRoundedRect(
			_visual,
			0, circleY,
			_circleSize, _circleSize,
			0xffffffff, _circleSize \ 2);
		var innerSize = _circleSize - 6;
		var selected = isOn();
		var innerColor = selected ? 0xff58a7ba :
			(_hover ? 0xffb9dce3 : 0xffaebbc0);
		PaintMenuRoundedRect(
			_visual,
			3, circleY + 3,
			innerSize, innerSize,
			innerColor, innerSize \ 2);

		_visual.drawText(
			_circleSize + 9,
			(height - _fontSize) \ 2 - 1,
			_label,
			0xfffafa,
			255, true, 1024, 0x285b63, 2);
	}
	function isOn(){return valid == false;}
	function onMouseDown(x, y, button, shift){
		releaseCapture();
		if(button == mbLeft && valid){
			if(group !== void) group.on(this);
			parent.onButtonDownL(this);
		}else if(button == mbRight){
			parent.onButtonDownR(this);
		}
	}
	function onMouseEnter(){
		super.onMouseEnter();
		if(!valid) return;
		_hover = true;
		redraw();
	}
	function onMouseLeave(){
		super.onMouseLeave();
		if(!valid) return;
		_hover = false;
		redraw();
	}
	function onValid(){_hover = false; redraw();}
	function onInvalid(){_hover = false; redraw();}
	property group{
		setter(v){_group = v;}
		getter(){return _group;}
	}
}

// 文本设置的菜单
class TextSettingsMenu extends SubMenu{
	var _adv;
	var _btn = %[];
	var _skipGroup;
	var _panel;
	var _labels;
	var PANEL_SCALE = 150;
	var BASE_PANEL_WIDTH = 431;
	var BASE_PANEL_HEIGHT = 142;
	var SHOW_ANIMATION_TIME = 150;
	var SHOW_ANIMATION_OFFSET_Y = 12;
	var _restX = 0;
	var _restY = 0;
	var _canAnimateHide = false;
	var _hiding = false;

	function scaled(v){
		return (v * PANEL_SCALE) \ 100;
	}
	function paintGradientRoundedRect(
		layer, x, y, paintWidth, paintHeight, radius){
		// 取自 DHK-11.png 的主体像素：颜色逐渐变亮，
		// Alpha 从顶部约 230 线性降至底部约 52。
		var topR = 57, topG = 121, topB = 144;
		var bottomR = 126, bottomG = 186, bottomB = 206;
		var topAlpha = 230, bottomAlpha = 52;
		for(var row=0;row<paintHeight;row++){
			var ratio = paintHeight <= 1 ?
				0 : (row * 1000) \ (paintHeight - 1);
			var red = topR + ((bottomR - topR) * ratio) \ 1000;
			var green = topG + ((bottomG - topG) * ratio) \ 1000;
			var blue = topB + ((bottomB - topB) * ratio) \ 1000;
			var alpha =
				topAlpha +
				((bottomAlpha - topAlpha) * ratio) \ 1000;
			// 参考图首尾像素行保留了纵向抗锯齿覆盖率。
			if(row == 0) alpha = (alpha * 3) \ 4;
			else if(row == paintHeight - 1) alpha \= 2;
			var color =
				(alpha << 24) |
				(red << 16) |
				(green << 8) |
				blue;

			var boundary = 0;
			if(row < radius){
				var dy = radius - row - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}else if(row >= paintHeight - radius){
				var edgeRow = paintHeight - 1 - row;
				var dy = radius - edgeRow - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}
			var inset = int(boundary + 0.999);
			var span = paintWidth - inset * 2;
			if(span > 0)
				layer.fillRect(x + inset, y + row, span, 1, color);
			if(inset > 0){
				var coverage = inset - boundary;
				var edgeAlpha = int(alpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor =
						(edgeAlpha << 24) |
						(red << 16) |
						(green << 8) |
						blue;
					layer.fillRect(
						x + inset - 1, y + row,
						1, 1, edgeColor);
					layer.fillRect(
						x + paintWidth - inset, y + row,
						1, 1, edgeColor);
				}
			}
		}
	}
	function drawPanel(){
		_panel.fillRect(
			0, 0, _panel.imageWidth, _panel.imageHeight,
			0x00000000);
		paintGradientRoundedRect(
			_panel, 0, 0, width, height,
			scaled(10));
	}
	function drawLabels(){
		_labels.fillRect(
			0, 0, _labels.imageWidth, _labels.imageHeight,
			0x00000000);
		var titleY = [
			scaled(11), scaled(44), scaled(77), scaled(110)
		];
		var titles = [
			"文本显示速度",
			"自动模式速度",
			"对话框透明度",
			"快进文本内容"
		];
		with(_labels.font){
			.face = GetShortcutMenuFontFace();
			.height = scaled(17);
			.bold = true;
		}
		for(var i=0;i<titles.count;i++){
			_labels.drawText(
				scaled(16), titleY[i],
				titles[i],
				0xfffafa,
				255, true, 1024, 0x285b63, 2);
		}

		with(_labels.font){
			.height = scaled(11);
			.bold = true;
		}
		var minMaxY = [
			scaled(14), scaled(48), scaled(82)
		];
		for(var i=0;i<3;i++){
			_labels.drawText(
				scaled(134), minMaxY[i],
				"MIN",
				0xfffafa,
				255, true, 1024, 0x285b63, 1);
			_labels.drawText(
				scaled(379), minMaxY[i],
				"MAX",
				0xfffafa,
				255, true, 1024, 0x285b63, 1);
		}
	}

	function TextSettingsMenu(win, par, o=null, adv=null){
		SubMenu(...);
		_name = "TextSettingsMenu";
		_adv = adv;
		join = JOIN_TOP;

		hasImage = false;
		setSize(scaled(BASE_PANEL_WIDTH), scaled(BASE_PANEL_HEIGHT));
		absolute = 250;
		var panelWidth = width;
		var panelHeight = height;

		_panel = new global.Layer(window, this);
		with(_panel){
			.setImageSize(panelWidth, panelHeight);
			.setSize(panelWidth, panelHeight);
			.type = ltAlpha;
			.absolute = 0;
			.hitThreshold = 256;
			.visible = true;
		}
		_labels = new global.Layer(window, this);
		with(_labels){
			.setImageSize(panelWidth, panelHeight);
			.setSize(panelWidth, panelHeight);
			.type = ltAlpha;
			.absolute = 1;
			.hitThreshold = 256;
			.visible = true;
		}
		drawPanel();
		drawLabels();

		// 两端为圆点额外留白，避免最小/最大值时压住 MIN/MAX。
		var trackWidth = scaled(199);
		var hitHeight = scaled(24);
		var knobSize = scaled(14);
		var sliderX = scaled(168) - ((knobSize + 4) \ 2);
		var sliderCenterY = [
			scaled(21), scaled(55), scaled(89)
		];

		_btn.MessageSpeed = new TextSettingsSlider(window, this);
		with(_btn.MessageSpeed){
			.create(trackWidth, hitHeight, knobSize, 100);
			.setPos(sliderX, sliderCenterY[0] - (hitHeight \ 2));
			.absolute = 2;
		}
		_btn.AutoMessageSpeed = new TextSettingsSlider(window, this);
		with(_btn.AutoMessageSpeed){
			.create(trackWidth, hitHeight, knobSize, 100);
			.setPos(sliderX, sliderCenterY[1] - (hitHeight \ 2));
			.absolute = 2;
		}
		_btn.WindowDepth = new TextSettingsSlider(window, this);
		with(_btn.WindowDepth){
			.create(trackWidth, hitHeight, knobSize, 100);
			.setPos(sliderX, sliderCenterY[2] - (hitHeight \ 2));
			.absolute = 2;
		}

		_skipGroup = new RadioButtonGroup();
		_btn.SkipRead = new TextSettingsRadioButton(window, this);
		with(_btn.SkipRead){
			.create(
				"快进已读内容",
				scaled(135), scaled(24),
				scaled(14), scaled(13));
			.setPos(scaled(137), scaled(110));
			.absolute = 2;
		}
		_skipGroup.add(_btn.SkipRead);
		_btn.SkipAll = new TextSettingsRadioButton(window, this);
		with(_btn.SkipAll){
			.create(
				"快进全部内容",
				scaled(135), scaled(24),
				scaled(14), scaled(13));
			.setPos(scaled(283), scaled(110));
			.absolute = 2;
		}
		_skipGroup.add(_btn.SkipAll);

		addItem(_btn.MessageSpeed);
		addItem(_btn.AutoMessageSpeed);
		addItem(_btn.WindowDepth);
		addItem(_btn.SkipRead);
		addItem(_btn.SkipAll);

		if(CONFIG.readSkip)	_skipGroup.on(_btn.SkipRead);
		else				_skipGroup.on(_btn.SkipAll);
		updateSkipVisual();
		syncBackgroundOpacity();

		hide();
	}
	function show(target=null){
		// 清掉旧动画回调，避免快速重复操作时触发上一次的隐藏结束逻辑。
		if(isActivation()){
			setTransitionCompleteCall();
			stopActivation();
		}
		_hiding = false;
		opacity = 0;
		super.show(target);
		if(target === null){
			opacity = 255;
			_canAnimateHide = true;
			return;
		}

		// 默认 JOIN_TOP 会以图标中心对齐；文字设置面板改为左边缘对齐。
		var alignedX = target.left;
		if(alignedX + width > parent.width)
			alignedX = parent.width - width;
		if(alignedX < 0) alignedX = 0;
		var finalY = top;
		setPos(alignedX, finalY);
		_restX = alignedX;
		_restY = finalY;
		_canAnimateHide = true;

		// 从下方向上短距离滑入，并由全透明恢复到正常整体不透明度。
		setTransitionCompleteCall();
		setMovingEnvelope(
			alignedX, finalY + SHOW_ANIMATION_OFFSET_Y,
			alignedX, finalY, 2);
		setBlendingEnvelope(255);
		beginActivation(SHOW_ANIMATION_TIME);
	}
	function hide(){
		if(!visible || !_canAnimateHide){
			if(isActivation()){
				setTransitionCompleteCall();
				stopActivation();
			}
			_hiding = false;
			_canAnimateHide = false;
			opacity = 255;
			super.hide();
			return;
		}
		if(_hiding) return;

		// 入场尚未结束时从当前状态平滑反向，不先跳到终点。
		if(isActivation()){
			setTransitionCompleteCall();
			stopActivation();
		}
		_hiding = true;
		setTransitionCompleteCall(onHideAnimationEnd);
		setMovingEnvelope(
			left, top,
			_restX, _restY + SHOW_ANIMATION_OFFSET_Y, 2);
		setBlendingEnvelope(0);
		beginActivation(SHOW_ANIMATION_TIME);
	}
	function onHideAnimationEnd(){
		setTransitionCompleteCall();
		_hiding = false;
		_canAnimateHide = false;
		super.hide();
		opacity = 255;
		setPos(_restX, _restY);
	}
	function finalize(){
		invalidate _skipGroup;
		invalidate _panel;
		invalidate _labels;
		super.finalize();
	}

	function onButtonDownL(target){
		applyToSystem();
		updateSkipVisual();
	}
	function onButtonDownR(target){}
	function onSliderEnter(target){}
	function onSliderLeave(target){}
	function onSliderMove(target){applyToSystem();}
	function onSliderMoveStart(target){}
	function onSliderMoveEnd(target){applyToSystem();}

	function loadFromConfig(){
		_btn.MessageSpeed.trim =
			_btn.MessageSpeed.range - CONFIG.messageSpeed;
		_btn.AutoMessageSpeed.trim =
			(_btn.AutoMessageSpeed.range * 100 -
				CONFIG.autoSpeed) \ 100;
		_btn.WindowDepth.trim = CONFIG.windowDepth;
		if(CONFIG.readSkip)	_skipGroup.on(_btn.SkipRead);
		else				_skipGroup.on(_btn.SkipAll);
		updateSkipVisual();
		syncBackgroundOpacity();
	}

	function applyToSystem(){
		CONFIG.messageSpeed =
			_btn.MessageSpeed.range - _btn.MessageSpeed.trim;
		CONFIG.autoSpeed =
			(_btn.AutoMessageSpeed.range -
				_btn.AutoMessageSpeed.trim) * 100;
		CONFIG.windowDepth = _btn.WindowDepth.trim;
		CONFIG.readSkip = _btn.SkipRead.isOn() ? 1 : 0;
		syncBackgroundOpacity();

		if(_adv){
			_adv._msg._maMess.outputSpeed = CONFIG.messageSpeed;
			_adv._msg.windowDepth(
				(255 * CONFIG.windowDepth) \ 100);
			if(_adv.isAuto() && _adv._autoTimer.enabled)
				_adv._autoTimer.interval =
					CONFIG.autoSpeed + 1;
		}
	}

	function syncBackgroundOpacity(){
		if(!isvalid(_panel)) return;
		var depth = CONFIG.windowDepth;
		if(depth < 0) depth = 0;
		if(depth > 100) depth = 100;
		_panel.opacity = (255 * depth) \ 100;
	}

	function updateSkipVisual(){
		_btn.SkipRead.redraw();
		_btn.SkipAll.redraw();
	}
}

// 对话框音量设置：参考 DHK-12，使用与文本设置相同的代码绘制风格。
class VolumeSettingsMenu extends SubMenu{
	var _adv;
	var _btn = %[];
	var _panel;
	var _labels;
	var PANEL_SCALE = 150;
	var BASE_PANEL_WIDTH = 431;
	var BASE_PANEL_HEIGHT = 177;
	var SHOW_ANIMATION_TIME = 150;
	var SHOW_ANIMATION_OFFSET_Y = 12;
	var _restX = 0;
	var _restY = 0;
	var _canAnimateHide = false;
	var _hiding = false;

	function scaled(v){
		return (v * PANEL_SCALE) \ 100;
	}
	function paintGradientRoundedRect(
		layer, x, y, paintWidth, paintHeight, radius){
		// 与文本设置弹窗共用 DHK-11 测得的渐变和透明度。
		var topR = 57, topG = 121, topB = 144;
		var bottomR = 126, bottomG = 186, bottomB = 206;
		var topAlpha = 230, bottomAlpha = 52;
		for(var row=0;row<paintHeight;row++){
			var ratio = paintHeight <= 1 ?
				0 : (row * 1000) \ (paintHeight - 1);
			var red = topR + ((bottomR - topR) * ratio) \ 1000;
			var green = topG + ((bottomG - topG) * ratio) \ 1000;
			var blue = topB + ((bottomB - topB) * ratio) \ 1000;
			var alpha =
				topAlpha +
				((bottomAlpha - topAlpha) * ratio) \ 1000;
			if(row == 0) alpha = (alpha * 3) \ 4;
			else if(row == paintHeight - 1) alpha \= 2;
			var color =
				(alpha << 24) |
				(red << 16) |
				(green << 8) |
				blue;

			var boundary = 0;
			if(row < radius){
				var dy = radius - row - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}else if(row >= paintHeight - radius){
				var edgeRow = paintHeight - 1 - row;
				var dy = radius - edgeRow - 0.5;
				boundary =
					radius - Math.sqrt(radius * radius - dy * dy);
			}
			var inset = int(boundary + 0.999);
			var span = paintWidth - inset * 2;
			if(span > 0)
				layer.fillRect(x + inset, y + row, span, 1, color);
			if(inset > 0){
				var coverage = inset - boundary;
				var edgeAlpha = int(alpha * coverage);
				if(edgeAlpha > 0){
					var edgeColor =
						(edgeAlpha << 24) |
						(red << 16) |
						(green << 8) |
						blue;
					layer.fillRect(
						x + inset - 1, y + row,
						1, 1, edgeColor);
					layer.fillRect(
						x + paintWidth - inset, y + row,
						1, 1, edgeColor);
				}
			}
		}
	}
	function drawPanel(){
		_panel.fillRect(
			0, 0, _panel.imageWidth, _panel.imageHeight,
			0x00000000);
		paintGradientRoundedRect(
			_panel, 0, 0, width, height,
			scaled(10));
	}
	function drawLabels(){
		_labels.fillRect(
			0, 0, _labels.imageWidth, _labels.imageHeight,
			0x00000000);
		var titleY = [
			scaled(11), scaled(44), scaled(77),
			scaled(110), scaled(143)
		];
		var titles = [
			"主音量", "背景乐", "语音", "音效", "环境音"
		];
		with(_labels.font){
			.face = GetShortcutMenuFontFace();
			.height = scaled(17);
			.bold = true;
		}
		for(var i=0;i<titles.count;i++){
			_labels.drawText(
				scaled(16), titleY[i],
				titles[i],
				0xfffafa,
				255, true, 1024, 0x285b63, 2);
		}

		with(_labels.font){
			.height = scaled(11);
			.bold = true;
		}
		var minMaxY = [
			scaled(14), scaled(47), scaled(80),
			scaled(113), scaled(146)
		];
		for(var i=0;i<5;i++){
			_labels.drawText(
				scaled(100), minMaxY[i],
				"MIN",
				0xfffafa,
				255, true, 1024, 0x285b63, 1);
			_labels.drawText(
				scaled(385), minMaxY[i],
				"MAX",
				0xfffafa,
				255, true, 1024, 0x285b63, 1);
		}
	}

	function createSlider(name, centerY){
		var trackWidth = scaled(240);
		var hitHeight = scaled(24);
		var knobSize = scaled(14);
		var sliderX =
			scaled(130) - ((knobSize + 4) \ 2);
		_btn[name] = new TextSettingsSlider(window, this);
		with(_btn[name]){
			.create(trackWidth, hitHeight, knobSize, 100);
			.setPos(
				sliderX,
				scaled(centerY) - (hitHeight \ 2));
			.absolute = 2;
		}
		addItem(_btn[name]);
	}

	function VolumeSettingsMenu(win, par, o=null, adv=null){
		SubMenu(...);
		_name = "VolumeSettingsMenu";
		_adv = adv;
		join = JOIN_TOP;

		hasImage = false;
		setSize(scaled(BASE_PANEL_WIDTH), scaled(BASE_PANEL_HEIGHT));
		absolute = 250;
		var panelWidth = width;
		var panelHeight = height;

		_panel = new global.Layer(window, this);
		with(_panel){
			.setImageSize(panelWidth, panelHeight);
			.setSize(panelWidth, panelHeight);
			.type = ltAlpha;
			.absolute = 0;
			.hitThreshold = 256;
			.visible = true;
		}
		_labels = new global.Layer(window, this);
		with(_labels){
			.setImageSize(panelWidth, panelHeight);
			.setSize(panelWidth, panelHeight);
			.type = ltAlpha;
			.absolute = 1;
			.hitThreshold = 256;
			.visible = true;
		}
		drawPanel();
		drawLabels();

		createSlider("Master", 21);
		createSlider("Bgm", 54);
		createSlider("Voice", 87);
		createSlider("Se", 120);
		createSlider("EnvSe", 153);

		loadFromConfig();
		hide();
	}
	function show(target=null){
		if(isActivation()){
			setTransitionCompleteCall();
			stopActivation();
		}
		_hiding = false;
		opacity = 0;
		super.show(target);
		if(target === null){
			opacity = 255;
			_canAnimateHide = true;
			return;
		}

		// 与文本设置弹窗一致：左边缘对齐按钮并向上淡入。
		var alignedX = target.left;
		if(alignedX + width > parent.width)
			alignedX = parent.width - width;
		if(alignedX < 0) alignedX = 0;
		var finalY = top;
		setPos(alignedX, finalY);
		_restX = alignedX;
		_restY = finalY;
		_canAnimateHide = true;

		setTransitionCompleteCall();
		setMovingEnvelope(
			alignedX, finalY + SHOW_ANIMATION_OFFSET_Y,
			alignedX, finalY, 2);
		setBlendingEnvelope(255);
		beginActivation(SHOW_ANIMATION_TIME);
	}
	function hide(){
		if(!visible || !_canAnimateHide){
			if(isActivation()){
				setTransitionCompleteCall();
				stopActivation();
			}
			_hiding = false;
			_canAnimateHide = false;
			opacity = 255;
			super.hide();
			return;
		}
		if(_hiding) return;

		if(isActivation()){
			setTransitionCompleteCall();
			stopActivation();
		}
		_hiding = true;
		setTransitionCompleteCall(onHideAnimationEnd);
		setMovingEnvelope(
			left, top,
			_restX, _restY + SHOW_ANIMATION_OFFSET_Y, 2);
		setBlendingEnvelope(0);
		beginActivation(SHOW_ANIMATION_TIME);
	}
	function onHideAnimationEnd(){
		setTransitionCompleteCall();
		_hiding = false;
		_canAnimateHide = false;
		super.hide();
		opacity = 255;
		setPos(_restX, _restY);
	}
	function finalize(){
		invalidate _panel;
		invalidate _labels;
		super.finalize();
	}

	function onButtonDownL(target){}
	function onButtonDownR(target){}
	function onSliderEnter(target){}
	function onSliderLeave(target){}
	function onSliderMove(target){applyToSystem();}
	function onSliderMoveStart(target){}
	function onSliderMoveEnd(target){
		applyToSystem();
		SaveSystemRegister();
	}

	function loadFromConfig(){
		_btn.Master.trim = int(100 * CONFIG.volMaster);
		_btn.Bgm.trim = int(100 * CONFIG.volBgm);
		_btn.Voice.trim = int(100 * CONFIG.volVoice);
		_btn.Se.trim = int(100 * CONFIG.volSe);
		_btn.EnvSe.trim = int(100 * CONFIG.volEnvSe);
		syncBackgroundOpacity();
	}
	function applyMasterVolume(manager){
		if(manager === null) return;
		var list = manager.idList(false);
		for(var i=0;i<list.count;i++){
			var obj = manager.objectOfId(list[i].id);
			if(obj != -1)
				obj.volume2 = 100000 * CONFIG.volMaster;
		}
	}
	function applyToSystem(){
		CONFIG.volMaster = _btn.Master.trim / 100.0;
		CONFIG.volBgm = _btn.Bgm.trim / 100.0;
		CONFIG.volVoice = _btn.Voice.trim / 100.0;
		CONFIG.volSe = _btn.Se.trim / 100.0;
		CONFIG.volEnvSe = _btn.EnvSe.trim / 100.0;

		if(BGM !== null) BGM.volume = CONFIG.volBgm;
		if(VOICE !== null) VOICE.volume = CONFIG.volVoice;
		if(SE !== null) SE.volume = CONFIG.volSe;
		if(ENVSE !== null) ENVSE.volume = CONFIG.volEnvSe;

		applyMasterVolume(BGM);
		applyMasterVolume(SE);
		applyMasterVolume(ENVSE);
		applyMasterVolume(VOICE);
		applyMasterVolume(BGV);
	}
	function syncBackgroundOpacity(){
		if(!isvalid(_panel)) return;
		var depth = CONFIG.windowDepth;
		if(depth < 0) depth = 0;
		if(depth > 100) depth = 100;
		_panel.opacity = (255 * depth) \ 100;
	}
}

class ConfigSubMenu extends SubMenu{
	var _adv;
	var _btn = %[];

	var _numberImage;
	var _number;
	var NUM_DIGIT = 3;			// 音量数字显示位数

	function ConfigSubMenu(win, par, o=null, adv=null){
		SubMenu(...);
		_adv = adv;

		// loadImages("FRM_0181");
		// setSizeToImageSize();

		var sliderW = 202;

		_btn.PlayMaster = new ToggleButton(window, this);
		with(_btn.PlayMaster){
			.create("FRM_0182", 4);
			.setPos(130, 18);
		}
		_btn.PlayBgm = new ToggleButton(window, this);
		with(_btn.PlayBgm){
			.create("FRM_0182", 4);
			.setPos(130, 44);
		}
		_btn.VolBgm = new SliderH(window, this);
		with(_btn.VolBgm){
			.create("FRM_0183", sliderW, 13, 1, 100);
			.setPos(200, 51);
		}
		_btn.PlayVoice = new ToggleButton(window, this);
		with(_btn.PlayVoice){
			.create("FRM_0182", 4);
			.setPos(130, 72);
		}
		_btn.VolVoice = new SliderH(window, this);
		with(_btn.VolVoice){
			.create("FRM_0183", sliderW, 13, 1, 100);
			.setPos(200, 78);
		}
		_btn.PlaySe = new ToggleButton(window, this);
		with(_btn.PlaySe){
			.create("FRM_0182", 4);
			.setPos(130, 99);
		}
		_btn.VolSe = new SliderH(window, this);
		with(_btn.VolSe){
			.create("FRM_0183", sliderW, 13, 1, 100);
			.setPos(200, 105);
		}
		_btn.PlayEnvSe = new ToggleButton(window, this);
		with(_btn.PlayEnvSe){
			.create("FRM_0182", 4);
			.setPos(130, 126);
		}
		_btn.VolEnvSe = new SliderH(window, this);
		with(_btn.VolEnvSe){
			.create("FRM_0183", sliderW, 13, 1, 100);
			.setPos(200, 132);
		}
		_btn.WindowDepth = new SliderH(window, this);
		with(_btn.WindowDepth){
			.create("FRM_0183", sliderW, 13, 1, 100);
			.setPos(200, 159);
		}

		addItem(_btn.PlayBgm);
		addItem(_btn.VolBgm);
		addItem(_btn.PlayVoice);
		addItem(_btn.VolVoice);
		addItem(_btn.PlaySe);
		addItem(_btn.VolSe);
		addItem(_btn.PlayEnvSe);
		addItem(_btn.VolEnvSe);
		addItem(_btn.WindowDepth);

		_numberImage = new global.Layer(win, this);
		with(_numberImage){
			.loadImages("FRM_02A42");
			.setSizeToImageSize();
		}
		_number = new global.Sprite(win, par);
		with(_number){
			.setSize((_numberImage.width\10)*NUM_DIGIT, _numberImage.height);
			.hitThreshold = 256;
		}
	}
	function finalize(){
		invalidate _number;
		invalidate _numberImage;

		super.finalize();
	}

	function onMouseDown(x, y, button, shift){
		super.onMouseDown(...);
	}

	function onButtonDownL(target){
		applyToSystem();
	}
	function onButtonDownR(target){}

	function onSliderEnter(target){
		showDrawNumber(target);
	}
	function onSliderLeave(target){
		hideNumber();
	}
	function onSliderMove(target){
		applyToSystem();
		showDrawNumber(target);
	}
	function onSliderMoveStart(target){
		showDrawNumber(target);
	}
	function onSliderMoveEnd(target){
		applyToSystem();
	}

	function applyToSystem(){
		CONFIG.muteMaster = _btn.PlayMaster.state?0:1;

		CONFIG.muteBgm = _btn.PlayBgm.state?0:1;
			CONFIG.muteBgm|CONFIG.muteMaster?BGM.configStop():BGM.configPlay();
		CONFIG.muteVoice = _btn.PlayVoice.state?0:1;

		CONFIG.volBgm = _btn.VolBgm.trim / 100.0;
			BGM.volume = CONFIG.volBgm;
		CONFIG.volSe = _btn.VolSe.trim / 100.0;
			SE.volume = CONFIG.volSe;
		CONFIG.volEnvSe = _btn.VolEnvSe.trim / 100.0;
			ENVSE.volume = CONFIG.volEnvSe;
		CONFIG.volVoice = _btn.VolVoice.trim / 100.0;
		CONFIG.muteSe = _btn.PlaySe.state?0:1;
			CONFIG.muteSe|CONFIG.muteMaster?SE.configStop():SE.configPlay();
		CONFIG.muteEnvSe = _btn.PlayEnvSe.state?0:1;
			CONFIG.muteEnvSe|CONFIG.muteMaster?ENVSE.configStop():ENVSE.configPlay();
		CONFIG.windowDepth = _btn.WindowDepth.trim;

		if(_adv){
			if(CONFIG.muteVoice|CONFIG.muteMaster) VOICE.stop();
			VOICE.volume = CONFIG.volVoice;

			var ref = CONFIG.voiceDetails;
			var list = BGV.idList(false);
			for(var i=0;i<list.count;i++){
				var id = list[i].id;
				var obj = BGV.objectOfId(id);
				var index = obj.file.indexOf("_ECH");
				var fPlayEcho = index != -1;
				if(CONFIG.echoVoice == 0 && fPlayEcho){
				//浴缸回声OFF
				//如果当前正在播放浴缸回声ON，则进行切换
					var pos = obj.position;
					_adv.playBgv(%[file:obj.file.substring(0, index), fade:0]);
					obj = BGV.objectOfId(id);
					if(obj.isPlay()) obj.position = pos;
				}else if(CONFIG.echoVoice != 0 && !fPlayEcho){
				//浴缸回声ON
				//如果当前正在播放浴缸回声OFF，则进行切换
					var pos = obj.position;
					if(Storages.isExistentStorage(obj.file+"_ECH.ogg")){
						_adv.playBgv(%[file:obj.file+"_ECH", fade:0]);
						obj = BGV.objectOfId(id);
						if(obj.isPlay()) obj.position = pos;
					}
				}
				obj.configVolume = ref[NAME_TO_INDEX[id]].volumeBgv;

				if(!(CONFIG.muteBgv|CONFIG.muteMaster)){
					if(ref[NAME_TO_INDEX[id]].muteBgv || CONFIG.muteMaster){
						if(obj.looping){
							obj._configStop = true;
							obj.stop(true);
						}else{
							BGV.stop(obj.id);
						}
					}else{
						if(obj._configStop){
							obj._configStop = false;
							obj.play();
						}
					}
				}else{
					if(obj.looping){
						obj._configStop = true;
						obj.stop(true);
					}
				}
			}
			BGV.applyVolume();

			_adv._msg.windowDepth((255 * CONFIG.windowDepth) \ 100);
		}
	}

	function show(target){
		refresh();
		super.show(target);
	}

	function refresh(){
	//为减小小数误差，计算时先乘以一个足够大的整数（加偏移量）
		var value;
		with(_btn.PlayMaster){
			.state = CONFIG.muteMaster?0:1;
		}
		with(_btn.PlayBgm){
			.state = CONFIG.muteBgm?0:1;
		}
		with(_btn.VolBgm){
			value = (10000 * CONFIG.volBgm) \ 100;
			if(.trim != value) .trim = value;
		}
		with(_btn.PlayVoice){
			.state = CONFIG.muteVoice?0:1;
		}
		with(_btn.VolVoice){
			value = (10000 * CONFIG.volVoice) \ 100;
			if(.trim != value) .trim = value;
		}
		with(_btn.PlaySe){
			.state = CONFIG.muteSe?0:1;
		}
		with(_btn.VolSe){
			value = (10000 * CONFIG.volSe) \ 100;
			if(.trim != value) .trim = value;
		}
		with(_btn.PlayEnvSe){
			.state = CONFIG.muteEnvSe?0:1;
		}
		with(_btn.VolEnvSe){
			value = (10000 * CONFIG.volEnvSe) \ 100;
			if(.trim != value) .trim = value;
		}
		with(_btn.WindowDepth){
			.trim = CONFIG.windowDepth;
		}
	}

	function showDrawNumber(item, revX=0, revY=0){
		var num = item.trim;
		var w = _numberImage.width \ 10;
		var h = _numberImage.height;

		var count = 0;
		_number.fillRect(0, 0, _number.width, _number.height, 0x0);
		if(num){
			var i = 0;
			while(num){
				var cal = num % 10;

				_number.copyRect(_number.width-(i+1)*w, 0, _numberImage, cal*w, 0, w, h);

				count++;
				num \= 10;
				i++;
			}
		}else{
			_number.copyRect(_number.width-w, 0, _numberImage, 0, 0, w, h);
			count++;
		}

		var pos = new Point();
		GetAbsolutePos(item._trim, pos, window.baseLayer);
		var x = pos.x + item._trim.width\2;
		x -= (NUM_DIGIT-count)*w + (count*w)\2;
		var y = pos.y - _number.height;

		_number.setPos(x, y);

		if(!_number.visible){
			with(_number){
				.opacity = 0;
				.setBlendingEnvelope(255);
				.setMovingEnvelope(.left, .top-8, .left, .top, 2);
				.beginActivation(100);
				.visible = true;
			}
		}
	}
	function hideNumber(){
		if(isvalid _number) _number.visible = false;
	}
}
